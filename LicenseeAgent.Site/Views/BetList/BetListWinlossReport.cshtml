@{
    ViewBag.Title = Las.AgentWinLoss + " - " + Las.Report;
}
@model LicenseeAgent.BetList.ViewModels.BetListWinlossViewModel

@section css
{
    @Styles.Render("~/css/monthpicker")
    @Styles.Render("~/css/angulargrid")
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/bootstrap")
}
@section scripts
{
    @Scripts.Render("~/js/angular")
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/monthpicker")
    @Scripts.Render("~/js/betlistwinlost")
}
<div class="legend">
    @ViewBag.Title
</div>
@using (Html.BeginForm("BetListSelByMember", "BetList", FormMethod.Post,
    new { @class = "hide", id = "search-form" }))
{
    @Html.HiddenFor(m => m.CustId)
    @Html.HiddenFor(m => m.FromDate)
    @Html.HiddenFor(m => m.ToDate)
    <input type="hidden" value="@(Model.DrawFilter == "1" ? "112,113" : "111,112,113")" id="StatusIDs" name="StatusIDs" />
}
@Html.HiddenFor(m => m.DrawFilter)   
@Html.HiddenFor(m => m.BreadCrumb)   
 
@RazorHelper.BreadCrumb(Model.BreadCrumb)
<div class="gridWrapper">
    <div id="BetListGrid" class="freegrid content-grid" data-url-ip="@Url.Action("GetIpInformation", "CustomerList")">
    </div>
</div>
<div id="instruction" class="instruction-content">
</div>