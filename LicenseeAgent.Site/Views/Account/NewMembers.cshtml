@{
    Layout = null;
}
@using LicenseeAgent.Core.Utility
@model IEnumerable<LicenseeAgent.Account.Entities.NewMemberOfMonthEntity>
<table style="width:400px;">
    <tr  class="header">
        <td>@Las.Username</td>
        <td>@Las.GivenCredit</td>
        <td>@Las.CreatedDate</td>
    </tr>
    @if (Model != null && Model.Count() > 0)
    {
        foreach (var member in Model)
        {
    <tr>
        <td>@member.Username</td>
        <td class="text-right">@Formatter.FormatDecimal(member.Credit)</td>
        <td class="text-center">@Formatter.FormatDateTime(member.CreatedDate)</td>
    </tr>
        }
    }
    else
    {
    <tr>
        <td colspan="3" class="text-center">@Las.NoInfo</td>        
    </tr>
    }    
</table>
