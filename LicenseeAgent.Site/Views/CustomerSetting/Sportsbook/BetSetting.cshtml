@using LicenseeAgent.Core.Enumerations
@using LicenseeAgent.CustomerSetting.Entities.Sportsbook;
@model SettingContext
@{
    Layout = null;
}
@helper RenderInstruction(string text, string id, bool simpleMode)
    {
        if (simpleMode)
        {
    <div class="instruction" ng-show="settingMode">
        @text
        <span class="icon-instruction-exclamation" title="@Las.ClickToViewInstructions" id="@id"></span>
    </div>
        }
        else
        {
    <div class="instruction" ng-hide="settingMode">
        @text
        <span class="icon-instruction-exclamation" title="@Las.ClickToViewInstructions" id="@id"></span>
    </div>
        }
}
<div class="container-box">
    @if (Model.TargetRoleId == (int)Role.AgentLevel1)
    {
        @RenderInstruction(Las.BetSetting, "licensee-bet-limit-info-button", true)
        @RenderInstruction(Las.BetSetting, "licensee-bet-limit-info-button-adv", false)
    }
    else if (Model.TargetRoleId == (int)Role.Agent)
    {
        @RenderInstruction(Las.BetSetting, "agent-bet-limit-info-button", true)
        @RenderInstruction(Las.BetSetting, "agent-bet-limit-info-button-adv", false)
    }
    else
    {
        @RenderInstruction(Las.BetSetting, "member-bet-limit-info-button", true)
        @RenderInstruction(Las.BetSetting, "member-bet-limit-info-button-adv", false)
    }
    <div id="betting-limit-current-scope" class="betting-limit" ng-controller="fanex.customersetting.betlimitcontroller">
        <div ng-show="settingContext.IsSimpleMode" class="simple-mode">
            <div>
                <div class="betting-limit-header min-bet">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MinBet']}}</span></div>
                </div>
                <div class="betting-limit-header">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MaxBet']}}</span></div>
                </div>
                <div class="betting-limit-header">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MaxPerMatch']}}</span></div>
                </div>
            </div>
            @if (Model.FormId != FormType.ViewIndirectAgent)
            {
                <betting-limit-simple-mode model-data="model.firstRecord"></betting-limit-simple-mode>
            }
            else
            {
                <betting-limit-simple-mode-read-only model-data="model.firstRecord"></betting-limit-simple-mode-read-only>
            }
        </div>
        <div ng-show="!settingContext.IsSimpleMode">
            <div>
                <div class="betting-limit-sport-header">
                    <div class="betting-limit-header-text">
                    </div>
                </div>
                <div class="betting-limit-header">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MinBet']}}</span></div>
                </div>
                <div class="betting-limit-header">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MaxBet']}}</span></div>
                </div>
                <div class="betting-limit-header">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MaxPerMatch']}}</span></div>
                </div>
            </div>
            <div ng-repeat="betSetting in model.bettingLimitsModel">
                @if (Model.FormId != FormType.ViewIndirectAgent)
                {
                    <betting-limit-advanced-mode betting-limits-model="model.bettingLimitsModel" bet-setting="betSetting"
                        current-index="$index"></betting-limit-advanced-mode>
                }
                else
                {
                    <betting-limit-advanced-mode-read-only betting-limits-model="model.bettingLimitsModel"
                        bet-setting="betSetting" current-index="$index"></betting-limit-advanced-mode-read-only>
                }
                <div class="clearfix">
                </div>
            </div>
        </div>
    </div>
</div>