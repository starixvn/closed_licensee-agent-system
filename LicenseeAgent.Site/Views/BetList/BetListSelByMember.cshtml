@{
    ViewBag.Title = "LAS's Bet List";
}
@section css
{
    @Styles.Render("~/css/angulargrid")
    @Styles.Render("~/css/monthpicker")
}
@section scripts
{
    @Scripts.Render("~/js/angular")
    @Scripts.Render("~/js/angulargrid")
    @Scripts.Render("~/js/monthpicker")
    <script type="text/javascript" src="@Url.Content("~/Views/BetList/Resources/BetListManager.js")"></script>
    <script type="text/javascript">
        var _today = '@DateTime.Today.ToShortDateString()';
        var _minDate = '@DateTime.Now.AddMonths(-2).ToShortDateString()';
        var lastDay = '@DateTime.DaysInMonth(DateTime.Now.AddMonths(-1).Year, DateTime.Now.AddMonths(-1).Month)';
        var lastMonth = '@DateTime.Now.AddMonths(-1).Month';
        var lastYear = '@DateTime.Now.AddMonths(-1).Year';
    </script>
}

<div class="legend">Bet List</div>
<div data-ng-app="betlist" data-ng-controller="BetListController">
    <div id="filter-area" class="clearfix filter-area">
        <div class="month pull-left">Month</div><div class="pull-left" id="month-picker-control"></div>
        <div class="pull-left">Status 
            <select id="status"
                    ng-model="selectedStatus"
                    ng-change="changeStatus(selectedStatus)"
                    ng-options="i.status for i in statusOptions">
            </select>
        </div>
        <input type="button" title="Submit" id="btnSubmit" value="Submit" ng-click="SubmitForm()" />
    </div>
    <div id="bet-list-area" class="clearfix">
        <div class="ng-grid" ng-grid="gridOptions">
        </div>
    </div>
</div>