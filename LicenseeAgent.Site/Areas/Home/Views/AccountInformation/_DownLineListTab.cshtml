@model SearchUserResultViewModel
<div class="tab-pane fade" id="downlineList">
    <div class="content">
        @if (Model.Downlines.Any())
        {
            <div id="downlineContent" class="content">
                <ul class="nav nav-list">
                    @foreach (var downLine in Model.Downlines)
                    {
                        <li><a class="agent-inline" href="#" data-id="@downLine.DownlineCustId" title="@downLine.UserName">
                            <i class="icon-downline-arrow"></i>@downLine.UserName</a> </li>
                    }
                </ul>
            </div>
            <div id="paging" data-total-pages="@Model.TotalPages" data-page-index="@Model.PageIndex">
            </div>
        }
        else
        {
            <div class="no-info">@Las.NoDownline</div>
        }
    </div>
</div>