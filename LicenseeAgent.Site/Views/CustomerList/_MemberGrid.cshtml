<script type="text/javascript">
    var gridOptions = {
        columns:
            [
                /*{
                    HeaderText: '<i class="icon-uncheck-all" onclick="customerList.checkAllItem(this);"></i><i id="select-dropdown" class="icon-arrow"></i>',
                    Width: 30, Name: "Select", CellAlign: "center",
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return '<span class="cell-select icon icon-uncheck" onclick="customerList.selectClick(this);"></span>';
                    }
                },*/
                { HeaderText: "#", Width: 30, Name: "CustId", CellAlign: "center" },
                { HeaderText: "@Las.Action", Width: 35, Name: "Action", HeaderAlign: "center", CellAlign: "center", Formatter:
                    function (rowIndex, rowData, cell, cellFormated) {
                        return '<i class="icon-customer-edit" data-memberid="{0}" data-username="{1}"></i>'.format(rowData.CustId, rowData.UserName);
                    }
                },
                { HeaderText: "@Las.SystemId", Width: 140, Name: "SystemId", CanResize: true, Formatter:
                    function (rowIndex, rowData, cell, cellFormated) {
                        return '<span title="' + rowData.SystemId + '">' + cell.Value + '</span>';
                    }
                },
                { HeaderText: "@Las.Username", Width: 140, Name: "ShortUserName", HeaderAlign: "center", Formatter:
                    function (rowIndex, rowData, cell, cellFormated) {
                        return '<span title="' + rowData.UserName + '">' + cell.Value + '</span>';
                    }
                },
                { HeaderText: "@Las.Status", Width: 65, Name: "Status", HeaderAlign: "center", CellAlign: "center", Formatter:
                    function (rowIndex, rowData, cell, cellFormated) {
                        return '<div class="cust-status" onclick="customerList.changeStatus(this, ' + rowData.CustId + ')">'
                            + (cell.Value == 1 ? '<div class="icon-status-open"><span>Open</span></div>' : '<div class="icon-status-closed"><span>Closed</span></div>')
                            + '</div>';
                    }
                },
                {
                    HeaderText: "@Las.FullName", Width: 125, Name: "CustomerName", HeaderAlign: "center", AllowTruncate: true,
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        var customerName = CORE.formatCustomerName(rowData.FirstName, rowData.LastName);
                        return '<span title="' + customerName + '">' + customerName + '</span>';
                    }
                },
                { HeaderText: "@Las.Group", Width: 50, Name: "GroupName", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Las.CreatedDate", Width: 140, Name: "CreatedDate", HeaderAlign: "center", CellAlign: "center", FormatDateTime: CORE.DATE_FORMAT_FULL },
                { HeaderText: "@Las.LoginIp", Width: 100, Name: "IpLogin", HeaderAlign: "center", Formatter:
                    function (rowIndex, rowData, cell, cellFormated) {
                        if (cell.Value == null)
                            return '';
                        return '<span id="' + rowData.CustId + '" class="instruction-container">' + cell.Value + '</span>';
                    }
                }
            ],
        showPager: true,
        allowTruncate: true,
        gridExpandHeight: 125,
        indexNumberColumn: 0,
        bodyRowHeight: 29
    };
</script>