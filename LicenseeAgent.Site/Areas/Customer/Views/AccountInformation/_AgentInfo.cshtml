@model SearchUserResultViewModel
<div class="container-fluid left">
    @Html.HiddenFor(m => m.Customer.CustId, new { @id = "AgentId" })
    @if (Model.Uplines.Any())
    {
        var maxShow = 3;
        var numberUpline = Model.Uplines.Count();
        var moreLength = numberUpline - maxShow;
        var showStart = numberUpline > maxShow ? moreLength : 0;

       if (numberUpline > maxShow)
       {
        <div class="row">
            <div class="cell-left">@Las.MoreUplines</div>
            <div class="cell-right btn-group pull-right">
                <button id="more-upline" class="btn btn-mini btn-primary more popover-more" rel="popover" data-toggle="popover" data-content="@(RazorHelper.RenderPopoverAccountInformation(Model.Uplines.Take(moreLength).ToList()))">
                    @Las.More
                    <i id="more-popover" class="icon-more-arrow"></i>
                </button>
            </div>
        </div>
       }
        for (var index = showStart; index < numberUpline; index++)
       {
           var directUpline = Model.Uplines.ElementAt(index);
        <div class="row @(index == numberUpline-1 ? "row-bottom" : "")">
            <div class="cell-left">@string.Format(Las.AgentLevelFormat, directUpline.Level - 1)</div>
            <div class="cell-right">
                <a class="agent-inline" href="#" data-id="@(directUpline.UplineCustId)" title="@directUpline.UserName">
                    @directUpline.MediumUserName
                </a>
            </div>
                
        </div>
       }
    }
    @if (Model.Customer != null)
    {
    <div class="row cust-info">
        <div class="@(Model.Customer.Status == (int)AccountStatus.Open ? "open" : "closed")">
            <div class="cust-info-username"><span title="@Model.Customer.UserName">@Formatter.FormatMediumUserName(Model.Customer.UserName)</span><i class="icon-collapse" id="show-hide"></i></div>
            <div class="cust-info-pt">PT</div>
        </div>
        <table>
            <tbody>
                <tr>
                    <td>
                        <i class="icon-customer-status"></i>
                    </td>
                    <td>
                        <div class="wrapper-status">
                            <div class="@(Model.Customer.Status == (int)AccountStatus.Open ? "icon-status-open" : "icon-status-closed")" id="customer-status">
                                <span>@(Model.Customer.Status == (int)AccountStatus.Open ? "Open" : "Closed")</span>
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>
                        <i class="icon-customer-avatar"></i>
                    </td>
                    <td>@Model.Customer.FullName
                    </td>
                </tr>
                <tr>
                    <td>
                        <i class="icon-customer-cellphone"></i>
                    </td>
                    <td>@Model.Customer.MobileDisplay
                    </td>
                </tr>
                <tr>
                    <td>
                        <i class="icon-customer-phone"></i>
                    </td>
                    <td>@Model.Customer.PhoneDisplay
                    </td>
                </tr>
                <tr>
                    <td>
                        <i class="icon-customer-fax"></i>
                    </td>
                    <td>@Model.Customer.FaxDisplay
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    }
</div>