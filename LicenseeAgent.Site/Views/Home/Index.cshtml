@using LicenseeAgent.Core.Enumerations
@using LicenseeAgent.Core.Utility
@using LicenseeAgent.Web.ViewModels
@model HomeViewModel
@{
    ViewBag.Title = Las.LasTitle;
    Layout = null;
    var action = Model.TopMenu == TopMenu.Security ? "ChangePassword" : "Index";
    var iframeSrc = Url.Action(action, "Account");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/css/bootstrap")
    @Styles.Render("~/css/core")
    @Styles.Render("~/css/home")
    @Styles.Render("~/css/home/account-information")
    @Html.Partial("_AppScript")
    @Scripts.Render("~/js/jquery")
    @Scripts.Render("~/js/bootstrap")
    @Scripts.Render("~/js/language")
    @Scripts.Render("~/js/core")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/home")
    @Scripts.Render("~/js/home/account-information")
    @if (SessionManager.CurrentSession.IsViewSelectMenu())
    {
        @Scripts.Render("~/js/home/top-menu")
        <script type="text/javascript">
            $(function () {
                home.topMenu.init();
            });
        </script>
    }
</head>
<body>
    <div class="navbar navbar-fixed-top">
        <div class="header-box">
            @Html.Partial("_Header")
        </div>
    </div>
    <div id="main" class="container">
        <div class="leftmenu-box">
            @if (!Model.IsAgentChangePassword)
            {
                @Html.Partial("_LeftMenu")
            }
        </div>
        <div class="main-box">
            <div class="control-box">
                <i class="icon-expand-home" title="@Las.Close"></i>
            </div>
            <iframe id="frmMain" name="frmMain" frameborder=0 src="@iframeSrc"></iframe>
        </div>
    </div>
    @if (SessionManager.CurrentSession.IsViewIntro())
    {
        <div id="intro">
            @Html.Partial("_Intro")
        </div>
    }
    <div id="overlay" class="container">
    </div>
</body>
</html>