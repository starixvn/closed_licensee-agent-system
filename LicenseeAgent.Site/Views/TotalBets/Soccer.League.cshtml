@{
    Layout = null;
}
<div ng-controller="LeagueCotroller">
<input type="text" readonly="readonly" id="select-league" />
<span ng-click="loadLeague()" id="select-league-button" class="add-on btn dropdown-toggle" data-dropdown="dropdown">
    <span class="caret"></span></span>
<div class="select-league-area" >
    <table>
        <tr>
            <td>
                <input type="checkbox" class="check-all-league" id="league-0" data-id="0" />
            </td>
            <td class="league-name">
                @Las.All @Las.League
            </td>
        </tr>
        <tr>
            <td>
            </td>
            <td>
                <input type="text" id="search-league" ng-model="queryLeague.LeagueName" />
            </td>
        </tr>
        <tr ng-repeat="league in leagues | filter:queryLeague | orderBy: league.LeagueName">
            <td>
                <input type="checkbox" ng-change="childChange()" class="check-child-league" id="league-{{league.LeagueId}}" data-id="{{league.LeagueId}}" /> 
            </td>
            <td><span class="league-name">
                {{league.LeagueName}}></span> 
            </td>
        </tr>
        <tr>
            <td>
            </td>
            <td style="text-align: right;">
                <button class="btn btn-primary" type="button" id="cancel-league-select">@Las.Cancel</button>
                <button class="btn btn-primary" type="button" id="ok-league-select">@Las.OK</button>                
            </td>
        </tr>
    </table>
</div>
</div>