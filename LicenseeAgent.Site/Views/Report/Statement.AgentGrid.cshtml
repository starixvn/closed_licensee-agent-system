<script type="text/javascript">
    var gridOption = {
        columns: [
                { HeaderText: "#", Width: 30, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Las.Username", Width: 100, Name: "Username", AllowTruncate: true, CanResize: true, HeaderAlign: "center", CellAlign: "left",
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return ("<a href='javascript:STATEMENT.ViewDetail({0}, \"{1}\");'>" + cellFormated + "</a>").format(rowData.AgentId, cell.Value);
                    }
                },
                { HeaderText: "@Las.FullName", Width: 100, Name: "FullName", HeaderAlign: "center", CellAlign: "left", AllowTruncate: true, Formatter:
                    function (rowIndex, rowData, cell, cellFormated) {
                        return $.trim(cell.Value) == '' ? '--- ---' : cellFormated;
                    }
                },
                { HeaderText: "@Las.OpeningBalance", Width: 100, Name: "OpeningBalance", HeaderAlign: "center", CellAlign: "right", CanResize: true, FormatNumber: "0,0.00", FormatNegative: '$' },
                { HeaderText: "@Las.WinLoss", Width: 100, Name: "Winloss", HeaderAlign: "center", CellAlign: "right", CanResize: true, FormatNumber: "0,0.00", FormatNegative: '$' },
                { HeaderText: "@Las.Commission", Width: 100, Name: "Commission", HeaderAlign: "center", CellAlign: "right", CanResize: true, FormatNumber: "0,0.00", FormatNegative: '$', ThClass: 'alter-column' },
                { HeaderText: "@Las.TransferAmt", Width: 100, Name: "TransferAmt", HeaderAlign: "center", CellAlign: "right", CanResize: true, FormatNumber: "0,0.00", FormatNegative: '$', ThClass: 'alter-column',
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return ("<a class='num-link' href='javascript:STATEMENT.TransferDetail({0}, \"{1}\");'>" + cellFormated + "</a>").format(rowData.AgentId, rowData.Username);
                    }
                },
                { HeaderText: "@Las.ClosingBalance", Width: 100, Name: "ClosingBalance", HeaderAlign: "center", CellAlign: "right", CanResize: true, FormatNumber: "0,0.00", FormatNegative: '$' }

            ],
        gridExpandHeight: 200,
        showNumberColumn: true,
        showPager: true,
        //bodyRowHeight: 26,
        autoResizeColumn: true
    };
</script>