<ul class="nav nav-tabs">
    <li class="active"><a href="#MainMenu" id="tabMainMenu" data-toggle="tab">@Las.MainMenu</a></li>
    <li><a href="#accountInfo" id="tabAccInfo" data-toggle="tab">@Las.AccountInfo</a></li>
</ul>
<div id="myTabContent" class="tab-content">
    <div class="tab-pane active in" id="MainMenu">
        <ul class="nav nav-list">
            <li><a class="tree-toggler nav-header">@Las.TotalBets
            </a>
                <ul class="nav nav-list tree" style="display: none">
                    @BootstrapHelper.LeftMenu(Las.Soccer, Url.Action("Soccer", "TotalBets"))
                    @BootstrapHelper.LeftMenu(Las.Basketball, Url.Action("Basketball", "TotalBets"))
                    @BootstrapHelper.Menu(Las.OtherSports, Url.Action("OtherSports", "TotalBets"))
                </ul>
            </li>
            <li class="divider"></li>
            <li><a class="tree-toggler nav-header">@Las.Forecast</a>
                <ul class="nav nav-list tree" style="display: none">
                    @BootstrapHelper.LeftMenu(Las.ScoreMap, Url.Action("ChangePassword", "Account"))
                    @BootstrapHelper.Menu(Las.HOUL, Url.Action("ChangePassword", "Account"))
                </ul>
            </li>
            <li class="divider"></li>
            <li><a class="tree-toggler nav-header">@Las.Reports</a>
                <ul class="nav nav-list tree" style="display: none">
                    @BootstrapHelper.LeftMenu(Las.WinLoss, Url.Action("Index", "Account"))
                    @BootstrapHelper.LeftMenu(Las.Outstanding, Url.Action("Index", "Account"))
                </ul>
            </li>
            <li class="divider"></li>
            <li><a class="tree-toggler nav-header">@Las.CustomerInformation</a>
                <ul class="nav nav-list tree" style="display: none">
                    @if (SessionManager.CurrentSession.AgentInfo != null && SessionManager.CurrentSession.AgentInfo.IsLastLevel)
                    {
                        @BootstrapHelper.LeftMenu(Las.NewMember, Url.Action("InsertCustomer", "SportsbookSetting"))
                        @BootstrapHelper.LeftMenu(Las.MemberList, Url.Action("Index", "Customer"))
                    }
                    else
                    {
                        @BootstrapHelper.LeftMenu(Las.NewAgent, Url.Action("InsertCustomer", "SportsbookSetting"))
                        @BootstrapHelper.LeftMenu(Las.AgentList, Url.Action("Index", "Customer"))
                    }
                </ul>
            </li>
        </ul>
    </div>
    <div class="tab-pane fade" id="accountInfo">
        @Html.Action("Index","AccountInformation")
    </div>
</div>