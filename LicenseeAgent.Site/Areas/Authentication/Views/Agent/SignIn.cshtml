@model AgentSignInViewModel
@{
    ViewBag.Title = Las.SignIn;
    var captchaUrl = Url.RouteUrl("Authentication_Default", new
    {
        controller = "Captcha",
        action = "Index"
    });
}
<div class="container">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-horizontal" }))
    {
        <div class="login-box">
            <div class="header-box">
                <div class="title">
                    @Las.SignIn
                </div>
                @LanguageHelper.DropDown(Model.Language)
            </div>
            <div class="content-box">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Language)
                <div class="control-group">
                    @Html.TextBoxFor(m => m.Username, new { @class = "input-text", autocomplete = "off", placeholder = Las.Username })
                </div>
                <div class="control-group">
                    @Html.PasswordFor(m => m.Password, new { @class = "input-text", autocomplete = "off", placeholder = Las.Password })
                </div>
                <div class="control-group">
                    @Html.TextBoxFor(m => m.Captcha, new { @class = "input-captcha", autocomplete = "off", placeholder = Las.Captcha, maxlength = "6" })
                    <img src="@captchaUrl" id="img-captcha" alt="Captcha" />
                    <a id="reload" href="@captchaUrl"><i class="icon-captcha-reload"></i></a>
                    <input id="btnSubmit" type="submit" value="@Las.Submit" />
                </div>
            </div>
        </div>
        @Html.ValidationSummary(null, new { @class = "alert alert-danger" })
    }
</div>
@section scripts{
    @if (ViewBag.Result != null)
    {
        var result = (SignInViewResult)ViewBag.Result;
        <script type="text/javascript">
            AUTHENTICATION.showPasswordAlert('@result.Message');
        </script>
    }
}