@model SearchUserViewModel
@{
    Layout = null;
}
<script type="text/javascript">
    $(function () {
        customer.accountInformation.init();
    });
</script>
@using (Html.BeginForm("Search", null, FormMethod.Post, new { @class = "form-search form-inline" }))
{
    <div class="input-append">
        @Html.TextBoxFor(m => m.UserName, new { @placeholder = Las.Username, @class = "input-add-on", @maxlength = 50, @autocomplete = "off" })
        <span id="search" class="add-on"><i class="icon-customer-search"></i></span>
    </div>
}
<div id="searchAlert" class="alert alert-error">
    @Las.NoInfo
</div>
<div id="searchResult">
</div>