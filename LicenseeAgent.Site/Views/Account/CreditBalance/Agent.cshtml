@using LicenseeAgent.Core.Utils
@model LicenseeAgent.Transfer.ViewModels.TransferAgentViewModel
@{
    ViewBag.Title = @Las.Transfer;
}
<div class="legend">
    @ViewBag.Title
</div>
<div class="pull-left">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-table" }))
    {
        @Html.ValidationSummary()
        <fieldset>
            @if (ViewBag.Result != null)
            {
                <p class="text-success">
                    @ViewBag.Result.ToString()
                </p>
            }
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.AgentId)
            <table>
                <colgroup>
                    <col width="150" />
                    <col />
                </colgroup>
                <tbody>
                    <tr>
                        <td>
                            @Las.Username
                        </td>
                        <td>
                            @Model.AgentName
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.Amount)
                        </td>
                        <td>
                            @Html.TextBox("Amount", Formatter.FormatDecimal(Model.Amount), new { @class = "w160", data_val_range_min = Model.MinAmount, data_val_range_max = Model.MaxAmount, data_val_range = Las.InvalidAmount })
                            <span>@string.Format("[{0}; {1}]", Formatter.FormatDecimal(Model.MinAmount), Formatter.FormatDecimal(Model.MaxAmount))</span>
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="button-group row-fluid">
                <button type="button" class="btn btn-primary pull-right" onclick="POPUP.close(0);">
                    @Las.Cancel
                </button>
                <button type="submit" class="btn btn-primary pull-right">
                    @Las.Transfer
                </button>
            </div>
        </fieldset>
    }
</div>
@section scripts
{
    @Scripts.Render("~/js/transfer-popup")
}