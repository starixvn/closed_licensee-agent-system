@using LicenseeAgent.Web.Mvc
@model UnderMaintenanceInfo
@{
    Layout = null;
    string title = Las.UnderMaintenance;
    string UMtime = Model.StartTime.ToUpper() + " - " + Model.EndTime.ToUpper() + " (GMT + 08:00)";
    string messageUM = string.Format(Las.MessageUnderMaintenance, Model.UMDate, UMtime);
}
<!DOCTYPE HTML>
<html>
<head>
    <title>@title</title>
    <link rel="Stylesheet" href="~/views/error/resources/index.less" type="text/css" />
</head>
<body>
    <div class="um-block">
        <div class="block-text">
            <span>@Html.Raw(messageUM)</span></div>
    </div>
</body>
</html>