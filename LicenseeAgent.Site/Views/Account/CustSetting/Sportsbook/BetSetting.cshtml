@using LicenseeAgent.Core.Enumerations
@using LicenseeAgent.CustomerSetting.Entities.Sportsbook;
@model SettingContext
@{
    Layout = null;
}
@helper SectionInfoMode(string id, bool simpleMode)
    {
    if (simpleMode)
    {
    <span class="section-info" title="@Las.ClickToViewInstructions" id="@id" ng-show="settingMode">
    </span>
    }
    else
    {
    <span class="section-info" title="@Las.ClickToViewInstructions" id="@id" ng-hide="settingMode">
    </span>
    }
}
<div class="instruction">
    @Las.BetSetting
    @if (Model.TargetRoleId == (int)Role.AgentLevel1)
    {
        @SectionInfoMode("licensee-bet-limit-info-button", true)
        @SectionInfoMode("licensee-bet-limit-info-button-adv", false)
    }
    else if (Model.TargetRoleId == (int)Role.Agent)
    {
        @SectionInfoMode("agent-bet-limit-info-button", true)
        @SectionInfoMode("agent-bet-limit-info-button-adv", false)
    }
    else
    {
        @SectionInfoMode("member-bet-limit-info-button", true)
        @SectionInfoMode("member-bet-limit-info-button-adv", false)
    }
</div>
<div class="container-box">
    <div id="betting-limit-current-scope" class="betting-limit" ng-controller="fanex.custsetting.betlimitcontroller">
        <div ng-show="settingContext.IsSimpleMode" class="simple-mode">
            <div>
                <div class="betting-limit-header">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MinBet']}}</span></div>
                </div>
                <div class="betting-limit-header">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MaxBet']}}</span></div>
                </div>
                <div class="betting-limit-header">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MaxPerMatch']}}</span></div>
                </div>
            </div>
            <betting-limit-simple-mode model-data="model.firstRecord"></betting-limit-simple-mode>
        </div>
        <div ng-show="!settingContext.IsSimpleMode">
            <div>
                <div class="betting-limit-header row-title">
                    <div class="betting-limit-header-text">
                    </div>
                </div>
                <div class="betting-limit-header">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MinBet']}}</span></div>
                </div>
                <div class="betting-limit-header">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MaxBet']}}</span></div>
                </div>
                <div class="betting-limit-header">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MaxPerMatch']}}</span></div>
                </div>
            </div>
            <div ng-repeat="betSetting in model.bettingLimitsModel">
                <betting-limit-advanced-mode betting-limits-model="model.bettingLimitsModel" bet-setting="betSetting"
                    current-index="$index"></betting-limit-advanced-mode>
                <div class="clearfix">
                </div>
            </div>
        </div>
    </div>
</div>
