@{
    ViewBag.Title = Las.Soccer + " - " + Las.TotalBets;
}
@using LicenseeAgent.TotalBets.Entities;
@using LicenseeAgent.TotalBets.ViewModels;
@model SoccerViewModel
@section css{
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/plugin")
    @Styles.Render("~/css/totalbets")
}
@section scripts{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/plugin")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/totalbets-soccer")
    @Html.Partial("Soccer.Script")
}
<div class="legend">
    @ViewBag.Title
</div>
@using (Html.BeginForm("Soccer", "TotalBets", FormMethod.Post, new { @class = "form-inline form-filter ", id = "main-form" }))
{   
    <div class="controls-row">
        <div id="league-multi-select">
        </div>
    </div>
    <div class="controls-row">
        <div id="event-multi-select">
        </div>
    </div>
    <div class="controls-row">
        <button class="btn btn-primary" type="submit">
            @Las.Submit
        </button>
    </div>
    <div class="controls-row refresh-count-down-area">
        <div class="refresh-count-down" id="refresh-count-down">
        </div>
    </div>
    <input type="hidden" value="@Model.TimeInterval" id="server-time-interval" />
    @Html.HiddenFor(m => m.SelectedEvent)
    @Html.HiddenFor(m => m.SelectedLeague)
}
<div class="wrapper">
    <div id="grid" class="freegrid">
    </div>
</div>
