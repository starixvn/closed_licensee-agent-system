@using LicenseeAgent.Transfer.ViewModels
@using LicenseeAgent.Core.Utility
@model TransferViewModel
@{
    ViewBag.Title = Las.Transfer;
}
@section css
{
    @Styles.Render("~/css/fanexgrid")
}
<div class="legend">
    @ViewBag.Title
</div>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-inline form-filter " }))
{
    <div class="controls-row">
        @Html.LabelFor(m => m.UserName)
        @Html.TextBoxFor(m => m.UserName, new { @class = "w160", @placeholder = @Las.Username, @autocomplete = "off" })
    </div>
    <div class="controls-row">
        @Html.LabelFor(m => m.Status)
        @Html.DropDownListFor(m => m.Status, ModelSettings.StatusList, new { @class = "selectpicker w100" })
    </div>
    <div class="controls-row">
        <button class="btn btn-primary" type="submit">
            @Las.Submit
        </button>
    </div>
}
<ul class="bullet-star">
    <li>
        @Las.TransferTimeWarning
    </li>
    @if (SessionManager.CurrentSession.AgentInfo.IsLastLevel)
    {
        <li class="text-warning">
            @Html.Raw(Las.TransferMemberWarning)
        </li>
    }
</ul>
<div id="grid" class="freegrid">
</div>
@section scripts
{
    @Scripts.Render("~/js/contextmenu")
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/transfer")
    <script type="text/javascript">
        $(function () {
            TRANSFER_LIST.init(@Formatter.FormatJson(SessionManager.CurrentSession.AgentInfo.IsLastLevel));
        });
    </script>
}