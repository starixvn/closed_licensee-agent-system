@{
    ViewBag.Title = "LAS's Bet List";
}
@section css
{
    @Styles.Render("~/css/angulargrid")
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/bootstrap-select")
    @Styles.Render("~/css/monthpicker")
}
@section scripts
{
    @Scripts.Render("~/js/angular")
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/bootstrap-select")
    @Scripts.Render("~/js/monthpicker")

    <script type="text/javascript" src=@Url.Content("~/Views/BetList/Resources/BetListManager.js")></script>
    <script type="text/javascript">
        var _today = '@DateTime.Today.ToShortDateString()';
        var _minDate = '@DateTime.Now.AddMonths(-2).ToShortDateString()';
        var lastDay = '@DateTime.DaysInMonth(DateTime.Now.AddMonths(-1).Year, DateTime.Now.AddMonths(-1).Month)';
        var lastMonth = '@DateTime.Now.AddMonths(-1).Month';
        var lastYear = '@DateTime.Now.AddMonths(-1).Year';
    </script>
}
<style>
    .monpickr-super-wrapper 
    {
        display: inline-block;
        margin-top: 3px;
        font-size: 10px;
    }
    
    .filter-area 
    {
        margin-bottom: 0;
    }
    
    .gridWrapper
    {
        width: 1010px;
        height: 500px;
    }
    
    .instruction-content table
    {
        width: 400px;
    }
    
    .instruction-content table .col-left
    {
        width: 100px;
    }
    
    .instruction-content table .col-right
    {
        font-weight: bold;
    }
    
</style>
<div class="legend">Bet List</div>
<div>
    @using (Html.BeginForm("BetListSelByMember", "BetList", FormMethod.Post,
        new { @class = "form-inline form-filter ", id = "search-form" }))
    {
        <div id="filter-area" class="clearfix filter-area">
            <div class="controls-row">
                <div class="month pull-left">Month</div>
                <div class="pull-left controls-row" id="month-picker-control"></div>
            </div>
            <div class="controls-row">
                @Html.Label("Status", "Status")
                @Html.DropDownList("Status", ModelSettings.BetListStatuses, new { @class = "selectpicker w100" })
            </div>
            <div class="controls-row">
                <button class="btn btn-primary" type="submit">Submit</button>
            </div>
        </div>
    }
    <div class="gridWrapper">
        <div id="BetListGrid" class="freegrid content-grid" data-url-ip="@Url.Action("GetIpInformation", "Customer")">
        </div>
    </div>
</div>
<div id="instruction" class="instruction-content">
</div>