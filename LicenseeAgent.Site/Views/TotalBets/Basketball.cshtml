@{
    ViewBag.Title = Las.Basketball + " - " + Las.TotalBets;
}
@using LicenseeAgent.TotalBets.Entities;
@section css{
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/plugin")
    @Styles.Render("~/css/totalbets")
    @Styles.Render("~/css/betlist")
}
@section scripts{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/plugin")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/totalbets-basketball")
    @Html.Partial("Basketball.Script")
}

<div class="legend">
    @ViewBag.Title
    <span id="totalbets-back" onclick="Basketball.submitForm();" class="totalbets-hide"><i class="icon-history-back">
    </i>
        @Las.Back
    </span>
</div>
<div id="totalbets-filter" class="">
    @using (Html.BeginForm("Basketball", "TotalBets", FormMethod.Post, new { @class = "form-inline form-filter ", id = "main-form" }))
    {   
        <div class="controls-row">
            <div id="league-multi-select">
            </div>
        </div>
        <div class="controls-row">
            <div id="event-multi-select">
            </div>
        </div>
        <div class="controls-row">
            <button class="btn btn-primary" type="submit" id="btnSubmit">
                @Las.Submit
            </button>
        </div>
        <div class="controls-row refresh-count-down-area">
            <div class="refresh-count-down" id="refresh-count-down">
            </div>
            <input type="hidden" value="15" id="server-time-interval" />
        </div>
    }
</div>
<div class="wrapper">
    <div id="BetListGrid" class="freegrid content-grid" data-url-ip="@Url.Action("GetIpInformation", "CustomerList")">
    </div>
</div>
<div id="instruction" class="instruction-content">
</div>