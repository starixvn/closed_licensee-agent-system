@{
    Layout = "~/Views/Instruction/Shared/_Layout.cshtml";
}
<div class="instruction-content">
    <p>
        Min Bet, Max Bet and Max Per Match for each product (Sport type) are defined here.
    </p>
    <ul>
        <li>Min Bet: the minimum stake allowed on a bet. ">= X" means Input must be greater
            than or equal to X.</li>
        <li>Max Bet: the maximum stake allowed on a bet. "<= X" means Input must be less than
            or equal to X.</li>
        <li>Match Per Match: the maximum stake allowed on a match. "<= X" means Input must be
            less than or equal to X.</li>
    </ul>
    <p>
        <span class="note">Note:</span> decimal numbers are not allowed. For instance, 100.25
        is an invalid input.
    </p>
</div>