<#@ template debug="true" hostspecific="true"#>
<#@ output extension=".js" #>
<#@ assembly name="System.Windows.Forms" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Resources"#>
<#@ include file="$(ProjectDir)\\Scripts\\ResourcesJs\\TemplateFileManagerV2.1.ttinclude" #>

<#
    var solutionPath = Host.ResolveAssemblyReference("$(SolutionDir)");
    var resourcePath = Path.Combine(solutionPath, "LicenseeAgent.Resources");
    var fileNames = new string[]
    {
        Path.Combine(resourcePath, "Las.resx"),
        Path.Combine(resourcePath, "Las.zh-CN.resx"),
        Path.Combine(resourcePath, "Las.zh-TW.resx")
    };

    var manager = TemplateFileManager.Create(this);

    foreach (string filePath in fileNames) 
    {
        var fileName = filePath.Substring(filePath.LastIndexOf('\\') + 1).Replace(".resx","");
        var cultureIndex = fileName.IndexOf(".");
        var culture = cultureIndex > 0 ? fileName.Substring(cultureIndex + 1) : "en-US";
        var resourceXSet = new ResXResourceSet(filePath);

        manager.StartNewFile(string.Format("languages.{0}.js", culture));
#>
/*jshint -W101,-W106,-W044,-W098*/

