@model SearchUserResultViewModel
@{
    var pageContext = (PageContext)ViewBag.PageContext;
}
<div class="controls-row last">
    <div class="row-line">
    </div>
    <ul class="nav nav-tabs">
        @*<li><a href="#setting" id="tabSetting" data-toggle="tab">@Las.Setting</a></li>*@
        <li class="active"><a href="#action" id="tabAction" data-toggle="tab">@Las.Action</a></li>
    </ul>
    <div class="tab-content">
        @*<div class="tab-pane fade" id="setting"></div>*@
        <div class="tab-pane active in" id="action">
            <div class="content">
                <ul class="nav nav-list">
                    <li>
                        @if (SessionManager.CurrentSession.IsAdmin && pageContext.IsMember)
                        {
                            <a href="#" rel="popover" data-toggle="popover" data-content="@(RazorHelper.RenderPopoverCustomerSetting(Model.Customer.CustId, Model.Uplines.ToList(), Model.Customer.NumberOfLevel, "EditMember"))" data-original-title="" class="popover-link">
                                <i class="icon-downline-arrow"></i>
                                @(pageContext.IsAdmin || pageContext.IsDirectDownLine || pageContext.IsMember ? Las.EditSportsbook : Las.ViewSportsbook)
                            </a>
                        }
                        else
                        {
                            <a href="@(pageContext.IsMember ? Url.Action("EditMember", "CustomerSetting", new { area = "", memberId = Model.Customer.CustId }) : Url.Action("EditAgent", "CustomerSetting", new { area = "", agentId = Model.Customer.CustId }))" target="frmMain">
                                <i class="icon-downline-arrow"></i>
                                @(pageContext.IsAdmin || pageContext.IsDirectDownLine || pageContext.IsMember ? Las.EditSportsbook : Las.ViewSportsbook)
                            </a>
                        }
                    </li>
                    <li>
                        @if (SessionManager.CurrentSession.IsAdmin && pageContext.IsMember)
                        {
                            if (pageContext.IsOfferedVirtualSports)
                            {
                            <a href="#" rel="popover" data-toggle="popover" data-content="@(RazorHelper.RenderPopoverCustomerSetting(Model.Customer.CustId, Model.Uplines.ToList(), Model.Customer.NumberOfLevel, "EditVirtualSportsMember"))" data-original-title="" class="popover-link">
                                <i class="icon-downline-arrow"></i>
                                @(pageContext.IsAdmin || pageContext.IsDirectDownLine || pageContext.IsMember ? Las.EditVirtualSports : Las.ViewVirtualSports)
                            </a>
                            }
                        }
                        else
                        {
                            if (pageContext.IsOfferedVirtualSports)
                            {
                            <a href="@(pageContext.IsMember ? Url.Action("EditVirtualSportsMember", "CustomerSetting", new { area = "", memberId = Model.Customer.CustId }) : Url.Action("EditVirtualSportsAgent", "CustomerSetting", new { area = "", agentId = Model.Customer.CustId }))" target="frmMain">
                                <i class="icon-downline-arrow"></i>
                                @(pageContext.IsAdmin || pageContext.IsDirectDownLine || pageContext.IsMember ? Las.EditVirtualSports : Las.ViewVirtualSports)
                            </a>
                            }
                        }
                    </li>
                    <li><a href="@(pageContext.IsMember ? Url.Action("ResetPasswordMember", "CustomerList", new { area = "", memberId = Model.Customer.CustId }) : Url.Action("ResetPasswordAgent", "CustomerList", new { area = "", agentId = Model.Customer.CustId, agentLevel = Model.Customer.Level }))" target="frmMain">
                        <i class="icon-downline-arrow"></i>
                        @Las.ResetPassword
                    </a></li>
                    @if ((SessionManager.CurrentSession.IsAdmin || (bool)pageContext.IsDirectDownLine)  && !(pageContext.IsMember && pageContext.IsDeposit) )
                    {
                        <li><a href="@(pageContext.IsMember ? Url.Action("EditInfoMember", "CustomerList", new { area = "", memberId = Model.Customer.CustId, username = Model.Customer.UserName }) : Url.Action("EditInfoAgent", "CustomerList", new { area = "", agentId = Model.Customer.CustId }))" target="frmMain">
                            <i class="icon-downline-arrow"></i>
                            @Las.EditInfo
                        </a></li>
                    }
                    @if (!pageContext.IsMember &&
                        (SessionManager.CurrentSession.IsAdmin && (SessionManager.CurrentSession.AgentInfo.IsCredit || (!pageContext.IsLastLevel && SessionManager.CurrentSession.AgentInfo.IsDeposit)))
                        || (!SessionManager.CurrentSession.IsAdmin && pageContext.IsDirectDownLine))
                    {
                        <a href="@(Url.Action("InsertCustomer", "CustomerSetting", new { area = "", agentId = Model.Customer.CustId }))" target="frmMain">
                            <i class="icon-downline-arrow"></i>
                            @Las.AddDownline
                        </a>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>