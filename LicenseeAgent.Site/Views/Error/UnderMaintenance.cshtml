@using LicenseeAgent.Web.Mvc
@model UnderMaintenanceInfo
@{
    ViewBag.Title = Las.UnderMaintenance;
}
@section scripts
{
    @Html.Partial("_AppScript")
    @Scripts.Render("~/js/jquery")
    @Scripts.Render("~/js/core")
    @Scripts.Render("~/js/error/under-maintenance")
    <script type="text/javascript">
        $(function () {
            UNDER_MAINTENANCE_PAGE.init();
        });
    </script>
}
<div class="um-block">
</div>
<div class="block-text">
    <p>
        We are having server maintenance, website will be unavailable
        <br />
        from @Model.TimeFrom until @Model.TimeTo (GMT +08:00).
        <br />
        Sorry for the inconveniences caused!
    </p>
    <p>
        我们正在服务器维护，网站将被从 @Model.TimeFrom 至 @Model.TimeTo (GMT +08:00) 无法使用。不便之处，敬请原谅！
    </p>
    <p>
        我們正在服務器維護，網站將被從 @Model.TimeFrom 至 @Model.TimeTo (GMT +08:00) 無法使用。不便之處，敬請原諒！
    </p>
</div>