<#@ template debug="true" hostSpecific="true" #>
<#@ output extension=".txt" #>
<#@ assembly name="System.Xml" #>
<#@ assembly name="System.Xml.Linq" #>
<#@ Assembly Name="System.Data" #>
<#@ Import Namespace="System.Data" #>
<#@ Import Namespace="System.Data.SqlClient" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Security" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Xml.Linq" #>
<#@ import namespace="System.Windows.Forms" #>
<#@ include file="$(SolutionDir)\Packages\T4.TemplateFileManager.2.1.2\tools\ttinc\TemplateFilemanager.CS.ttinclude" #>
<#@ include file="SiteConfiguration.ttinclude" #>
<#
    var manager = TemplateFileManager.Create(this);
    foreach(var site in sites)
    {
        var x = site.ToString();
        var fileName = string.Format("Web.AppSettings.{0}.{1}.config", site.Environment, site.IsAdmin ? "Admin" : "Agent");
        manager.StartNewFile(fileName);
#>
<?xml version="1.0"?>
<appSettings>
  <add key="IsAdminSite" value="<#=site.IsAdminSite#>" />
  <add key="SiteEnvironment" value="<#=site.AppSettingEnvironment#>" />
  <add key="RemoteRefURL" value="<#=site.RemotingRefUrl#>" />
  <add key="UnderMaintenanceUrl" value="<#=site.UnderMaintenanceUrl#>" />
  <!--Using format "10:00AM - 13:00PM" to enable UM for example-->
  <add key="DownTime" value="" />
  <add key="TaiwanAPIUrl" value="<#=site.TaiwanAPIUrl#>" />
  <add key="TrustedAdmins" value="<#=site.TrustedAdmins#>" />
  <add key="OfferedProducts" value="<#=site.OfferedProducts#>" />
</appSettings>
<#
    }
    manager.Process();
#>