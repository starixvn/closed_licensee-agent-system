@model AgentSignInViewModel
@{
    ViewBag.Title = Las.SignIn;
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<div class="container">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-horizontal" }))
    {
        <div class="login-box">
            <div class="header-box">
                <div class="title">@Las.SignIn</div>
                <div class="language">
                    <ul id="nav">
                        <li class="icon-language-arrow"><a href="#" class="@string.Format("icon-flag-{0}", Model.Language)">
                        </a>
                            <ul id="languages">
                                @foreach (var language in ModelSettings.Languages)
                                {
                                    <li data-language="@language.Value"><a href="#"><i class="@string.Format("icon-flag-{0}", language.Value)">
                                    </i>
                                        @language.Text
                                    </a></li>
                                }
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="content-box">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Language)
                <div class="control-group">
                    @Html.TextBoxFor(m => m.Username, new { @class = "input-text", autocomplete = "off", placeholder = Las.Username })
                </div>
                <div class="control-group">
                    @Html.PasswordFor(m => m.Password, new { @class = "input-text", autocomplete = "off", placeholder = Las.Password })
                </div>
                <div class="control-group">
                    @Html.TextBoxFor(m => m.Captcha, new { @class = "input-captcha", autocomplete = "off", placeholder = Las.Captcha, maxlength = "6" })
                    <img src="@Url.Action("CaptchaImage")" id="img-captcha" alt="Captcha" />
                    <a id="reload" href="#"><i class="icon-captcha-reload">
                    </i></a>
                    <input id="btnSubmit" type="submit" value="@Las.Submit" />
                </div>
            </div>
        </div>
        @Html.ValidationSummary()
    }
</div>
@if (ViewBag.Result != null)
{
    var result = (LicenseeAgent.Account.ViewResults.SignInViewResult)ViewBag.Result;
    <div id="dialog-confirm" title="@Las.PasswordAlert" data-href="~/Home/Index">
        <p>
            @result.Message
        </p>
    </div>
}
@section scripts{
    @if (ViewBag.Result != null)
    {
        var result = (LicenseeAgent.Account.ViewResults.SignInViewResult)ViewBag.Result;
        <script type="text/javascript">
            LOGIN.showAlert(@result.IsConfirm.ToString().ToLower(), "@Las.ChangePassword");
        </script>
    }
}