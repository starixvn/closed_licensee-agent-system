@{
    ViewBag.Title = Las.Basketball + " - " + Las.TotalBets;
}
@using LicenseeAgent.TotalBets.Entities;
@section css{
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/plugin")
    @Styles.Render("~/css/betlist")
}
@section scripts{
    @Scripts.Render("~/js/angular")
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/plugin")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/totalbets/parlay")
}

<div class="legend">
