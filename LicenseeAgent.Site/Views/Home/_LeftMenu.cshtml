@using LicenseeAgent.Web.Filters
@using LicenseeAgent.Core.Enumerations
@{
    var isLastLevel = SessionManager.CurrentSession.AgentInfo != null && SessionManager.CurrentSession.AgentInfo.IsLastLevel;
    var isAdmin = SessionManager.CurrentSession.AgentInfo != null && SessionManager.CurrentSession.AgentInfo.IsLevel0;
}
<ul class="nav nav-tabs">
    <li class="active"><a href="#MainMenu" id="tabMainMenu" data-toggle="tab">@Las.MainMenu</a></li>
    <li><a href="#accountInfo" id="tabAccInfo" data-toggle="tab">@Las.AccountInfo</a></li>
</ul>
<div id="myTabContent" class="tab-content">
    <div class="tab-pane active in" id="MainMenu">
        <ul class="nav nav-list">
            <li><a class="tree-toggler nav-header">@Las.TotalBets
            </a>
                <ul class="nav nav-list tree" style="display: none">
                    @BootstrapHelper.LeftMenu(Las.Soccer, Url.Action("Soccer", "TotalBets"))
                    @BootstrapHelper.LeftMenu(Las.Basketball, Url.Action("Basketball", "TotalBets"))
                    @BootstrapHelper.LeftMenu(Las.OtherSports, Url.Action("OtherSports", "TotalBets"))
                    @BootstrapHelper.LeftMenu(Las.Parlay, Url.Action("ParlayList", "Parlay"))
                    @BootstrapHelper.LeftMenu(Las.Outright, Url.Action("Outright", "TotalBets"))
                </ul>
            </li>
            <li class="divider"></li>
            <li><a class="tree-toggler nav-header">@Las.Reports</a>
                <ul class="nav nav-list tree" style="display: none">
                    @BootstrapHelper.LeftMenu(Las.AgentWinLoss, Url.Action("Index", "AgentWinLoss", new { area = "Report" }))
                    @BootstrapHelper.LeftMenu(Las.AgentOutstanding, Url.Action("Index", "AgentOutstanding", new { area = "Report" }))
                    @BootstrapHelper.LeftMenu(Las.Results, Url.Action("Results", "Report"))
                    @if (LegendTypeAttribute.Authorize(LegendType.Credit))
                    {
                        if (SessionManager.CurrentSession.AgentInfo != null && !SessionManager.CurrentSession.AgentInfo.IsLevel0)
                        {
                        @BootstrapHelper.LeftMenu(Las.Statement, Url.RouteUrl("Report_Statement", new { action = "Current" }))
                        }
                        @BootstrapHelper.LeftMenu(Las.DownlineStatement, Url.RouteUrl("Report_Statement", new { action = "Index" }))
                    }
                </ul>
            </li>
            <li class="divider"></li>
            <li><a class="tree-toggler nav-header">@Las.CustomerInformation</a>
                <ul class="nav nav-list tree" style="display: none">
                    @if (!isLastLevel)
                    {
                        @BootstrapHelper.LeftMenu(Las.NewAgent, Url.RouteUrl("ProductSetting_NewAgent"))
                    }
                    @BootstrapHelper.LeftMenu(Las.AgentList, Url.Action("Index", "Agent", new { area = "CustomerList" }))
                    @if (!isAdmin)
                    {
                        @BootstrapHelper.LeftMenu(Las.DirectMemberList, Url.Action("Index", "Member", new { area = "CustomerList" }))
                    }
                    @if (LegendTypeAttribute.Authorize(LegendType.Deposit))
                    {
                        @BootstrapHelper.LeftMenu(Las.PendingMemberList, Url.Action("Index", "PendingMember", new { area = "CustomerList" }))
                    }
                    @if (LegendTypeAttribute.Authorize(LegendType.Credit))
                    {
                        @BootstrapHelper.LeftMenu(Las.CreditBalance, Url.Action("Index", "CreditBalance"))
                    }
                    @if (AccountTypeAttribute.Authorize(AccountType.Admin) && LegendTypeAttribute.Authorize(LegendType.Deposit))
                    {
                        @BootstrapHelper.LeftMenu(Las.MemberReArrangement, Url.Action("Index", "MemberArrangement", new { area = "MemberArrangement" }))
                    }
                    @if (AccountTypeAttribute.Authorize(AccountType.Admin) && LegendTypeAttribute.Authorize(LegendType.Deposit) && SessionManager.CurrentSession.AgentInfo.IsAllowedMemberComm)
                    {
                        @BootstrapHelper.LeftMenu(Las.CommissionGroup, Url.Action("Index", "GroupList", new { area = "CommissionSetting" }))
                    }
                </ul>
            </li>
            @if (SessionManager.CurrentSession.IsShowMaintenance())
            {
                <li class="divider"></li>
                <li><a class="tree-toggler nav-header">@Las.Maintenance</a>
                    <ul class="nav nav-list tree" style="display: none">
                        @BootstrapHelper.LeftMenu(Las.Password, Url.RouteUrl("Admin_Maintenance", new { action = "Password" }))
                        @BootstrapHelper.LeftMenu(Las.MemberAPIMonitoring, Url.RouteUrl("Admin_Maintenance", new { action = "SyncMonitoring" }))
                    </ul>
                </li>
            }
        </ul>
    </div>
    <div class="tab-pane fade" id="accountInfo">
        @Html.Action("Index", "AccountInformation", new { area = "Home" })
    </div>
</div>