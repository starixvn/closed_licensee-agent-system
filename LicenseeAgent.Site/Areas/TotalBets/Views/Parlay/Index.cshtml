@{
    ViewBag.Title = Las.Parlay + " - " + Las.TotalBets;
}
@section css
{
    @Styles.Render("~/css/betlist")
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/totalbets")
}
@section scripts
{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/totalbets")
    <script type="text/javascript">
        $(function () {
            totalBets.parlay.init();
        });
    </script>
    <script type="text/javascript">
        var _today = '@DateTime.Today.ToShortDateString()';
        var _minDate = '10/1/2013';
        var lastDay = '@DateTime.Now.Day';
        var lastMonth = '@DateTime.Now.Month';
        var lastYear = '@DateTime.Now.Year';
        var custId = '@ViewBag.CustId';
    </script>
}
<div class="legend">
    @ViewBag.Title
</div>
<div class="controls-row">
    <button class="btn btn-parlay active" type="button" data-bet-type="@((int)BetType.BetType_9)">
        @Las.MixParlay
    </button>
    <button class="btn btn-parlay" type="button" data-bet-type="@((int)BetType.BetType_29)">
        @Las.SystemParlay
    </button>
</div>
<div id="BetListGrid" class="freegrid content-grid">
</div>