@model SearchUserResultViewModel
@{
    var pageContext = (PageContext)ViewBag.PageContext;
    var actionName = (string)ViewData["actionName"];
    var controller = (string)ViewData["controller"];
    var area = (string)ViewData["area"];
}
<table class="dropdown">
    <colgroup>
        <col width="80" />
        <col width="80" />
    </colgroup>
    <thead>
        <tr>
            <th>
                @Las.Level
            </th>
            <th>
                @Las.Username
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entity in Model.Uplines)
        {
            <tr>
                <td>
                    @string.Format(Las.AgentLevelFormat, entity.Level - 1)
                </td>
                <td>
                    <a class="agent-inline" href="@Url.Action(actionName, controller, new { area = area, memberId = Model.Customer.CustId, agentId = entity.UplineCustId, agentLevel = entity.Level, numberOfLevel = Model.Customer.NumberOfLevel }))"  target="frmMain" onclick='home.accountInformation.hidePopover();' title="@entity.UserName">
                        @entity.MediumUserName
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>