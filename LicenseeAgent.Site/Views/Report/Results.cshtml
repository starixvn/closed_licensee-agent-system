@{
    ViewBag.Title = Las.PageTitle_Report_Results;
}
@section css
{
}
@section scripts
{
    <script type="text/javascript" src='@Url.Content("~/Views/Report/Resources/ReportManager.js")'></script>
}
<div class="legend">
    @ViewBag.Title
</div>
<div id="filter-tabs">
    <ul>
        <li><a href="#filter-tab-match"> @Las.MatchResults</a></li>
        <li><a href="#filter-tab-outright">@Las.OutrightResults</a></li>
    </ul>
    <div id="filter-tab-match">
        <div class="controls-row">
            <span>Date</span>
            <button class="btn btn-primary" type="submit">@Las.Submit</button>
            <button class="btn btn-primary" type="submit">@Las.Yesterday</button>
            <button class="btn btn-primary" type="submit">@Las.Today</button>
        </div>
        <div class="controls-row">
            <span>Sport</span>
            <span>League</span>
        </div>
    </div>
    <div id="filter-tab-outright">
        Content 2
    </div>
</div>