@using LicenseeAgent.BetList.ViewModels
@model MemberViewModel
@{
    ViewBag.Title = Las.PageTitle_BetList;
}
@section css
{
    @Styles.Render("~/css/monthpicker")
    @Styles.Render("~/css/betlist")
    @Styles.Render("~/css/fanexgrid")
}
@section scripts
{
    @Scripts.Render("~/js/angular")
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/monthpicker")
    @Scripts.Render("~/js/betlist/member")
    <script type="text/javascript">
        $(function () {
            BET_LIST.MEMBER.init();
        });
    </script>
}
<div class="legend">
    @ViewBag.Title
</div>
<div>
    @using (Html.BeginForm(null, null, FormMethod.Post,
        new { @class = "form-inline form-filter ", id = "search-form" }))
    {
        <div id="filter-area" class="clearfix filter-area">
            <div class="controls-row inline">
                <label class="w60">
                    @Las.Month
                </label>
                <div id="month-picker-control" class="inline">
                </div>
            </div>
            <div class="controls-row">
                @Html.Label("Status", Las.Status, new { @class = "month" })
                @Html.DropDownList("Status", ModelSettings.BetListStatuses, new { @class = "selectpicker w100" })
            </div>
            <div class="newline">
            </div>
            @ReportHelper.CheckBoxes(Model.ProductList, "", "w60")
            <div class="controls-row">
                <label class="w60">
                </label>
                <button class="btn btn-primary" type="submit">
                    @Las.Submit
                </button>
            </div>
        </div>
        <input type="hidden" id="Product" />
    }
</div>
<div id="BetListGrid" class="freegrid content-grid">
</div>