<script type="text/javascript">
    var gridOption = {
        columns: [
                        {
                            HeaderText: "<span class='icon-uncheck-all' onclick='customerList.checkAllItem(this);'></span>" +
                                        "<span class='icon-arrow' onclick='customerList.onShowTop();'></span>", Width: 30, Name: "CustId", CellAlign: "center", Formatter:
                            function (rowIndex, rowData, cell, cellFormated) {
                                return '<span class="cell-select icon icon-uncheck" onclick="customerList.selectClick(this);"></span>';
                            }
                        },
                        { HeaderText: "#", Width: 30, Name: "CustId", CellAlign: "center" },
                        { HeaderText: "@Las.Action", Width: 30, Name: "Edit", HeaderAlign: "center", CellAlign: "center", Formatter:
                            function (rowIndex, rowData, cell, cellFormated) {
                                return '<span class="cell-edit icon-edit cell-' + rowData.CustId + '" onclick="customerList.editClick(' + rowData.CustId + ');"></span>';
                            }
                        },
                        { HeaderText: "@Las.Username", Width: 120, Name: "UserName", HeaderAlign: "center", Formatter:
                            function (rowIndex, rowData, cell, cellFormated) {
                                return '<a href="#">' + cell.Value + '</a>';
                            }
                        },
                        { HeaderText: "@Las.Status", Width: 100, Name: "Status", HeaderAlign: "center", CellAlign: "center", Formatter:
                            function (rowIndex, rowData, cell, cellFormated) {
                                return '<div class="cust-status make-switch" data-id=' + rowData.CustId + ' data-on-label="<i class=\'icon-open cust-status\'><p>Open</p></i>" data-off-label="<i class=\'icon-close cust-status\'><p>Closed</p></i>">' +
                                            '<input type="checkbox" ' + customerList.getStatus(cell.Value) + ' />' +
                                        '</div>';
                            }
                        },
                        { HeaderText: "@Las.FirstName", Width: 100, Name: "FirstName", HeaderAlign: "center" },
                        { HeaderText: "@Las.LastName", Width: 100, Name: "LastName", HeaderAlign: "center" },
                        { HeaderText: "@Las.Group", Width: 50, Name: "GroupName", HeaderAlign: "center", CellAlign: "center" },
                        { HeaderText: "@Las.CreatedDate", Width: 140, Name: "CreatedDate", HeaderAlign: "center", CellAlign: "center", FormatDateTime: CORE.DATE_FORMAT_FULL },
                        { HeaderText: "@Las.LoginIp", Width: 100, Name: "IpLogin", HeaderAlign: "center", Formatter:
                            function (rowIndex, rowData, cell, cellFormated) {
                                if (cell.Value == null)
                                    return '';
                                return '<span id="' + rowData.CustId + '" class="infos">' + cell.Value + '</span>';
                            }
                        }
                   ],
        showPager: true,
        customPager: true,
        allowTruncate: true,
        gridExpandHeight: 100,
        indexNumberColumn: 1,
        bodyRowHeight: 29
    };
</script>