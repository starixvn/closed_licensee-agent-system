<div ng-controller="NumberGamePositionTakingAdvancedModeController">
    <div ng-repeat="ptGroup in ptModel.ptGroups"
         class="pt-group-container" ng-style="ptGroup.WidthStyle">
        <div ng-class="{'pt-group-header expand': ptGroup.Expand, 'pt-group-header': true}">
            <span ng-click="positionTakingService.onCollapseExpand(ptGroup)" class="collapse-expand-button">
                {{ptGroup.Name}}</span>
        </div>
        <div class="pt-group-box">
            <div ng-repeat="pt in ptGroup.PositionTakings" class="pt-group" ng-show="ptGroup.Expand" ng-switch="settingContext.TargetRoleId">
                <number-game-licensee-edit-agent-one-pt-advanced-mode ng-switch-when="3"></number-game-licensee-edit-agent-one-pt-advanced-mode>
                @if (Model.FormId != FormType.ViewIndirectAgent)
                {
                    <number-game-agent-edit-agent-pt-advanced-mode ng-switch-when="2"></number-game-agent-edit-agent-pt-advanced-mode>
                }
                else
                {
                    <number-game-agent-edit-agent-pt-advanced-mode-read-only ng-switch-when="2" ng-show="settingContext.FormId == 2"></number-game-agent-edit-agent-pt-advanced-mode-read-only>
                }
                <number-game-agent-edit-member-pt-advanced-mode ng-switch-when="1"></number-game-agent-edit-member-pt-advanced-mode>
            </div>
        </div>
    </div>
</div>