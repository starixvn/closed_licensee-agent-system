@using LicenseeAgent.Core.Enumerations
@using LicenseeAgent.CustomerSetting.Entities;
@model SettingContext
@{
    Layout = null;
}
<div class="container-box box-bottom">
    @if (Model.TargetRoleId == (int)Role.AgentLevel1)
    {
        @InstructionHelper.Render(Las.Commission, "licensee-commission-info-button")
    }
    else if (Model.TargetRoleId == (int)Role.Agent)
    {
        @InstructionHelper.Render(Las.Commission, "agent-commission-info-button")
    }
    else
    {
        @InstructionHelper.Render(Las.Commission, "member-commission-info-button")
    }
    <div id="commission-current-scope" class="comm-setting" data-ng-controller="CommissionController">
        <div data-ng-show="settingContext.TargetRoleId ==1 ? true: false;">
            <commission-setting-agent-edit-member></commission-setting-agent-edit-member>
        </div>
        <div data-ng-show="settingContext.TargetRoleId !=1 ? true: false;" data-ng-repeat="commissionSetting in viewModel.commissionSettingsViewModel">
            @if (Model.FormId != FormType.ViewIndirectAgent)
            {
                <commission-setting-licensee-or-agent-edit-agent></commission-setting-licensee-or-agent-edit-agent>
            }
            else
            {
                <commission-setting-licensee-or-agent-edit-agent-read-only></commission-setting-licensee-or-agent-edit-agent-read-only>
            }
        </div>
        @if (Model.TargetRoleId != (int)Role.Member)
        {
            <div data-ng-class="{'comm-block-x1': hasOfferedNumberGame, 'comm-block-x2': !hasOfferedNumberGame}">
            </div>
        }
    </div>
</div>