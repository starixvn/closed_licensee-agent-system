@{
    ViewBag.Title = Las.Soccer + " - " + Las.TotalBets;
}
@using LicenseeAgent.TotalBets.Entities;
@using LicenseeAgent.TotalBets.ViewModels;
@model SoccerViewModel
@section css{
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/plugin")
    @Styles.Render("~/css/totalbets")
    @Styles.Render("~/css/betlist")
}
@section scripts{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/plugin")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/totalbets")
    <script type="text/javascript">
        $(function () {
            totalBets.soccer.init();
        });
    </script>
}
<div class="legend">
    @ViewBag.Title
    <span id="totalbets-back" onclick="totalBets.soccer.submitForm();" class="history-back hide"><i
        class="icon-history-back"></i>
        @Las.Back
    </span>
</div>
<div id="totalbets-filter" class="">
    @using (Html.BeginForm("Index", "Soccer", FormMethod.Post, new { @class = "form-inline form-filter ", id = "main-form" }))
    {
        <div class="controls-row">
            <div id="league-multi-select">
            </div>
        </div>
        <div class="controls-row">
            <div id="event-multi-select">
            </div>
        </div>
        <div class="controls-row">
            <button class="btn btn-primary" type="submit">
                @Las.Submit
            </button>
        </div>
        <div class="controls-row refresh-count-down-area">
            <div class="refresh-count-down" id="refresh-count-down">
            </div>
        </div>
        <input type="hidden" value="@Model.TimeInterval" id="server-time-interval" />
        @Html.HiddenFor(m => m.SelectedLeague)
        @Html.HiddenFor(m => m.CheckAllLeague)
        @Html.HiddenFor(m => m.SelectedEvent)
        @Html.HiddenFor(m => m.CheckAllEvent)
    }
</div>
<div id="BetListGrid" class="freegrid content-grid" data-url-ip="@Url.Action("GetIpInformation", "CustomerList")">
</div>