@{
	string trigger = ViewBag.Trigger;
	string title = ViewBag.Title;
	string tipTitle = ViewBag.TipTitle;
	
	if (!string.IsNullOrWhiteSpace(title))
	{
		title = string.Format("title='{0}'", title);
	}
	if (!string.IsNullOrWhiteSpace(tipTitle))
	{
		tipTitle = string.Format("tip-title='{0}'", tipTitle);
	}
	trigger = string.IsNullOrWhiteSpace(trigger) ? "page-info" : trigger + "-info";
}
	
<div id="@trigger" class="infos" style="display: none" @Html.Raw(title) @Html.Raw(tipTitle)>
	@RenderBody()
</div>