@using LicenseeAgent.Core.Enumerations
@using LicenseeAgent.Core.Utility
@using LicenseeAgent.Web.ViewModels
@using LicenseeAgent.Web.Entities
@using LicenseeAgent.CustomerSetting.ViewModels
@model CommissionGroupBaseViewModel
@{
    var pageContext = (PageContext)ViewBag.PageContext;
    
    ViewBag.Title = Las.CommissionGroup;
}
@section css{
    @Styles.Render("~/css/fanexgrid")
}
@section scripts{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/CommissionGroup")
    @Html.Partial("_CommissionGroupGrid", Model)
}
<div class="legend">
    @ViewBag.Title
</div>
<div class="controls-row">
    <button id="newGroup" class="btn btn-primary left-button">@Las.NewGroup</button>
    <a href="@Url.Action("Index", "MemberCommission")" class="btn btn-link">@Las.MemberCommission</a>
</div>

<div id="grid" class="freegrid">
</div>