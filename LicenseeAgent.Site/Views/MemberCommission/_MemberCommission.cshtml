<script type="text/javascript">
    var gridOptions = {
        customizeHeader: true,
        groupHeaderRows: [
            {
                Columns: [
                        { HeaderText: '<i class="icon-uncheck-all" onclick="memberCommission.checkAllItem(this);"></i>', Name: "CustId", MergeRowNumber: 2 },
                        { HeaderText: "#", Name: "No", MergeRowNumber: 2 },
                        { HeaderText: "@Las.SystemId", Name: "SystemId", MergeRowNumber: 2 },
                        { HeaderText: "@Las.Username", Name: "UserName", MergeRowNumber: 2 },
                        { HeaderText: "@Las.Group", Name: "GroupName", MergeRowNumber: 2 },
                        { HeaderText: "@Las.CommissionHeader", Name: "SBComm", MergeColNumber: @(Model.ProductCount) }
                    ]
            }
        ],
        columns: [
            {
                Width: 30, Name: "CustId", CellAlign: "center", MergeColNumber: 2, CanResize: false,
                Formatter: function (rowIndex, rowData, cell, cellFormated) {
                    return '<span class="cell-select icon icon-uncheck" onclick="memberCommission.selectClick(this);" data-cust-id="' + cell.Value + '"></span>';
                }
            },
            { HeaderText: "#", Name: "No", Width: 60, HeaderAlign: "center", CellAlign: "center", CanResize: false },
            { HeaderText: "@Las.SystemId", Width: 150, Name: "SystemId", HeaderAlign: "center", CanResize: false },
            { HeaderText: "@Las.Username", Width: 150, Name: "UserName", HeaderAlign: "center" },
            { HeaderText: "@Las.Group", Width: 100, Name: "GroupName", HeaderAlign: "center",
                Formatter: function (rowIndex, rowData, cell, cellFormated) {
                    return '<span class="group-comm">' + cell.Value + '</span>';
                } 
            },
            { HeaderText: "@Las.SB", Width: 50, Name: "SBComm", HeaderAlign: "center", CellAlign: "center",
                Formatter: function (rowIndex, rowData, cell, cellFormated) {
                    return '<span class="sb-comm">' + core.formatCommissionPercent(cell.Value) + '</span>';
                }
            }
            @if (Model.HasRacing)
            {
                <text>
                ,{ HeaderText: "@Las.Racing", Width: 50, Name: "RacingComm", HeaderAlign: "center", CellAlign: "center",
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return '<span class="racing-comm">' + core.formatCommissionPercent(cell.Value) + '</span>';
                    }
                }
                </text>
            }
            @if (Model.HasNumberGame)
            {
                <text>
                ,{ HeaderText: "@Las.NG", Width: 50, Name: "NGComm", HeaderAlign: "center", CellAlign: "center",
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return '<span class="ng-comm">' + core.formatCommissionPercent(cell.Value) + '</span>';
                    }
                }
                </text>
            }
            @if (Model.HasLiveCasino)
            {
                <text>
                ,{ HeaderText: "@Las.LC", Width: 50, Name: "LCComm", HeaderAlign: "center", CellAlign: "center",
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return '<span class="lc-comm">' + core.formatCommissionPercent(cell.Value) + '</span>';
                    }
                }
                </text>
            }
            @if (Model.HasRNGCasino)
            {
                <text>
                ,{ HeaderText: "@Las.CS", Width: 50, Name: "RNGComm", HeaderAlign: "center", CellAlign: "center",
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return '<span class="rng-comm">' + core.formatCommissionPercent(cell.Value) + '</span>';
                    }
                }
                </text>
            }
        ],
        showPager: true,
        customPager: true,
        gridExpandHeight: 125,
        indexNumberColumn: 1,
        bodyRowHeight: 29,
        autoResizeColumn: true
    };
</script>