@{
    ViewBag.Title = Las.AgentOutstanding + " - " + Las.Report;
}
@section css
{
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/betlist")
    @Styles.Render("~/css/outstandingreport")
}
@section scripts
{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/outstandingreport")
}
<div class="legend">
    @ViewBag.Title
</div>
<input type="hidden" id="loginAgent" data-id="@ViewBag.LoggedInAgentId" data-name="@ViewBag.LoggedInAgentName"/>
<div class="clearfix"><ul class="breadcrumb"></ul></div>
<div id="BetListGrid" class="freegrid content-grid" data-url-ip="@Url.Action("GetIpInformation", "CustomerList")">
</div>