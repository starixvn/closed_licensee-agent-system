@using LicenseeAgent.Customer.ViewModels
@model IpInformationViewModel
@{
    Layout = null;
}
<table class="ip-information">
    <tr>
        <td>@Las.Ip
        </td>
        <td>@Model.IpAddress
        </td>
    </tr>
    <tr>
        <td>@Las.Country
        </td>
        <td>@Model.Country
        </td>
    </tr>
    <tr>
        <td>@Las.City
        </td>
        <td>@Model.City
        </td>
    </tr>
    <tr>
        <td colspan="2">
            @Html.Raw(string.Format(Las.IpContent, Model.IpAddress))
        </td>
    </tr>
</table>