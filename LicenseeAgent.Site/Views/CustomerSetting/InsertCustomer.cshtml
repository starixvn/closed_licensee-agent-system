@using LicenseeAgent.Core.Enumerations;
@using LicenseeAgent.CustomerSetting.Entities.Sportsbook;
@model SettingContext
@{
    var currentSession = SessionManager.CurrentSession;
    if (Model.TargetRoleId == (int)Role.Member)
    {
        ViewBag.Title = Las.AddNewMember;
    }
    else
    {
        ViewBag.Title = Las.AddNewAgent;
    }
}
@section css
{
    @Styles.Render("~/css/customersetting/sportsbook")
}
@section scripts
{
    <script type="text/javascript" src=@Url.Content("~/CustomerSetting/GetSettingForInsert?custId=" + Model.CustId + "&roleId=" + Model.RoleId + "&targetCustId=" + Model.TargetCustId + "&targetRoleId=" + Model.TargetRoleId)></script>
    @Scripts.Render("~/js/angular")
    @Scripts.Render("~/js/autonumeric")
    @Scripts.Render("~/js/customersetting")
    @Scripts.Render("~/js/customersetting/sportsbook")
}
<div class="legend">
    @ViewBag.Title
</div>
<div id="custSetting" style="display: none" data-ng-app="fanex.sportsbookSetting"
    class="fanex-sportbook-setting" ng-controller="sportsbook.custSettingController"
    data-href="~/CustomerSetting/InsertCustomer">
    <div class="clearfix">
        <div class="messages" data-ng-show="Messages != null && Messages.length > 0">
            <p data-ng-repeat="message in Messages" data-ng-class="{'success': message.ErrCode == 0, 'error' : message.ErrCode != 0}">
                <i data-ng-class="{'icon-message-success': message.ErrCode == 0, 'icon-message-error' : message.ErrCode != 0}">
                </i>{{message.ErrMsg}}
            </p>
        </div>
    </div>
    <div class="clearfix">
        <div class="control-group" data-ng-hide="settingMode">
            <button class="btn btn-primary" data-ng-click="insertCustomer($event)">
                <i class="icon-button-plus"></i>@Las.Add
            </button>
        </div>
    </div>
    <div class="clearfix">
        @Html.Partial("~/Views/CustomerSetting/Sportsbook/CustomerInfo.cshtml")
    </div>
    <div class="clearfix">
        @Html.Partial("~/Views/CustomerSetting/Sportsbook/Commission.cshtml", Model)
    </div>
    <div class="clearfix">
        <div class="container-mode">
            <span class="mode-text">@Las.AdvancedMode</span>
            <div class="make-switch switch-small" id="modeSwitcher">
                <input type="checkbox" />
            </div>
        </div>
    </div>
    <div class="clearfix">
        <div class="edit-setting-warning" data-ng-show="settingMode">
            @Las.SimpleModeNote
        </div>
    </div>
    <div class="clearfix">
        @Html.Partial("~/Views/CustomerSetting/Sportsbook/BetSetting.cshtml", Model)
    </div>
    <div class="clearfix">
        @Html.Partial("~/Views/CustomerSetting/Sportsbook/PositionTaking.cshtml", Model)
    </div>
    <div class="clearfix">
        <div class="control-group" data-ng-show="settingMode">
        </div>
        <div class="control-group">
            <button class="btn btn-primary" ng-click="insertCustomer($event)">
                <i class="icon-button-plus"></i>@Las.Add
            </button>
        </div>
    </div>
</div>
@if (Model.TargetRoleId == (int)Role.AgentLevel1)
{
    @Html.Action("Index", "Instruction", new
    {
        key = "LicenseeCommissionSetting",
        trigger = "licensee-commission-info-button",
        title = Las.CommissionSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })

    @Html.Action("Index", "Instruction", new
    {
        key = "LicenseeBetSetting",
        trigger = "licensee-bet-limit-info-button",
        title = Las.BetSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })
    @Html.Action("Index", "Instruction", new
    {
        key = "LicenseeBetSettingAdv",
        trigger = "licensee-bet-limit-info-button-adv",
        title = Las.BetSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })

    @Html.Action("Index", "Instruction", new
    {
        key = "LicenseePositionTakingSetting",
        trigger = "licensee-position-taking-info-button",
        title = Las.PositionTakingSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })
    @Html.Action("Index", "Instruction", new
    {
        key = "LicenseePositionTakingSettingAdv",
        trigger = "licensee-position-taking-info-button-adv",
        title = Las.PositionTakingSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })
}
else if (Model.TargetRoleId == (int)Role.Agent)
{
    @Html.Action("Index", "Instruction", new
    {
        key = "AgentCommissionSetting",
        trigger = "agent-commission-info-button",
        title = Las.CommissionSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })

    @Html.Action("Index", "Instruction", new
    {
        key = "AgentBetSetting",
        trigger = "agent-bet-limit-info-button",
        title = Las.BetSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })
    @Html.Action("Index", "Instruction", new
    {
        key = "AgentBetSettingAdv",
        trigger = "agent-bet-limit-info-button-adv",
        title = Las.BetSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })

    @Html.Action("Index", "Instruction", new
    {
        key = "AgentPositionTakingSetting",
        trigger = "agent-position-taking-info-button",
        title = Las.PositionTakingSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })
    @Html.Action("Index", "Instruction", new
    {
        key = "AgentPositionTakingSettingAdv",
        trigger = "agent-position-taking-info-button-adv",
        title = Las.PositionTakingSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })
}
else
{
    @Html.Action("Index", "Instruction", new
    {
        key = "MemberCommissionSetting",
        trigger = "member-commission-info-button",
        title = Las.CommissionSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })

    @Html.Action("Index", "Instruction", new
    {
        key = "MemberBetSetting",
        trigger = "member-bet-limit-info-button",
        title = Las.BetSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })
    @Html.Action("Index", "Instruction", new
    {
        key = "MemberBetSettingAdv",
        trigger = "member-bet-limit-info-button-adv",
        title = Las.BetSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })

    @Html.Action("Index", "Instruction", new
    {
        key = "MemberPositionTakingSetting",
        trigger = "member-position-taking-info-button",
        title = Las.PositionTakingSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })
    @Html.Action("Index", "Instruction", new
    {
        key = "MemberPositionTakingSettingAdv",
        trigger = "member-position-taking-info-button-adv",
        title = Las.PositionTakingSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })
}