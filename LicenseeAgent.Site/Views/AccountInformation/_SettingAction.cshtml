@model SearchUserResultViewModel
@{
    var pageContext = (PageContext)ViewBag.PageContext;
    var isDirectDonwline = pageContext.IsDirectDownline.Value;
}
<div class="controls-row">
    <ul class="nav nav-tabs">
        <li><a href="#setting" id="tabSetting" data-toggle="tab">@Las.Setting</a></li>
        <li class="active"><a href="#action" id="tabAction" data-toggle="tab">@Las.Action</a></li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade" id="setting"></div>
        <div class="tab-pane active in" id="action">
            <div class="content">
                <ul class="nav nav-list">
                    <li>
                        <a href="@(pageContext.IsMember ? Url.Action("EditMember", "SportsbookSetting", new { memberId = Model.Customer.CustId }) : Url.Action("EditAgent", "SportsbookSetting", new { agentId = Model.Customer.CustId, agentLevel = Model.Customer.Level }))" target="frmMain">
                            <i class="icon-downline-arrow"></i>
                            @(isDirectDonwline || pageContext.IsMember ? Las.EditSportsbook : Las.ViewSportsbook)
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("ResetPassword", "Customer", Model.Customer)" target="frmMain">
                            <i class="icon-downline-arrow"></i>
                            @Las.ResetPassword
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>