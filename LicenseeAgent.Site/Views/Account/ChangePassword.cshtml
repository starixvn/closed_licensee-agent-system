@model AgentChangePasswordViewModel
@{
    ViewBag.Title = Las.ChangePassword;
}
<div class="legend">
    @ViewBag.Title
</div>
<div style="width: 378px">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-table" }))
    {
        @Html.ValidationSummary()
        <fieldset>
            @if (ViewBag.Result != null)
            {
                <p class="text-success">
                    @ViewBag.Result.ToString()
                </p>
            }
            @Html.AntiForgeryToken()
            <table>
                <colgroup>
                    <col width="150" />
                    <col width="228" />
                </colgroup>
                <tbody>
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.CurrentPassword)
                        </td>
                        <td>
                            @Html.PasswordFor(m => m.CurrentPassword)
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.NewPassword)
                        </td>
                        <td>
                            @Html.PasswordFor(m => m.NewPassword)
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.ConfirmPassword)
                        </td>
                        <td>
                            @Html.PasswordFor(m => m.ConfirmPassword)
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="button-group row-fluid">
                <button type="reset" class="btn btn-primary pull-right">
                    @Las.Reset
                </button>
                <button type="submit" class="btn btn-primary pull-right">
                    @Las.ChangePassword
                </button>
            </div>
            <div class="form-note">
                <span class="note-text">@Las.Note:</span>
                <br />
                @Html.Raw(Las.PasswordHint)
            </div>
        </fieldset>
    }
</div>
@section scripts{
    @if (ViewBag.Result != null)
    {
        <script type="text/javascript">
            if (window.parent) {
                //window.parent.location.reload();
            }
        </script>
    }
}