<script type="text/javascript">
    var footerRows = [
              {
                  Columns: [
                    { Value: "Total", Name: "RowNo", CellAlign: "center", MergeColNumber: 4 },
                    { Value: "GC", Name: "GivenCredit", MergeColNumber: 2, IsCalculated: true },
                    { Value: "BC", Name: "BetCredit", IsCalculated: true },
                    { Value: "YesterBalance", Name: "YesterdayBalance", IsCalculated: true },
                    { Value: "TB", Name: "TotalBalance", IsCalculated: true },
                    { Value: "O", Name: "Outstanding", IsCalculated: true }
                ]
              }
        ];
    var gridOptions = {
        columns: [
                        {
                            HeaderText: "#", Width: 30, Name: "RowNo", CellAlign: "center"
                        },
                        {
                            HeaderText: "@Las.Username", Width: 100, Name: "UserName", HeaderAlign: "center", CanResize: true, AllowTruncate: true, MaxResizeWidth: 200
                        },
                        {
                            HeaderText: "@Las.FullName", Width: 125, Name: "CustomerName", HeaderAlign: "center", CanResize: true, AllowTruncate: true, MaxResizeWidth: 300,
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                if ($.trim(rowData.CustomerName) == '') {
                                    rowData.CustomerName = '---';
                                }
                                return '{0}'.format(rowData.CustomerName);
                            }
                        },
                        {
                            HeaderText: "@Las.Status", Width: 55, Name: "Status", HeaderAlign: "center", CellAlign: "center",
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return rowData.Status == false
                                ? '<div class="account-status-open">' + language.getString('Open') + '</div>'
                                : '<div class="account-status-closed">' + language.getString('Closed') + '</div>';
                            }
                        },
                        {
                            HeaderText: "@Las.GivenCredit", Width: 80, Name: "GivenCredit", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", MergeHeaderColNumber: 2, CanResize: true,
                            CalResizeFunction: function (value) {
                                return value.toString().length * 10;
                            }
                        },
                        {
                            HeaderText: "", Width: 20, Name: "TransferIcon", CellAlign: "center",
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return '<i class="icon-edit-credit-balance" onclick="creditBalanceList.agentEditMemberCredit({0}, \'{1}\', {2})" title="{3}"></i>'.format(rowData.CustId, rowData.UserName, rowData.GivenCredit, '@Las.Edit');
                            }
                        },
                        {
                            HeaderText: "@Las.BetCredit", Width: 80, Name: "BetCredit", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", CanResize: true,
                            CalResizeFunction: function (value) {
                                return value.toString().length * 9;
                            }
                        },
                        {
                            HeaderText: "@Las.YesterdayBalance", Width: 80, Name: "YesterdayBalance", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', CanResize: true,
                            CalResizeFunction: function (value) {
                                return value.toString().length * 9;
                            }
                        },
                        {
                            HeaderText: "@Las.TotalBalance", Width: 80, Name: "TotalBalance", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', CanResize: true,
                            CalResizeFunction: function (value) {
                                return value.toString().length * 9;
                            }
                        },
                        {
                            HeaderText: "@Las.Outstanding", Width: 80, Name: "Outstanding", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', CanResize: true,
                            CalResizeFunction: function (value) {
                                return value.toString().length * 9;
                            }
                        }
                   ],
        showPager: true,
        gridExpandHeight: 125,
        bodyRowHeight: 29,
        showFooter: true,
        footerRows: footerRows,
        autoResizeColumn: true,
        allowTruncate: true
    };
</script>