@{
    ViewBag.Title = Las.PageTitle_ParlayTotalBets;
}
@section css
{
    @Styles.Render("~/css/monthpicker")
    @Styles.Render("~/css/betlist")
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/totalbets/parlay")
}
@section scripts
{
    @Scripts.Render("~/js/angular")
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/monthpicker")
    @Scripts.Render("~/js/totalbets/parlay")
    <script type="text/javascript">
        var _today = '@DateTime.Today.ToShortDateString()';
        var _minDate = '10/1/2013';
        var lastDay = '@DateTime.Now.Day';
        var lastMonth = '@DateTime.Now.Month';
        var lastYear = '@DateTime.Now.Year';
        var custId = '@ViewBag.CustId';
    </script>
}
<div class="legend">
    @ViewBag.Title
</div>
<div class="parlay-tabs">
    <span id="mixParlayTab">@Las.MixParlay</span><span class="separate"></span><span id="systemParlayTab">@Las.SystemParlay</span>
</div>
<div>
    <div class="gridWrapper">
        <div id="BetListGrid" class="freegrid content-grid" data-url-ip="@Url.Action("GetIpInformation", "CustomerList")">
        </div>
    </div>
</div>
<div id="instruction" class="instruction-content">
</div>
