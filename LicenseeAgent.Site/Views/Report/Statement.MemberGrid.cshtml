<script type="text/javascript">
    var gridOptions = {
        columns: [
                { HeaderText: "#", Width: 30, Name: "No", HeaderAlign: "center", CellAlign: "center", CanResize: false },
                { HeaderText: "@Las.Username", Width: 150, Name: "Username", HeaderAlign: "center", AllowTruncate: true, CellAlign: "left",
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return ("<a href='javascript:statementReport.ViewDetail({0}, \"{1}\");'>" + cell.Value + "</a>").format(rowData.CustId, cell.Value);
                    }
                },
                { HeaderText: "@Las.FullName", Width: 150, Name: "LastName", HeaderAlign: "center", CellAlign: "left", AllowTruncate: true, Formatter:
                    function (rowIndex, rowData, cell, cellFormated) {
                        return ((rowData.LastName == '' ? '--- ' : rowData.LastName) + (rowData.FirstName == '' ? '---' : rowData.FirstName));
                    }
                },
                { HeaderText: "@Las.OpeningBalance", Width: 100, Name: "OpeningBalance", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$' },
                { HeaderText: "@Las.Turnover", Width: 100, Name: "Turnover", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$' },
                { HeaderText: "@Las.Betting", Width: 100, Name: "Betting", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$' },
                { HeaderText: "@Las.Outstanding", Width: 100, Name: "Outstanding", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$' },
                { HeaderText: "@Las.Commission", Width: 100, Name: "Commission", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', ThClass: 'alter-column' },
                { HeaderText: "@Las.TransferAmt", Width: 100, Name: "TransferAmt", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', ThClass: 'alter-column',
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return ("<a class='num-link' href='javascript:statementReport.TransferDetail({0}, \"{1}\");'>" + cellFormated + "</a>").format(rowData.CustId, rowData.Username);
                    }
                },
                { HeaderText: "@Las.ClosingBalance", Width: 100, Name: "ClosingBalance", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$' }

            ],
        gridExpandHeight: 125,
        showNumberColumn: true,
        showPager: true,
        //bodyRowHeight: 26,
        autoResizeColumn: true
    };
</script>