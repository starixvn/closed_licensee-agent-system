@using LicenseeAgent.Core.Enumerations
@using LicenseeAgent.Web.ViewModels
@using LicenseeAgent.Web.Filters
@model HomeViewModel
@if (SessionManager.CurrentSession.AgentInfo != null)
{
    <ul class="nav nav-pills">
        @if (!Model.IsAgentChangePassword)
        {
            @BootstrapHelper.TopMenu(Las.Home, Url.Action("Index", "HomePage", new { area = "Account" }), "menuHome", Model.TopMenu == TopMenu.Home)
            if (LegendTypeAttribute.Authorize(LegendType.Credit))
            {
            @BootstrapHelper.TopMenu(Las.Transfer, Url.Action("Index", "Transfer"), "menuTransfer", Model.TopMenu == TopMenu.Transfer)
            }
        }
        @if (SessionManager.CurrentSession.IsViewChangePassword())
        {
            @BootstrapHelper.TopMenu(Las.Security, Url.Action("ChangePassword", "Account"), "menuSecurity", Model.TopMenu == TopMenu.Security)
        }
    </ul>
}
@if (SessionManager.CurrentSession.IsViewSelectMenu())
{
    @Html.Action("SelectMenu", "TopMenu", new { area = "Home" })
}