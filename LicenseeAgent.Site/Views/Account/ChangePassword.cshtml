@model AgentChangePasswordViewModel
@{
    ViewBag.Title = Las.ChangePassword;
}
<div class="legend">
    @Las.ChangePassword
</div>
<div class="pull-left">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-table" }))
    {
        @Html.ValidationSummary()
        <fieldset>
            @if (ViewBag.Result != null)
            {
                <p class="text-success">
                    @ViewBag.Result.ToString()
                </p>
            }
            @Html.AntiForgeryToken()
            <table>
                <tbody>
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.CurrentPassword)
                        </td>
                        <td>
                            @Html.PasswordFor(m => m.CurrentPassword)
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.NewPassword)
                        </td>
                        <td>
                            @Html.PasswordFor(m => m.NewPassword)
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.ConfirmPassword)
                        </td>
                        <td>
                            @Html.PasswordFor(m => m.ConfirmPassword)
                        </td>
                    </tr>
                    <tr>
                        <td>
                        </td>
                        <td>
                            <button type="submit" class="btn btn-primary">
                                @Las.ChangePassword
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </fieldset>
    }
</div>