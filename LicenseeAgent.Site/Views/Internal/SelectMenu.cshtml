@using LicenseeAgent.Core.Enumerations
@using LicenseeAgent.Account.ViewModels;
@model LicenseeViewModel
@using (Html.BeginForm("LoginAsUser", "Internal", FormMethod.Post, new { id = "internal-form", name = "internal-form" }))
{
    <div class="select-box">
        @if (SessionManager.CurrentSession.AdminInfo != null)
        {
            <div class="pull-left item" id="licensee" data-licensee-id="@Model.LicenseeId" data-href="~/Internal/GetCurrencies">
                <span>@(string.IsNullOrEmpty(Model.LicenseeName) ? Las.ChooseLicensee : Model.LicenseeName)</span>
                <i class="icon-licensee-arrow"></i>
                <ul class="drop-box">
                    @foreach (var licensee in Model.Licensees)
                    {
                        <li><a href="javascript:void(0);" data-id="@licensee.LicenseeId">@licensee.LicenseeName</a></li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="hide" id="licensee" data-licensee-id="@Model.LicenseeId">
            </div>
        }
        <div class="pull-left item" id="currency" data-currency-id="@Model.CurrencyId">
            <span>@(Model.CurrencyId != 0 ? Model.CurrencyName : Las.ChooseCurrency)</span>
            <i class="icon-licensee-arrow"></i>
            @if (Model.Currencies != null)
            {
                <ul class="drop-box">
                    @foreach (var currency in Model.Currencies)
                    {
                        <li><a href="#" data-id="@currency.Currency">@currency.CurrencyName</a></li>
                    }
                </ul>
            }
        </div>
        <div class="pull-left item">
            @Html.TextBox("agentName", string.Empty, new { @placeholder = Las.Username })
        </div>
        <div class="pull-left item">
            <a id="submit" onclick="INTERNAL_HEADER.submit();" class="icon-licensee-searchagent">
            </a>
        </div>
    </div>
}
@Html.Hidden("defaultCurrency", Las.ChooseCurrency)
@Html.Hidden("is-selected", SessionManager.CurrentSession.AgentInfo != null ? true : false)