@using LicenseeAgent.CustomerList.ViewModels
@model IpInformationViewModel
@{
    Layout = null;
}

<table>
    <tr>
        <td class="col-left">@Las.Ip</td>
        <td class="col-right" id="instip">@Model.IpAddress</td>
    </tr>
    <tr>
        <td class="col-left">@Las.Country</td>
        <td class="col-right" id="instcountry">@Model.Country</td>
    </tr>
    <tr>
        <td class="col-left">@Las.City</td>
        <td class="col-right" id="instcity">@Model.City</td>
    </tr>
    <tr>
        <td colspan="2" id="instcontent">
            @string.Format(Las.IpContent,Model.IpAddress)
        </td>
    </tr>
</table>