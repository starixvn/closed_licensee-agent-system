@model SearchUserResultViewModel
<div class="controls-row">
    <ul class="nav nav-tabs">
        <li><a href="#balance" id="tabBalance" data-toggle="tab">@Las.BalanceInfo</a></li>
        <li class="active"><a href="#downlineList" id="tabDownline" data-toggle="tab">@Las.DownlineList</a></li>
    </ul>

    <div class="tab-content tab-small">
        <div class="tab-pane fade" id="balance"></div>
        <div class="tab-pane active in" id="downlineList">
            @if (Model.Downlines.Any())
            {
                <div id="downlineContent" class="content">
                    <ul class="nav nav-pills">
                        @foreach (var donwline in Model.Downlines)
                        {
                            <li><a class="agent-inline" href="#" data-id="@donwline.DownlineCustId">@donwline.UserName</a></li>    
                        }
                    </ul>
                </div>
                <div id="paging" data-total-pages="@Model.TotalPages" data-page-index="@Model.PageIndex"></div>
            }
            else
            {
                <div class="no-info">@LangMsg.Msg_1032</div>
            }
        </div>
    </div>
</div>