@{
    Layout = null;
}
<table class='fanex-result'>
    <thead>
        <tr class='row-header'>
            <th class='column-kickofftime'>
                @Las.KickOffTime
            </th>
            <th class='column-match'>
                @Las.Match
            </th>
            <th class='column-firsthaftscore'>
                @Las.FirstHalfScore
            </th>
            <th class='column-finalscore'>
                @Las.FinalScore
            </th>
            <th class='column-status'>
                @Las.Status
            </th>
        </tr>
    </thead>
    <tbody>
        <tr class='row-noinfo'>
            <td colspan='5'>
                @Las.NoData
            </td>
        </tr>
    </tbody>
</table>