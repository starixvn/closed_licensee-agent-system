<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    </configSections>
  <appSettings>
    <add key="IsAdminSite" value="1" />
    <add key="Environment" value="UAT" />
    <add key="RemoteRefURL" value="tcp://10.18.200.209:8888/CallGetRefFunction" />
    <add key="UnderMaintenanceUrl" value="" />
    <add key="LocalTest" value="1" />
    <add key="LocalLicenseeId" value="27" />
    <add key="IsDownTime" value="0" />
    <add key="DownTime" value="10:00AM - 13:00PM" />
    <add key="TaiwanAPI" value="http://lastest.net2cast.com/API" />
    <add key="TrustedAdmins" value="*" />
    <add key="OfferedProducts" value="*" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
<Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="$resourcePath_Value" enableWatching="1" />
        </providers>
    </Fanex.Data.DbSettingProvider></configuration>