@using LicenseeAgent.CustomerList.ViewModels
@model EditInfoViewModel
@{
    ViewBag.Title = Las.EditInfo;
}
@section scripts{
    @if (ViewBag.Result != null)
    {
        <script type="text/javascript">
            $(function () {
                POPUP.close();
                if (window.parent.customerList)
                    window.parent.customerList.reRenderAfterPaged();
            });
        </script>
    }
}
<div class="legend">
    @ViewBag.Title
</div>
<div style="width: 388px">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-horizontal small-form" }))
    {
        @Html.ValidationSummary()
        <fieldset>
            @if (ViewBag.Result != null)
            {
                <p class="text-success">
                    @ViewBag.Result.ToString()
                </p>
            }
            @Html.AntiForgeryToken()
            <div class="control-group">
                @Html.LabelFor(m => m.UserName, new { @class = "control-label" })
                <div class="controls">
                    <strong>@Model.UserName</strong>
                </div>
            </div>
            
            <div class="control-group">
                @Html.LabelFor(m => m.FirstName, new { @class = "control-label" })
                <div class="controls">
                    @Html.TextBoxFor(m => m.FirstName)
                </div>
            </div>
            
            <div class="control-group">
                @Html.LabelFor(m => m.LastName, new { @class = "control-label" })
                <div class="controls">
                    @Html.TextBoxFor(m => m.LastName)
                </div>
            </div>
            
            <div class="control-group">
                @Html.LabelFor(m => m.Phone, new { @class = "control-label" })
                <div class="controls">
                    @Html.TextBoxFor(m => m.Phone)
                </div>
            </div>
            
            <div class="control-group">
                @Html.LabelFor(m => m.Mobile, new { @class = "control-label" })
                <div class="controls">
                    @Html.TextBoxFor(m => m.Mobile)
                </div>
            </div>
            
            <div class="control-group">
                @Html.LabelFor(m => m.Fax, new { @class = "control-label" })
                <div class="controls">
                    @Html.TextBoxFor(m => m.Fax)
                </div>
            </div>

            <div class="control-group">
                <div class="controls">
                    <button type="reset" class="btn btn-primary">
                        @Las.Reset
                    </button>
                    <button type="submit" class="btn btn-primary">
                        @Las.Update
                    </button>
                </div>
            </div>
        </fieldset>
        @Html.HiddenFor(m => m.CustId)
        @Html.HiddenFor(m => m.UserName)
    }
</div>