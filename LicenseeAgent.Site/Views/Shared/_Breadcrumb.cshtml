@using LicenseeAgent.Web.ViewModels
@using LicenseeAgent.Web.Entities
@model AgentBreadcrumbViewModel
@{
    var isShowBreadcrumb = !SessionManager.CurrentSession.AgentInfo.IsLastLevel
            && Model.Breadcrumb != null 
            && Model.Breadcrumb.Count > 1;
    var pageContext = (PageContext)ViewBag.PageContext;
    if (pageContext != null && pageContext.IsMember)
    {
        isShowBreadcrumb = false; 
    }
}
@if (isShowBreadcrumb)
{
    <div class="clearfix">
        <ul class="breadcrumb">
            @foreach (var item in Model.Breadcrumb)
            {
                <li>
                    @if (item.AgentLevel != Model.AgentLevel)
                    {
                        <a href="#" data-agent-id="@item.AgentId" data-agent-level="@item.AgentLevel">@item.AgentName</a>
                        <span class="divider">>></span>
                    }
                    else
                    {
                        <span>@item.AgentName</span>
                    }
                </li>
            }
        </ul>
    </div>
}