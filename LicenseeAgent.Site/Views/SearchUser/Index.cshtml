@model SearchUserViewModel
@{
    Layout = null;
}
@using (Html.BeginForm("Search", "SearchUser", FormMethod.Post, new { @id="formSearch", @class = "form-search form-inline" }))
{
    <div class="input-append">
        @Html.TextBoxFor(m => m.UserName, new { @placeholder = Las.Username, @class = "input-medium", @maxlength = 50, @autocomplete = "off" })
        <span id="search" class="add-on">
            <i class="icon-search"></i>
        </span>
    </div>
}
<div id="searchUrl" data-suggest="@Url.Action("Suggest", "SearchUser")" data-downline="@Url.Action("GetDownlines", "SearchUser")"
                    data-currency="@Url.Action("LoginAsUser", "Internal")">
</div>
<div id="searchResult"></div>
<div id="dialog-confirm" title="">
    <p></p>
</div>