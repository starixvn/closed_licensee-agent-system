@using LicenseeAgent.Core.Utility
@using LicenseeAgent.CreditBalance.ViewModels
@model EditAgentViewModel
@{
    ViewBag.Title = Las.UpdateCredit;
}
<div class="legend">
    @ViewBag.Title
</div>
<div class="pull-left">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-table" }))
    {
        @Html.ValidationSummary()
        <fieldset>
            @if (ViewBag.Result != null)
            {
                <p class="text-success">
                    @ViewBag.Result.ToString()
                </p>
                <script type="text/javascript">
                    POPUP.trigger('edit-agent-credit');
                </script>
            }
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.AgentId)
            @Html.HiddenFor(m => m.MinCreditOutput)
            @Html.HiddenFor(m => m.MaxCreditOutput)
            <table class="no-wrap">
                <colgroup>
                    <col width="150" />
                    <col width="250" />
                </colgroup>
                <tbody>
                    <tr>
                        <td>
                            @Las.Username
                        </td>
                        <td>
                            @Model.AgentName
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @Las.Credit
                        </td>
                        <td>
                            @if (!Model.MaxCreditOutput.HasValue)
                            {
                                @Html.TextBoxFor(m => m.GivenCredit, new { @class = "w160", data_min = Model.MinCreditOutput, title = Las.InvalidAmount, maxlength = 15 })
                                <span>@string.Format(">= {0}", Formatter.FormatDecimal4(Model.MinCreditOutput))</span>
                            }
                            else
                            {
                                @Html.TextBoxFor(m => m.GivenCredit, new { @class = "w160", data_min = Model.MinCreditOutput, data_max = Model.MaxCreditOutput, title = Las.InvalidAmount, maxlength = 15 })
                                <span>@string.Format("[{0} - {1}]", Formatter.FormatDecimal4(Model.MinCreditOutput), Formatter.FormatDecimal4(Model.MaxCreditOutput))</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="button-group row-fluid">
                <button type="button" class="btn btn-primary pull-right" onclick="POPUP.close();">
                    @Las.Cancel
                </button>
                <button type="submit" class="btn btn-primary pull-right">
                    @Las.Update
                </button>
            </div>
        </fieldset>
    }
</div>
@section scripts
{
    @Scripts.Render("~/js/autonumeric")
    @Scripts.Render("~/js/credit-balance")
    <script type="text/javascript">
        CREDIT_BALANCE_POPUP.init();
    </script>
}