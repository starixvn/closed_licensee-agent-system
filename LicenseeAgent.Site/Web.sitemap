<?xml version="1.0" encoding="utf-8" ?>
<siteMap xmlns="http://schemas.microsoft.com/AspNet/SiteMap-File-1.0" >
    <siteMapNode title="AGE">

        <!--Totalbets-->
        <siteMapNode title="totalbets" active="true">
            <siteMapNode title="lblHOUL" url="totalBets/handicap"></siteMapNode>
            <siteMapNode title="moneyline" url="totalBets/moneyline"></siteMapNode>
            <siteMapNode title="OE1x2DND" url="totalBets/oddeven"></siteMapNode>
            <siteMapNode title="correctscore" url="_betList/BetList.aspx?type=CorrectScore"></siteMapNode>
            <siteMapNode title="totalgoal" url="totalBets/totalgoal"></siteMapNode>
            <siteMapNode title="lblMixParlay" url="_betList/BetList.aspx?type=MixParlay"></siteMapNode>
            <siteMapNode title="lblSystemParlay" url="_betList/BetList.aspx?type=CombMixParlayBetList"></siteMapNode>
            <siteMapNode title="lblOutRight" url="totalBets/outright"></siteMapNode>
            <siteMapNode title="htft" url="totalBets/htft"></siteMapNode>
            <siteMapNode title="fglg" url="totalBets/firstgoal"></siteMapNode>
            <siteMapNode title="bettype13" url="_betList/BetList.aspx?bettype=13&amp;type=Bettype"></siteMapNode>
            <siteMapNode title="bettype24" url="_betList/BetList.aspx?bettype=24&amp;type=Bettype"></siteMapNode>
            <siteMapNode title="lblHomeDrawAwayNoBet" url="totalBets/homenobet"></siteMapNode>
            <siteMapNode title="bettype26" url="_betList/BetList.aspx?bettype=26&amp;type=Bettype"></siteMapNode>
            <siteMapNode title="bettype27" url="_betList/BetList.aspx?bettype=27&amp;type=Bettype"></siteMapNode>
            <siteMapNode title="bettype28" url="_betList/BetList.aspx?bettype=28&amp;type=Bettype"></siteMapNode>
        </siteMapNode>
        <!--/Totalbets-->

        <!--Forecast-->
        <siteMapNode title="lblForecast">
            <siteMapNode title="lblHOUL" url="forecast/fchandicapoverunder"></siteMapNode>
            <siteMapNode title="lbl1x2" url="forecast/fc1x2"></siteMapNode>
            <siteMapNode description="ScoreMap" title="lblScoreMap" url="forecast/scoremap"></siteMapNode>
        </siteMapNode>
        <!--/Forecast-->

        <!--Report-->
        <siteMapNode title="reports">
            <siteMapNode title="agentwinloss" url="reports/matchentered"></siteMapNode>
            <siteMapNode title="lblAgentOutstanding" url="reports/outstanding"></siteMapNode>
            <siteMapNode title="TicketCancelled" url="_betList/BetListTransaction.aspx?type=cancel"></siteMapNode>
            <siteMapNode title="transaction" url="_betList/BetListTransaction.aspx?type=transaction"></siteMapNode>
        </siteMapNode>
        <!--/Report-->

        <!--Results-->
        <siteMapNode title="result">
            <siteMapNode title="lblMatchResult" url="results/match"></siteMapNode>
            <siteMapNode title="lblOutrightResult" url="results/outright"></siteMapNode>
        </siteMapNode>
        <!--/Results-->

        <!--MemberInfo-->
        <siteMapNode title="lblAccountInformation">
            <siteMapNode title="lblAgentList" url="account/agentList"></siteMapNode>
            <siteMapNode title="lblPlayerList" url="account/memberlist" isAgentOnly="true"></siteMapNode>
            <siteMapNode title="lblViewAllSetting" url="customersetting/mysetting" isNotForSuper="true" ></siteMapNode>
            <siteMapNode title="ViewShare" url="customerSetting/agentshare" ></siteMapNode>
            <siteMapNode title="ViewCommission" url="customersetting/viewcommission" ></siteMapNode>
            <siteMapNode title="loginlog" url="account/loglogin" isInternalOnly="true"></siteMapNode>
            <siteMapNode title="CustomerSettingLog" url="log/viewlog"></siteMapNode>
        </siteMapNode>
        <!--/MemberInfo-->

    </siteMapNode>
</siteMap>