@using LicenseeAgent.Core.Utils
@model HomePageViewModel
<div class="box-cell w-40">
    <table class="table">
        <thead>
            <tr>
                <th>@Las.YourStatisticTitle</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="title-border">@Las.AgentOutstanding</td>
                <td class="text-right title-border">@Formatter.FormatDecimal(Model.StatisticInfo.OutStanding)</td>
            </tr>
            <tr>
                <td>@Las.TotalOutstanding</td>
                <td class="text-right">@Formatter.FormatDecimal(Model.StatisticInfo.TotalOutStading)</td>
            </tr>            
            <tr>
                <td>@Las.TopWinningMembers
                    <div class="dropdown-button expand" id="top-winning"></div>
                    <div class="dropdown-popup" id="top-winning-content" style="display: none;"></div>
                </td>
                <td class="text-right"></td>
            </tr>
            <tr>
                <td>@Las.TopTurnoverMembers
                    <div class="dropdown-button expand" id="top-turnover"></div>
                    <div class="dropdown-popup" id="top-turnover-content" style="display: none;"></div>
                </td>
                <td class="text-right"></td>
            </tr>
            <tr>
                <td>@Las.NewMemberOfMonth: <span class="new-members">@Formatter.FormatInt(Model.StatisticInfo.NumberOfNewMember)</span>
                    <div class="dropdown-button expand" id="new-members"></div>
                    <div class="dropdown-popup" id="new-members-content" style="display: none;"></div>
                </td>
                <td class="text-right"></td>
            </tr>                                        
        </tbody>
    </table>
</div>
