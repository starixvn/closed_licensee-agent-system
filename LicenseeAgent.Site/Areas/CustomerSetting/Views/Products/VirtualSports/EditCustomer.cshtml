@using LicenseeAgent.Core.Enumerations;
@using LicenseeAgent.CustomerSetting.Entities;
@model SettingContext
@{
    if (Model.TargetRoleId == (int)Role.Member)
    {
        ViewBag.Title = Las.EditVirtualSportsMember;
    }
    else
    {
        ViewBag.Title = Model.FormId == FormType.ViewIndirectAgent ? Las.ViewVirtualSportsAgent : Las.EditVirtualSportsAgent;
    }

    var scriptUrl = Url.RouteUrl("CustomerSetting_Product", new
    {
        controller = "Product",
        action = "GetSetting",
        productId = (int)Product.Product_5,
        custId = Model.CustId,
        roleId = Model.RoleId,
        targetCustId = Model.TargetCustId,
        targetRoleId = Model.TargetRoleId,
        formId = (int)Model.FormId
    });
}
@section css
{
    @Styles.Render("~/css/customersetting")
}
@section scripts
{
    <script type="text/javascript" src="@scriptUrl"></script>
    @Scripts.Render("~/js/angular")
    @Scripts.Render("~/js/autonumeric")
    @Scripts.Render("~/js/customersetting")
    @Scripts.Render("~/js/customersetting/virtualsports")
}
@RazorHelper.Legend(ViewBag.Title)
<div id="custSetting" style="display: none" data-ng-app="fanex.customerSetting"
    class="fanex-customer-setting fanex-virtual-sports-setting" data-ng-controller="CustomerSettingController"
    data-href="@("~/CustomerSetting/VirtualSports/UpdateCustomer")" data-updated-href="@("~/CustomerSetting/VirtualSports/GetUpdatedSetting")" data-product="@((int)Product.Product_5)">
    <div class="clearfix">
        <div class="messages" data-ng-show="Messages != null && Messages.length > 0">
            <p data-ng-repeat="message in Messages" data-ng-class="{'success': message.ErrCode == result.Success, 'warning': message.ErrCode == result.NoChange, 'error' : message.ErrCode != result.Success && message.ErrCode != result.NoChange}">
                <i data-ng-class="{'icon-message-success': message.ErrCode == result.Success, 'icon-message-warning': message.ErrCode == result.NoChange, 'icon-message-error' : message.ErrCode != result.Success && message.ErrCode != result.NoChange}">
                </i>{{message.ErrMsg}}
            </p>
        </div>
    </div>
    <div class="clearfix">
        @if (Model.FormId != FormType.ViewIndirectAgent)
        {
            <div class="control-group" data-ng-hide="settingMode">
                <button class="btn btn-primary" data-ng-click="updateCustomer($event)">
                    @(Model.IsDeposit ? Las.UpdateAll : Las.Update)
                </button>
            </div>
        }
    </div>
    <div class="clearfix customerinfo-box">
        @Html.Partial("~/Areas/CustomerSetting/Views/Products/ViewCustomerInfo.cshtml")
    </div>
    <div class="clearfix" data-ng-if="false">
        <div class="container-mode">
            <span class="mode-text">@Las.AdvancedMode</span>
            <div class="make-switch switch-small" id="modeSwitcher">
                <input type="checkbox" />
            </div>
        </div>
    </div>
    <div data-ng-class="{'clearfix': true, 'product-group': settingMode}">
        <div class="product-container">
            <div class="clearfix">
                <div class="edit-setting-warning" data-ng-show="settingMode">
                    @Las.VirtualSportsSimpleModeNote
                </div>
            </div>
            @if (Model.FormId != FormType.EditIndirectMember)
            {
                <div class="clearfix">
                    @Html.Partial("~/Areas/CustomerSetting/Views/Products/VirtualSports/BetSetting.cshtml", Model)
                </div>
            }
            <div class="clearfix">
                @Html.Partial("~/Areas/CustomerSetting/Views/Products/VirtualSports/PositionTaking.cshtml", Model)
            </div>
        </div>
        <div class="clearfix">
            @if (Model.FormId != FormType.ViewIndirectAgent)
            {
                <div class="control-group">
                    <button class="btn btn-primary" data-ng-click="updateCustomer($event)">
                       @(Model.IsDeposit ? Las.UpdateAll : Las.Update)
                    </button>
                </div>
            }
        </div>
    </div>
</div>
@if (Model.TargetRoleId == (int)Role.AgentLevel1)
{
    @Html.Action("Index", "Instruction", new
    {
        area = "",
        key = "LicenseeBetSettingVirtualSports",
        trigger = "licensee-bet-limit-info-button",
        title = Las.BetSettingInstructions,
        tipTitle = Las.ClickToViewInstructions
    })
    @Html.Action("Index", "Instruction", new
    {
        area = "",
        key = "LicenseeBetSettingVirtualSportsAdv",
        trigger = "licensee-bet-limit-info-button-adv",
        title = Las.BetSettingInstructions,
