@model LicenseeAgent.Report.ViewModels.ResultsReportViewModel
@{
    ViewBag.Title = Las.PageTitle_Report_Results;
}
@section css
{
    @Styles.Render("~/css/datetimepicker")
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/resultsreport")
}
@section scripts
{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/datetimepicker")
    @Scripts.Render("~/js/resultsreport")
}
<div class="legend">
    @ViewBag.Title
</div>
@using (Html.BeginForm("Results", "Report", FormMethod.Post,
    new { @class = "form-inline ", id = "search-form" }))
{
    <div id="filter-tabs" class="form-filter">
        <ul id="tabs-area" class="nav nav-tabs">
            <li class="tab-match"><a href="#filter-tab-match">@Las.MatchResults</a></li>
            <li class="tab-outright"><a href="#filter-tab-outright">@Las.OutrightResults</a></li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane" id="filter-tab-match">
                <div class="controls-row">
                    <span>@Las.Date</span>
                    <div class="input-append date" id="matchdatetimepicker">
                        <input class="span2" id="matchdatetime" size="16" type="text" value="@DateTime.Today" />
                        <span class="add-on"><i class="icon-th"></i></span>
                    </div>
                    <button class="btn btn-primary" onclick="return matchSubmit();">@Las.Submit</button>
                    <button class="btn btn-primary" onclick="return matchYesterday();">@Las.Yesterday</button>
                    <button class="btn btn-primary" onclick="return matchToday();">@Las.Today</button>
                </div>
                <br />
                <div class="controls-row margin-top-10px">
                    @Html.DropDownList("MatchSport", new List<SelectListItem>(), new { @class = "selectpicker w130" })
                    @Html.DropDownList("MatchLeague", new List<SelectListItem>(), new { @class = "selectpicker w320" })
                </div>
            </div>
            <div class="tab-pane" id="filter-tab-outright">
                <div class="controls-row">
                    <span>@Las.From</span>
                    <div class="input-append date" id="outrightfromdatetimepicker" data-date="@DateTime.Today">
                        <input class="span2" id="outrightFromDate" size="16" type="text" value="@DateTime.Today" />
                        <span class="add-on"><i class="icon-th"></i></span>
                    </div>
                    <span>@Las.To</span>
                    <div class="input-append date" id="outrighttodatetimepicker" data-date="@DateTime.Today">
                        <input class="span2" id="outrightToDate" size="16" type="text" value="@DateTime.Today" />
                        <span class="add-on"><i class="icon-th"></i></span>
                    </div>
                    <button class="btn btn-primary" onclick="return outrightSubmit();">@Las.Submit</button>
                    <button class="btn btn-primary" onclick="return outrightYesterday();">@Las.Yesterday</button>
                    <button class="btn btn-primary" onclick="return outrightToday();">@Las.Today</button>
                </div>
                <div class="outright-dropdownlists margin-top-10px">
                    @Html.DropDownList("OutrightSport", new List<SelectListItem>(), new { @class = "selectpicker w130" })
                    @Html.DropDownList("OutrightLeague", new List<SelectListItem>(), new { @class = "selectpicker w320" })
                </div>
            </div>
        </div>
    </div>
}
<div id="ResultsArea">
</div>
