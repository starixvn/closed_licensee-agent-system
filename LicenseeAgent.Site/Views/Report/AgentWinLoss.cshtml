@using LicenseeAgent.AccountInformation.ViewModels
@model LicenseeAgent.Report.ViewModels.AgentWinLossReportViewModel
@{
    ViewBag.Title = Las.AgentWinLoss + " - " + Las.Report;
    var pageContext = (PageContext)ViewBag.PageContext;
}
@section css
{
    @Styles.Render("~/css/datetimepicker")
    @Styles.Render("~/css/fanexgrid")
}
@section scripts
{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/datetimepicker")
    @Scripts.Render("~/js/agentwinlostreport")
    
    @if (pageContext.IsLastLevel){
        @Html.Partial("AgentWinLoss.MemberGrid")
    }
    else {
        if(pageContext.AgentLevel == 1)
        {
            @Html.Partial("AgentWinLoss.LicenseeGrid")
        }
        else {
            @Html.Partial("AgentWinLoss.AgentGrid")
        }
    }
}
<div class="legend">
    @ViewBag.Title
</div>

@using (Html.BeginForm("AgentWinLoss", "Report", FormMethod.Post,
    new { @class = "form-filter form-inline", id = "search-form" }))
{
    <div class="controls-row">
        @Html.LabelFor(m => m.FromDate)      
        <div class="input-append date" id="fromDatePicker" data-date="@Model.FromDate">
            @Html.TextBoxFor(m => m.FromDate, new { @class = "span2", @Value = Model.FromDate })
            <span class="add-on"><i class="icon-th"></i></span>
        </div>
    </div>
    <div class="controls-row">
        @Html.LabelFor(m => m.ToDate, new { @class = "small-label" })      
        <div class="input-append date" id="toDatePicker" data-date="@Model.ToDate">
            @Html.TextBoxFor(m => m.ToDate, new { @class = "span2", @Value = Model.ToDate })
            <span class="add-on"><i class="icon-th"></i></span>
        </div>
    </div>
    <div class="newline"></div>
    
    <div class="controls-row">
        @RazorHelper.DrawFilter(Model.DrawFilter)
    </div>
    <div class="newline"></div>
        
    <div class="offset1 controls-row">  
        <button class="btn btn-primary left-button" id="search">@Las.Generate</button>
        <button class="btn btn-primary" id="today" data-date="@DateTime.Now.ToString("MM/dd/yyyy")">@Las.Today</button>
        <button class="btn btn-primary" id="yesterday" data-date="@DateTime.Now.AddDays(-1).ToString("MM/dd/yyyy")">@Las.Yesterday</button>
    </div>
    @Html.HiddenFor(m => m.AgentId)
    @Html.HiddenFor(m => m.AgentLevel)
    @Html.HiddenFor(m => m.BreadCrumb)    
}
@RazorHelper.BreadCrumb(Model.BreadCrumb)
<div class="wrapper">
    <div id="grid" class="freegrid">
    </div>
</div>