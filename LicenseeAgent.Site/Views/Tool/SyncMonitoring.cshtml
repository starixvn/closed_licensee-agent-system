@model LicenseeAgent.Web.ViewModels.SyncMonitoringViewModel
@{
    ViewBag.Title = "Monitoring Data Synchronization between Main DB and Deposit DB";
}
@section css
{
    @Styles.Render("~/css/fanexgrid")
}
@section scripts
{
    @Scripts.Render("~/js/angular")
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/tool/sync-monitoring")
}
<div class="legend">
    @ViewBag.Title
</div>
<form class="form-inline form-filter">
    <div class="controls-row">
        <label for="action">
            Actions
        </label>
        @Html.DropDownList("action", ModelSettings.TaiwanActions, new { @class = "selectpicker w160" })
    </div>
    <div class="controls-row">
        <label for="taiwanapiurl">
            Taiwan API's URL
        </label>
        <select id="taiwanapiurl">
            <option value="All">All</option>
            @foreach (var apiUrl in Model.APIUrls)
            {
                <option value="@apiUrl.Text">@apiUrl.Text</option>
            }
        </select>
    </div>
    <div class="controls-row">
        <button type="button" class="btn btn-primary" id="actionmonitoring">
            Submit
        </button>
    </div>
</form>
<div id="monitoringGrid" class="freegrid content-grid">
</div>