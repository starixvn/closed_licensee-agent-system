@model SettingContext
@{
    var currentSession = SessionManager.CurrentSession;
    if (Model.TargetRoleId == (int)Role.Member)
    {
        ViewBag.Title = string.Format(Las.AddNewMember, Model.UserName);
    }
    else
    {
        ViewBag.Title = string.Format(Las.AddNewAgent, Model.UserName);
    }

    var scriptUrl = Url.Action("GetSetting", "SportsBook", new
    {
        custId = Model.CustId,
        roleId = Model.RoleId,
        targetCustId = Model.TargetCustId,
        targetRoleId = Model.TargetRoleId
    });
}
@section css
{
    @Styles.Render("~/css/productsetting")
}
@section scripts
{
    <script type="text/javascript" src="@scriptUrl"></script>
    @Scripts.Render("~/js/angular")
    @Scripts.Render("~/js/autonumeric")
    @Scripts.Render("~/js/productsetting")
    @Scripts.Render("~/js/productsetting/sportsbook")
}
<div class="legend @(Request.IsPopup() ? "popup" : "")">
    @ViewBag.Title
</div>
<div id="custSetting" style="display: none" data-ng-app="fanex.customerSetting" class="fanex-customer-setting fanex-sportbook-setting"
    data-ng-controller="CustomerSettingController" data-href="~/ProductSetting/SportsBook/InsertCustomer">
    <div class="clearfix">
        <div class="messages" data-ng-show="Messages != null && Messages.length > 0">
            <p data-ng-repeat="message in Messages" data-ng-class="{'success': message.ErrCode == result.Success, 'error' : message.ErrCode != result.Success}">
                <i data-ng-class="{'icon-message-success': message.ErrCode == result.Success, 'icon-message-error' : message.ErrCode != result.Success}">
                </i>{{message.ErrMsg}}
            </p>
        </div>
    </div>
    <div class="clearfix">
        <div class="control-group" data-ng-hide="settingMode">
            <button class="btn btn-primary" data-ng-click="insertCustomer($event)">
                <i class="icon-button-plus"></i>@Las.Add
            </button>
        </div>
    </div>
    <div class="clearfix">
        @Html.Partial("~/Areas/ProductSetting/Views/CustomerInfo.cshtml")
    </div>
    @if (!Model.IsDeposit)
    {
        <div class="clearfix">
            @Html.Partial("~/Areas/ProductSetting/Views/Sportsbook/Commission.cshtml", Model)
        </div>
    }
    <div class="clearfix" data-ng-if="false">
        <div class="container-mode">
            <span class="mode-text">@Las.AdvancedMode</span>
            <div class="make-switch switch-small" id="modeSwitcher">
                <input type="checkbox" />
            </div>
        </div>
    </div>
    <div data-ng-class="{'clearfix': true}" class="product-group">
        <div class="product-name">
            @Las.Sportsbook
        </div>
        <div class="product-container">
            <div class="clearfix">
                <div class="edit-setting-warning" data-ng-show="settingMode">
                    @Las.SportsBookSimpleModeNote
                </div>
            </div>
            <div class="clearfix">
                @Html.Partial("~/Areas/ProductSetting/Views/Sportsbook/BetSetting.cshtml", Model)
            </div>
            <div class="clearfix">
                @Html.Partial("~/Areas/ProductSetting/Views/Sportsbook/PositionTaking.cshtml", Model)
            </div>
        </div>
    </div>
    <div data-ng-class="{'clearfix': true}" data-ng-if="hasOfferedNumberGame" class="product-group">
        <div class="product-name">
            @Las.NumberGame
        </div>
        <div class="product-container">
            <div class="clearfix">
                <div class="edit-setting-warning" data-ng-show="settingMode">
                    @Las.NumberGameSimpleModeNote
                </div>
            </div>
            <div class="clearfix box-bottom">
                @Html.Partial("~/Areas/ProductSetting/Views/NumberGame/BetSetting.cshtml", Model)
            </div>
            <div class="clearfix box-bottom">
                @Html.Partial("~/Areas/ProductSetting/Views/NumberGame/PositionTaking.cshtml", Model)
            </div>
        </div>
    </div>
    <div class="clearfix">
        <div class="control-group">
            <button class="btn btn-primary" data-ng-click="insertCustomer($event)">
                <i class="icon-button-plus"></i>@Las.Add
            </button>
        </div>
    </div>
</div>
