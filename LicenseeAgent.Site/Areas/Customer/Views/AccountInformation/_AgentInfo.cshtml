@model SearchUserResultViewModel
@Html.HiddenFor(m => m.Customer.CustId, new { @id = "AgentId" })
<div class="container-fluid">
    @if (Model.Uplines.Any())
    {
        var totalMoreUpLines = Math.Max(Model.Uplines.Count() - 3, 0);
        var moreUpLines = Model.Uplines.Take(totalMoreUpLines).ToList();
        var showUpLines = Model.Uplines.Skip(totalMoreUpLines).ToList();
        if (moreUpLines.Any())
        {
        <div class="row">
            <div class="cell-left">@Las.MoreUplines</div>
            <div class="cell-right btn-group pull-right">
                <button id="more-upline" class="btn btn-mini btn-primary">
                    @Las.More
                    <i class="icon-more-arrow" rel="popover"></i>
                    <div class="hide">
                        @Html.Partial("_UpLinesPopover", moreUpLines)
                    </div>
                </button>
            </div>
        </div>
        }

        if (showUpLines.Any())
        {
            foreach (var entity in showUpLines)
            {
        <div class="row">
            <div class="cell-left">@string.Format(Las.AgentLevelFormat, entity.Level - 1)</div>
            <div class="cell-right">
                <a class="agent-inline" href="#" data-id="@entity.UplineCustId" title="@entity.UserName">
                    @entity.MediumUserName
                </a>
            </div>
        </div>
            }
        }
    }
    @if (Model.Customer != null)
    {
        <div class="row cust-info">
            <div class="@(Model.Customer.Status == (int)AccountStatus.Open ? "open" : "closed")">
                <div class="cust-info-username">
                    <span title="@Model.Customer.UserName">@Formatter.FormatMediumUserName(Model.Customer.UserName)</span>
                    <i class="icon-collapse"></i>
                </div>
                <div class="cust-info-pt">
                    PT</div>
            </div>
            <table class="table table-condensed">
                <tbody>
                    <tr>
                        <td>
                            <i class="icon-customer-status"></i>
                        </td>
                        <td>
                            <div class="@(Model.Customer.Status == (int)AccountStatus.Open ? "icon-status-open" : "icon-status-closed")" id="customer-status">
                                <span>@(Model.Customer.Status == (int)AccountStatus.Open ? Las.Open : Las.Closed)</span>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <i class="icon-customer-avatar"></i>
                        </td>
                        <td>
                            @Model.Customer.FullName
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <i class="icon-customer-cellphone"></i>
                        </td>
                        <td>
                            @Model.Customer.MobileDisplay
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <i class="icon-customer-phone"></i>
                        </td>
                        <td>
                            @Model.Customer.PhoneDisplay
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <i class="icon-customer-fax"></i>
                        </td>
                        <td>
                            @Model.Customer.FaxDisplay
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>