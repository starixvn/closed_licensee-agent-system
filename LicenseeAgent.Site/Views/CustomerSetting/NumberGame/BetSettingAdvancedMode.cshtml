<div data-ng-controller="NumberGameBetLimitAdvancedModeController" data-ng-if="hasOfferedNumberGame">
    <div>
        <div class="betting-limit-sport-header-col4">
            <div class="betting-limit-header-text">
            </div>
        </div>
        <div class="betting-limit-header-col4 min-bet">
            <div class="betting-limit-header-text">
                <span>@Las.MinBet</span></div>
        </div>
        <div class="betting-limit-header-col4">
            <div class="betting-limit-header-text">
                <span>@Las.MaxBet</span></div>
        </div>
        <div class="betting-limit-header-col4">
            <div class="betting-limit-header-text">
                <span>@Las.MaxPerMatch</span></div>
        </div>
        <div class="betting-limit-header-col4">
            <div class="betting-limit-header-text">
                <span>@Las.MaxPerBall</span></div>
        </div>
    </div>
    <div data-ng-repeat="betSetting in model.bettingLimitsModel">
        @if (Model.FormId != FormType.ViewIndirectAgent)
        {
            <number-game-betting-limit-advanced-mode betting-limits-model="model.bettingLimitsModel"
                bet-setting="betSetting" current-index="$index">
            </number-game-betting-limit-advanced-mode>
        }
        else
        {
            <number-game-betting-limit-advanced-mode-read-only betting-limits-model="model.bettingLimitsModel"
                bet-setting="betSetting" current-index="$index">
            </number-game-betting-limit-advanced-mode-read-only>
        }
        <div class="clearfix">
        </div>
    </div>
</div>