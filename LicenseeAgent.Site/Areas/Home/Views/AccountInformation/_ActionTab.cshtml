@model SearchUserResultViewModel
@{
    var currentSession = SessionManager.CurrentSession;
    var pageContext = (PageContext)ViewBag.PageContext;
    var isAllowEditSetting = pageContext.IsAdmin || pageContext.IsDirectDownLine || pageContext.IsMember;
    var hasResetPassword = true;
    var hasEditInfo = (SessionManager.CurrentSession.IsAdmin || pageContext.IsDirectDownLine) && !(pageContext.IsMember && pageContext.IsDeposit);
    var hasAddDownLine = !pageContext.IsMember
        && Model.Customer.Status == (int)AccountStatus.Open
        && currentSession.IsAdmin
        && (currentSession.AgentInfo.IsCredit || (!pageContext.IsLastLevel && currentSession.AgentInfo.IsDeposit));
}
<div class="tab-pane active in" id="panel-action">
    <div class="content">
        <ul class="nav nav-list">
            <li>
                @if (SessionManager.CurrentSession.IsAdmin && pageContext.IsMember)
                {
                    <a href="#" rel="popover" data-toggle="popover" data-original-title="" class="popover-link">
                        <i class="icon-downline-arrow"></i>
                        @(isAllowEditSetting ? Las.EditSportsbook : Las.ViewSportsbook)
                    </a>
                    <div class="hide">
                        @Html.Partial("_SettingPopover", Model, new ViewDataDictionary { { "actionName", "EditMember" }, { "controller", "SportsBook" }, { "area", "ProductSetting" } })
                    </div>
                }
                else
                {
                    <a href="@(pageContext.IsMember ? Url.Action("EditMember", "SportsBook", new { area = "ProductSetting", memberId = Model.Customer.CustId }) : Url.Action("EditAgent", "SportsBook", new { area = "ProductSetting", agentId = Model.Customer.CustId }))" target="frmMain">
                        <i class="icon-downline-arrow"></i>
                        @(isAllowEditSetting ? Las.EditSportsbook : Las.ViewSportsbook)
                    </a>
                }
            </li>
            @if (pageContext.IsOfferedVirtualSports)
            {
                <li>
                    @if (SessionManager.CurrentSession.IsAdmin && pageContext.IsMember)
                    {
                        <a href="#" rel="popover" data-toggle="popover" data-original-title="" class="popover-link">
                            <i class="icon-downline-arrow"></i>
                            @(isAllowEditSetting ? Las.EditVirtualSports : Las.ViewVirtualSports)
                        </a>
                        <div class="hide">
                            @Html.Partial("_SettingPopover", Model, new ViewDataDictionary { { "actionName", "EditMember" }, { "controller", "VirtualSports" }, { "area", "ProductSetting" } })
                        </div>
                    }
                    else
                    {
                        <a href="@(pageContext.IsMember ? Url.Action("EditMember", "VirtualSports", new { area = "ProductSetting", memberId = Model.Customer.CustId }) : Url.Action("EditAgent", "VirtualSports", new { area = "ProductSetting", agentId = Model.Customer.CustId }))" target="frmMain">
                            <i class="icon-downline-arrow"></i>
                            @(isAllowEditSetting ? Las.EditVirtualSports : Las.ViewVirtualSports)
                        </a>
                    }
                </li>
            }
            @if (hasResetPassword)
            {
                <li><a href="@(pageContext.IsMember ? Url.Action("ResetPassword", "Member", new { area = "CustomerList", memberId = Model.Customer.CustId }) : Url.Action("ResetPassword", "Agent", new { area = "CustomerList", agentId = Model.Customer.CustId, agentLevel = Model.Customer.Level }))" target="frmMain">
                    <i class="icon-downline-arrow"></i>
                    @Las.ResetPassword
                </a></li>
            }
            @if (hasEditInfo)
            {
                <li><a href="@(pageContext.IsMember ? Url.Action("EditInfo", "Member", new { area = "CustomerList", memberId = Model.Customer.CustId, username = Model.Customer.UserName }) : Url.Action("EditInfo", "Agent", new { area = "CustomerList", agentId = Model.Customer.CustId }))" target="frmMain">
                    <i class="icon-downline-arrow"></i>
                    @Las.EditInfo
                </a></li>
            }
            @if (hasAddDownLine)
            {
                <li><a href="@(Url.Action("InsertCustomer", "SportsBook", new { area = "ProductSetting", agentId = Model.Customer.CustId }))" target="frmMain">
                    <i class="icon-downline-arrow"></i>
                    @Las.AddDownline
                </a></li>
            }
        </ul>
    </div>
</div>