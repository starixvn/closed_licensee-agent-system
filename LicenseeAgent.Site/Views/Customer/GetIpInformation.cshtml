@model IpInformationViewModel
@{
    Layout = null;
}

<table>
    <tr>
        <td class="col-left">@Las.Ip</td>
        <td class="col-right" id="instip">@Model.IpAddress</td>
    </tr>
    <tr>
        <td class="col-left">@Las.Country</td>
        <td class="col-right" id="instcountry">@Model.Country</td>
    </tr>
    <tr>
        <td class="col-left">@Las.City</td>
        <td class="col-right" id="instcity">@Model.City</td>
    </tr>
    <tr>
        <td colspan="2" id="instcontent">
            Additional info at DNSstuff: <a target="_blank" href="http://www.iplocationfinder.com/@(Model.IpAddress)">click here</a>. Note: Country and city information is provided by IP2Location™ and DNSstuff which might only serve as a reference, with no warranty. Please consult other reliable sources for the current and accurate information, if required.
        </td>
    </tr>
</table>