@using System.Web.Mvc
@using LicenseeAgent.Core.Configurations
@using LicenseeAgent.Resources
@using LicenseeAgent.AccountInformation.Entities
@helper LanguageDropDown(string selectedLanguage = null)
    {
        var language = ModelSettings.Languages.Where(x => x.Value == selectedLanguage).FirstOrDefault();
        if (language == null)
        {
            language = ModelSettings.Languages.First();
        }
    <a href="javascript:void(0);"><span class="top-language @string.Format("flag-{0}", language.Value)">
    </span>@language.Text
    </a>
    <span class="icon-arrow"></span>
    <ul class="language-box">
        @foreach (var item in ModelSettings.Languages)
        {
            <li><a href="javascript:void(0);" data-language="@item.Value"><i class="@string.Format("flag-{0}", item.Value)">
            </i>@item.Text</a></li>
        }
    </ul>
}
@helper RenderInstruction(string text, string id)
    {
    <div class="instruction">
        @text
        <span class="icon-instruction-exclamation" title="@Las.ClickToViewInstructions" id="@id">
        </span>
    </div>
}
@helper FormatNegative(decimal value)
    {
        var className = value < 0 ? "color-r" : string.Empty;
    <span class="@className">@LicenseeAgent.Core.Utility.Formatter.FormatDecimal(value)</span>
}
@helper RenderPopover(int memberId, IList<UplineEntity> uplines, int numberOfLevel)
    {
        var url = new System.Web.Mvc.UrlHelper(Context.Request.RequestContext);
        var numberUpline = uplines.Count;
        for (int index = numberUpline - 1; index >= 0; index--)
        {
    <a href='@(url.Action("EditMember", "CustomerSetting", new { memberId = memberId, agentId = uplines[index].UplineCustId, agentLevel = uplines[index].Level, numberOfLevel = numberOfLevel }))' target='frmMain' class='popover-item' onclick='accountInformation.hidePopover();'>@(uplines[index].UserName)</a>
        }
}
@helper DrawFilter(short val)
{
    <label for="DrawFilter">@Las.DrawFilter</label>
    <label class="radio">
        @Las.Normal 
        <input type="radio" name="DrawFilter" value="0" @(val == 0 ? "checked" : "") />
    </label>
    <label class="radio">
        @Las.NoDraw
        <input type="radio" name="DrawFilter" value="1" @(val == 1 ? "checked" : "") />
    </label>
    <label class="radio">
        @Las.NoDrawForTurnoverOnly
        <input type="radio" name="DrawFilter" value="2" @(val == 2 ? "checked" : "") />
    </label>
}
@helper BreadCrumb(string val)
{
    var listBreadCrumb = val.Split(';');
    var length = listBreadCrumb.Length;
    if(length > 1)
    {
        <div class="clearfix">
            <ul class="breadcrumb">
                @foreach (var item in listBreadCrumb)
                {
                    var agentInfo = item.Split(',');
                    <li>
                        @if (string.Compare(item, listBreadCrumb[length - 1]) != 0)
                        {
                            <a href="#" data-agent-id="@agentInfo[0]" data-agent-level="@agentInfo[1]">@agentInfo[2]</a>
                            <span class="divider">>></span>
                        }
                        else
                        {
                            <span>@agentInfo[2]</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }
}