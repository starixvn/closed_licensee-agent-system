@using LicenseeAgent.AccountInformation.ViewModels
@model SearchUserResultViewModel
@{
    var pageContext = (PageContext)ViewBag.PageContext;
}
<div class="controls-row">
    <div class="row-line"></div>
    @if (pageContext.IsMember)
    {
        <ul class="nav nav-tabs">
            <li class="active"><a href="#balance" id="tabBalance" data-toggle="tab">@Las.BalanceInfo</a></li>
        </ul>
        <div class="tab-content tab-small">
            <div class="tab-pane active in" id="balance">
                @Html.Partial("_BalanceInformation")
            </div>
        </div>
    }
    else
    {
        <ul class="nav nav-tabs">
            <li class="active"><a href="#balance" id="tabBalance" data-toggle="tab">@Las.BalanceInfo</a> </li>
            <li><a href="#downlineList" id="tabDownline" data-toggle="tab">@Las.DownlineList</a>
            </li>
        </ul>
        <div class="tab-content tab-small">
            <div class="tab-pane active in" id="balance">
                @Html.Partial("_BalanceInformation")
            </div>
            <div class="tab-pane fade" id="downlineList">
                @if (Model.Downlines.Any())
                {
                    <div id="downlineContent" class="content">
                        <ul class="nav nav-list">
                            @foreach (var donwline in Model.Downlines)
                            {
                                <li><a class="agent-inline" href="#" data-id="@donwline.DownlineCustId" title="@donwline.UserName">
                                        <i class="icon-downline-arrow"></i>@donwline.UserName</a> </li>
                            }
                        </ul>
                    </div>
                    <div id="paging" data-total-pages="@Model.TotalPages" data-page-index="@Model.PageIndex">
                    </div>
                }
                else
                {
                    <div class="no-info">@LangMsg.Msg_1034</div>
                }
            </div>
        </div>
    }
</div>