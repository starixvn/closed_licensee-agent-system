@model SearchUserResultViewModel
@{
    var pageContext = (PageContext)ViewBag.PageContext;
    var actionName = pageContext.IsOfferedVirtualSports ? "EditVirtualSportsMember" : "EditMember";
}
<ul>
    <li class='popover-header'>
        <div>@Las.Level</div>
        <div>@Las.Username</div>
    </li>
    @foreach (var entity in Model.Uplines)
    {
        <li class='popover-item'>
            <div>@string.Format(Las.AgentLevelFormat, entity.Level - 1)</div>
            <div>
                <a class='agent-inline' href='@Url.Action(actionName, "CustomerSetting", new { area = "", memberId = Model.Customer.CustId, agentId = entity.UplineCustId, agentLevel = entity.Level, numberOfLevel = Model.Customer.NumberOfLevel }))'  target='frmMain' onclick='customer.accountInformation.hidePopover();' title='@entity.UserName'>
                    @entity.MediumUserName
                </a>
            </div>
        </li>
    }
</ul>