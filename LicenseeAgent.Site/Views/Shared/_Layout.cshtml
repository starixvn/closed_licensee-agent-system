@using LicenseeAgent.Core.Utils
<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/css/jqueryui")
    @Styles.Render("~/css/bootstrap")
    @Styles.Render("~/css/core")
    @RenderSection("css", false)
</head>
<body>
    <div id="mainContainer">
        @RenderBody()
    </div>
    @Html.Hidden("AppRoot", Url.Content("~/"))
    @Html.Hidden("AppSelectedLanguage", (string)ViewBag.Language)
    @Html.Partial("_AppLang")
    @if (ViewBag.PageLang != null)
    {
        <script type="text/javascript">
            @Html.Raw(Formatter.FormatJson("pageLang", ViewBag.PageLang))
        </script>
    }
    @if (ViewBag.PageContext != null)
    {
        <script type="text/javascript">
            @Html.Raw(Formatter.FormatJson("pageContext", ViewBag.PageContext))
        </script>
    }
    
    <script type="text/javascript">
        var _page = {
            lang: '@System.Globalization.CultureInfo.CurrentUICulture.Name'
        };
    </script>

    @Scripts.Render("~/js/jquery")
    @Scripts.Render("~/js/jqueryui")
    @Scripts.Render("~/js/bootstrap")
    @Scripts.Render("~/js/core")
    @Scripts.Render("~/js/language")
    @RenderSection("scripts", false)
    <div class="block-loading" style="display: none;">
    </div>
    @StackExchange.Profiling.MiniProfiler.RenderIncludes()
</body>
</html>