@using LicenseeAgent.Web.Mvc
@model UnderMaintenanceInfo
@{
    Layout = null;
    var maintenanceMessage = string.Format(Las.MessageUnderMaintenance, Model.UmTimeFrom, Model.UmTimeTo);
}
<!DOCTYPE HTML>
<html>
<head>
    <title>@Las.UnderMaintenance</title>
    @Styles.Render("~/css/error")
    @Html.Partial("_AppScript")
    @Scripts.Render("~/js/jquery")
    @Scripts.Render("~/js/core")
    @Scripts.Render("~/js/error/UnderMaintenance")
</head>
<body>
    <div class="um-block">
        <div class="block-text">
            <span>@Html.Raw(maintenanceMessage)</span>
        </div>
    </div>
    @Html.Hidden("AppRoot", Url.Content("~/"))
    @Scripts.Render("~/js/jquery")
    @Scripts.Render("~/js/jqueryui")
    @Scripts.Render("~/js/core")
    @Scripts.Render("~/views/notify/resources/UnderMaintenance.js")
</body>
</html>