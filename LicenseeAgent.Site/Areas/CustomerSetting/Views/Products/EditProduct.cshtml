@model EditProductViewModel
@{
    ViewBag.Title = Las.EditSettingOfOtherProducts;
}
@section css
{
    @Styles.Render("~/css/customersetting")
    @Styles.Render("~/css/customersetting/editproduct")
}
@section scripts
{
    @Scripts.Render("~/js/angular")
    @Scripts.Render("~/js/customersetting")
    <script language="javascript" type="text/javascript">
        @HtmlExtensions.Javascript(Model.Products, "products")
    </script>
}
@RazorHelper.Legend(ViewBag.Title)
<div id="custSetting" data-ng-app="customerSetting.editProduct" data-ng-controller="EditProductController">
    <ul class="nav nav-tabs">
        <li data-ng-repeat="product in products" data-ng-class="{'active': product.ProductId==@(Model.ProductId)}">
            <a href="#" data-toggle="tab" data-ng-click="loadUrl(product.Url)">{{product.ProductName}}</a>
        </li>
    </ul>
    <div id="myTabContent" class="tab-content">
        <iframe id="tabFrame" frameborder="0" data-ng-src="{{activeUrl(@(Model.ProductId))}}">
        </iframe>
    </div>
</div>