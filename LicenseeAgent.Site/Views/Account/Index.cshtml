@{
    ViewBag.Title = "Index";
}
@model HomePageViewModel
@section css
{
    @Styles.Render("~/css/home-page")
}
@section scripts{
    @Scripts.Render("~/js/home-page")
}
<div class="box-row">
    <div class="box-cell" id="balance-info-container">
        @Html.Partial("_BalanceInfo", Model.BalanceInfo)
    </div>
    <div class="box-cell" id="your-statistics-container">
        @Html.Partial("_Statistics", Model.StatisticInfo)
    </div>
</div>
<div class="box-row">
    <div class="box-cell" id="announcement-container">
        @Html.Partial("_Announcement")
    </div>
</div>