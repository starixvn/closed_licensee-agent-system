@model AgentChangePasswordViewModel
@{
    ViewBag.Title = Las.ChangePassword;
    var viewResult = ViewBag.Result as AgentChangePasswordViewResult;
}
@RazorHelper.Legend(ViewBag.Title)
<div style="width: 378px">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-table" }))
    {
        @Html.ValidationSummary()
        <fieldset>
            @if (viewResult != null)
            {
                <p class="text-success">
                    @viewResult.Message
                </p>
            }
            @Html.AntiForgeryToken()
            <table class="no-wrap">
                <colgroup>
                    <col width="150" />
                    <col width="228" />
                </colgroup>
                <tbody>
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.CurrentPassword)
                        </td>
                        <td>
                            @Html.PasswordFor(m => m.CurrentPassword, new { maxlength = "24" })
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.NewPassword)
                        </td>
                        <td>
                            @Html.PasswordFor(m => m.NewPassword, new { maxlength = "24" })
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.ConfirmPassword)
                        </td>
                        <td>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { maxlength = "24" })
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="button-group row-fluid">
                <button type="reset" class="btn btn-primary pull-right">
                    @Las.Reset
                </button>
                <button type="submit" class="btn btn-primary pull-right">
                    @Las.ChangePassword
                </button>
            </div>
            <div class="form-note">
                <span class="note-text">@Las.Note:</span>
                @Html.Raw(Las.PasswordHint)
            </div>
        </fieldset>
    }
</div>
@section scripts{
    @if (viewResult != null && viewResult.IsReload)
    {
        <script type="text/javascript">
            core.gotoHomePage();
        </script>
    }
}