<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/css/bootstrap")
    @Styles.Render("~/css/core")
    @Styles.Render("~/css/authentication")
    @RenderSection("css", false)
    @Html.Partial("_AppScript")
    @Scripts.Render("~/js/jquery")
    @Scripts.Render("~/js/bootstrap")
    @Scripts.Render("~/js/language")
    @Scripts.Render("~/js/core")
    @Scripts.Render("~/js/authentication")
    @Scripts.Render("~/js/cryptojs")
</head>
<body>
    @RenderBody()
    <script type="text/javascript">
        $(function () {
            authentication.init();
        });
    </script>
    @RenderSection("scripts", false)
</body>
</html>