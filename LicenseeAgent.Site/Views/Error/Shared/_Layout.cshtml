@{
    Layout = null;
    ViewBag.Title = ViewBag.Title ?? Las.Error;
}
<!DOCTYPE HTML>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/css/error")
    @RenderSection("css", false)
</head>
<body>
    @RenderBody()
    @RenderSection("scripts", false)
</body>
</html>