@{
    ViewBag.Title = Las.TotalBets + " - " + Las.Outright;
}
@using LicenseeAgent.TotalBets.Entities;
@using LicenseeAgent.TotalBets.ViewModels;
@model OutrightViewModel
@section css{
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/plugin")
    @Styles.Render("~/css/totalbets-soccer")
}
@section scripts{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/plugin")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/totalbets-outright")
    @Html.Partial("Outright.Script")
}
<div class="legend">
    @ViewBag.Title
</div>
@using (Html.BeginForm("Outright", "TotalBets", FormMethod.Post, new { @class = "form-inline form-filter ", id = "main-form" }))
{   
    <div class="controls-row">
        <div id="sport-multi-select">
        </div>
        @Html.Hidden("Sport", Model.Sport)
    </div>
    <div class="controls-row">
        <div id="league-multi-select">
        </div>
        @Html.Hidden("League", Model.League)
    </div>
    <div class="controls-row">
        <div id="team-multi-select">
        </div>
        @Html.Hidden("Team", Model.Team)
    </div>
    <div class="controls-row">
        <button class="btn btn-primary" type="submit">
            @Las.Submit
        </button>
    </div>
    <div class="controls-row refresh-count-down-area">
        <div class="refresh-count-down" id="refresh-count-down">
        </div>
        <input type="hidden" value="@Model.TimeInterval" id="server-time-interval" />
    </div>
}
<div class="wrapper">
    <div id="grid" class="freegrid">
    </div>
</div>
