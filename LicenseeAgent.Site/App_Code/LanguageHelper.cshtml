@using LicenseeAgent.Core.Configurations
@helper DropDown(string selectedLanguage = null)
    {
        var languages = ModelSettings.Languages.Where(x => x.Value == selectedLanguage);
        var language = languages.Any() ? languages.First() : ModelSettings.Languages.First();

    <div class="language">
        <ul id="nav">
            <li><a href="#" class="@string.Format("flag-{0}", language.Value)"><i class="icon-language-arrow">
            </i></a>
                <ul id="languages">
                    @foreach (var item in ModelSettings.Languages)
                    {
                        <li data-language="@item.Value"><a href="#"><i class="@string.Format("flag-{0}", item.Value)">
                        </i>
                            @item.Text
                        </a></li>
                    }
                </ul>
            </li>
        </ul>
    </div>
}