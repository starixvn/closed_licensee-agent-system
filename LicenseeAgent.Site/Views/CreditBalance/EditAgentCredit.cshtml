@using LicenseeAgent.Core.Utility
@model LicenseeAgent.CreditBalance.ViewModels.EditAgentCreditViewModel
@{
    ViewBag.Title = @Las.UpdateCredit;
}
<div class="legend">
    @ViewBag.Title
</div>
<div class="pull-left">
    @using (Html.BeginForm("EditAgentCredit", "CreditBalance", FormMethod.Post, new { @class = "form-table" }))
    {
        @Html.ValidationSummary()
        <fieldset>
            @if (ViewBag.Result != null)
            {
                <p class="text-success">
                    @ViewBag.Result.ToString()
                </p>
            }
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.AgentId)
            @Html.HiddenFor(m => m.AgentName)
            @Html.HiddenFor(m => m.MinCreditOutput)
            @Html.HiddenFor(m => m.MaxCreditOutput)
            <table>
                <colgroup>
                    <col width="150" />
                    <col width="250" />
                </colgroup>
                <tbody>
                    <tr>
                        <td>
                            @Las.Username
                        </td>
                        <td>
                            @Model.AgentName
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @Las.Credit
                        </td>
                        <td class="nowrap">
                            @if (!Model.MaxCreditOutput.HasValue)
                            {
                                @Html.TextBox("GivenCredit", Formatter.FormatDecimal(Model.GivenCredit), new { @class = "w100", data_min = Model.MinCreditOutput, title = Las.InvalidAmount })
                                <span>@string.Format(">= {0}", Formatter.FormatDecimal(Model.MinCreditOutput))</span>
                            }
                            else
                            {
                                @Html.TextBox("GivenCredit", Formatter.FormatDecimal(Model.GivenCredit), new { @class = "w100", data_min = Model.MinCreditOutput, data_max = Model.MaxCreditOutput, title = Las.InvalidAmount })
                                <span>@string.Format("[{0} - {1}]", Formatter.FormatDecimal(Model.MinCreditOutput), Formatter.FormatDecimal(Model.MaxCreditOutput))</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="button-group row-fluid">
                <button type="button" class="btn btn-primary pull-right" onclick="POPUP.close(0);">
                    @Las.Cancel
                </button>
                <button type="submit" class="btn btn-primary pull-right">
                    @Las.Update
                </button>
            </div>
        </fieldset>
    }
</div>
@section scripts
{
    @Scripts.Render("~/js/autonumeric")
    @Scripts.Render("~/js/creditbalance-popup")
    @if (ViewBag.Result != null)
    {
        <script type="text/javascript">
            POPUP.close();
            if (window.parent.creditBalanceList)
                window.parent.creditBalanceList.submit();
        </script>
    }
}