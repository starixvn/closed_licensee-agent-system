@model AgentOutstandingViewModel
@{
    ViewBag.Title = Las.AgentOutstanding + " - " + Las.Report;
}
@section css
{
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/betlist")
    @Styles.Render("~/css/report/agent-outstanding")
}
@section scripts
{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/report/agent-outstanding")
    <script type="text/javascript">
        $(function () {
            REPORT.AGENT_OUTSTANDING.init();
        });
    </script>
}
<div class="legend">
    @ViewBag.Title
</div>
@Html.Partial("_Breadcrumb")
@using (Html.BeginForm(null, null, FormMethod.Post,
    new { @class = "form-filter form-inline hide", id = "search-form" }))
{
    @Html.HiddenFor(m => m.AgentId)
    @Html.HiddenFor(m => m.ShowMembers)
}
<div id="BetListGrid" class="freegrid content-grid">
</div>