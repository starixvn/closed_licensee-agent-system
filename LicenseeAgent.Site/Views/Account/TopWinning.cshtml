@{
    Layout = null;
}
@model IEnumerable<LicenseeAgent.Account.Entities.TopWinningEntity>
<table style="width:300px;">
    <tr  class="header">
        <td>@Las.Username</td>
        <td>@Las.WinningAmount</td>
    </tr>
    @if (Model != null && Model.Count() > 0)
    {
        foreach (var member in Model)
        {
        <tr>
            <td>@member.Username</td>
            <td class="text-right">@LicenseeAgent.Core.Utils.Formatter.FormatDecimal(member.WinLost)</td>
        </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="2" class="text-center">@Las.NoInfo</td>
        </tr>
    }
</table>
