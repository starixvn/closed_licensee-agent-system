<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="LicenseeAgent.AppURLs" type="LicenseeAgent.Web.AppURLs, LicenseeAgent.Web" />
  </configSections>
  <appSettings>
    <add key="IsAdminSite" value="1" />
    <add key="Environment" value="UAT" />
    <add key="RemoteRefURL" value="tcp://10.18.200.209:8888/CallGetRefFunction" />
    <add key="UnderMaintenanceUrl" value="" />
    <add key="LocalTest" value="1" />
    <add key="LocalLicenseeId" value="27" />
    <add key="IsDownTime" value="0" />
    <add key="DownTime" value="10:00AM - 13:00PM" />
    <add key="TaiwanAPI" value="http://lastest.net2cast.com/API" />
    <add key="TrustedAdmins" value="*" />
    <add key="OfferedProducts" value="*" />
  </appSettings>
  <LicenseeAgent.AppURLs ChangePassword="~/Account/ChangePassword" AccessDenied="~/AccessDenied" CurrencyPermissionDenied="~/CurrencyPermissionDenied" Error="~/Error" Unauthorized="~/Unauthorized" UnderMaintenance="~/UnderMaintenance" SignOut="~/Account/SignOut" />
</configuration>