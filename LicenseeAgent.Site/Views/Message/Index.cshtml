@model LicenseeAgent.Message.ViewModels.MessageViewModel
@{
    ViewBag.Title = Las.MessageAnnouncement;
}
@section css
{
    @Styles.Render("~/css/datetimepicker")
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/message")
}
@section scripts
{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/datetimepicker")
    @Scripts.Render("~/js/message")
}
<div class="legend">
    @Las.MessageAnnouncement
</div>
@using (Html.BeginForm("#", "Message", FormMethod.Post,
    new { @class = "form-inline form-filter", id = "search-form" }))
{
    <div class="controls-row">
        @Html.LabelFor(m => m.FromDate, new { @class = "small-label" })
        <div class="input-append date" id="fromDatePicker" data-date="@Model.FromDate">
            @Html.TextBoxFor(m => m.FromDate, new { @class = "span2", @Value = Model.FromDate })
            <span class="add-on"><i class="icon-th"></i></span>
        </div>
    </div>
    <div class="controls-row">
        @Html.LabelFor(m => m.ToDate, new { @class = "small-label" })
        <div class="input-append date" id="toDatePicker" data-date="@Model.ToDate">
            @Html.TextBoxFor(m => m.ToDate, new { @class = "span2", @Value = Model.ToDate })
            <span class="add-on"><i class="icon-th"></i></span>
        </div>
    </div>
    <div class="controls-row">
        <button class="btn btn-primary action-generate">@Las.Generate</button>
    </div>
}
<div class="filter-tabs" class="form-filter">
    <ul id="tabs-area" class="nav nav-tabs">
        <li class="tab-public active"><a href="#">@Las.PublicAnnouncements</a></li>
        <li class="tab-special"><a href="#">@Las.SpecialAnnouncements</a></li>
        <li class="tab-personal"><a href="#">@Las.PersonalMessage</a></li>
    </ul>
</div>
<div class="display-none content-grid">
    <div class="freegrid" id="MessageArea">
    </div>
</div>