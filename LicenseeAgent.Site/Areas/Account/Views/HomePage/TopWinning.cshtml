@{
    Layout = null;
}
@model IList<TopWinningEntity>
<table>
    <thead>
        <tr>
            <th>
                @Las.Username
            </th>
            <th>
                @Las.WinningAmount
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count() > 0)
        {
            foreach (var member in Model)
            {
            <tr>
                <td>
                    @member.Username
                </td>
                <td class="text-right">
                    @Formatter.FormatDecimal(member.WinLost)
                </td>
            </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center">
                    @Las.NoInfo
                </td>
            </tr>
        }
    </tbody>
</table>