@using LicenseeAgent.Web.Mvc
@model UnderMaintenanceInfo
@{
    Layout = null;
    var maintenanceMessage = string.Format(Las.MessageUnderMaintenance, Model.UmTimeFrom, Model.UmTimeTo);
}
<!DOCTYPE HTML>
<html>
<head>
    <title>@Las.UnderMaintenance</title>
    <link rel="Stylesheet" href="~/views/error/resources/index.less" type="text/css" />
</head>
<body>
    <div class="um-block">
        <div class="block-text">
            <span>@Html.Raw(maintenanceMessage)</span></div>
    </div>
</body>
</html>