@{
    ViewBag.Title = Las.TotalBets + " - " + Las.OtherSports;
}
@using LicenseeAgent.TotalBets.Entities;

@section css{
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/plugin")
    @Styles.Render("~/css/totalbets-soccer")
}
@section scripts{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/plugin")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/totalbets-OtherSports")        
    
    @Html.Partial("OtherSports.Script")
}

<div class="legend" style="width: 873px;">
    @Las.OtherSports.ToUpper() - @Las.TotalBets.ToUpper()
</div>

@using (Html.BeginForm("OtherSports", "TotalBets", FormMethod.Post, new { @class = "form-inline form-filter ", id = "main-form" }))
{   
    <div class="controls-row">
        <div id="sport-multi-select"></div>
    </div>
    <div class="controls-row">
        <div id="league-multi-select"></div>
    </div>
    <div class="controls-row">
        <div id="event-multi-select"></div>
    </div>
    <div class="controls-row">
        <button class="btn btn-primary" type="submit" id="btnSubmit">
            @Las.Submit
        </button>
    </div>
    <div class="controls-row refresh-count-down-area">        
        <div class="refresh-count-down" id="refresh-count-down">
            
        </div>        
        <input type="hidden" value="15" id="server-time-interval" />
    </div>
}

<div class="wrapper">
    <div id="grid" class="freegrid">
    </div>
</div>