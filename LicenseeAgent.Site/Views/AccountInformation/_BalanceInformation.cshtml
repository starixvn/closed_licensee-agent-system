@using LicenseeAgent.AccountInformation.Entities
@using LicenseeAgent.AccountInformation.ViewModels
@model SearchUserResultViewModel
@{
    var balance = Model.Balance;
    var customer = Model.Customer;
    var pageContext = (PageContext)ViewBag.PageContext;
}
<table class="table table-condensed">
    <tbody>
        @if (pageContext.IsMember)
        {
            <tr>
                <td>@Las.TotalBalance
                </td>
                <td>@RazorHelper.FormatNegative(balance.TotalBalance)
                </td>
            </tr>
            <tr>
                <td>@Las.YesterdayBalance
                </td>
                <td>@RazorHelper.FormatNegative(balance.YesterdayBalance)
                </td>
            </tr>
            <tr>
                <td>@Las.Outstanding
                </td>
                <td>@RazorHelper.FormatNegative(balance.Outstanding)
                </td>
            </tr>
            <tr>
                <td>@Las.GivenCredit
                </td>
                @if (pageContext.IsDirectDownline.HasValue && pageContext.IsDirectDownline.Value)
                {
                    <td>
                        <a href="javascript:accountInformation.agentEditMemberCredit(@customer.CustId, '@customer.UserName', @balance.GivenCredit);">@RazorHelper.FormatNegative(balance.GivenCredit)</a>
                    </td>
                }
                else
                {
                    <td>@RazorHelper.FormatNegative(balance.GivenCredit)
                    </td>
                }
            </tr>
            <tr>
                <td>@Las.BetCredit
                </td>
                <td>@RazorHelper.FormatNegative(balance.BetCredit)
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td>@Las.TotalCash
                </td>
                <td>@RazorHelper.FormatNegative(balance.TotalCash)
                </td>
            </tr>
            <tr>
                <td>@Las.YesterdayCash
                </td>
                <td>@RazorHelper.FormatNegative(balance.YesterdayCash)
                </td>
            </tr>
            <tr>
                <td>@Las.TotalBalance
                </td>
                <td>@RazorHelper.FormatNegative(balance.TotalBalance)
                </td>
            </tr>
            <tr>
                <td>@Las.YesterdayBalance
                </td>
                <td>@RazorHelper.FormatNegative(balance.YesterdayBalance)
                </td>
            </tr>
            <tr>
                <td>@Las.AgentOutstanding
                </td>
                <td>@RazorHelper.FormatNegative(balance.Outstanding)
                </td>
            </tr>
            <tr>
                <td>@Las.TotalOutstanding
                </td>
                <td>@RazorHelper.FormatNegative(balance.TotalOutstanding)
                </td>
            </tr>
            <tr>
                <td>@Las.GivenCredit
                </td>
                @if (pageContext.IsDirectDownline.HasValue && pageContext.IsDirectDownline.Value)
                {
                    <td>
                        <a href="javascript:accountInformation.editAgentCredit(@customer.CustId, '@customer.UserName', @customer.Level, @balance.GivenCredit);">@RazorHelper.FormatNegative(Convert.ToInt64(balance.GivenCredit))</a>
                    </td>
                }
                else
                {
                    <td>@RazorHelper.FormatNegative(Convert.ToInt64(balance.GivenCredit))
                    </td>
                }
            </tr>
            <tr>
                <td>@Las.UsedCredit
                </td>
                <td>@RazorHelper.FormatNegative(Convert.ToInt64(balance.UsedCredit))
                </td>
            </tr>

        }
    </tbody>
</table>