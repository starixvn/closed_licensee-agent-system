@using LicenseeAgent.BetList.Entities
@using LicenseeAgent.BetList.ViewModels
@using Fanex.BetList.Core.Entities
@model DetailsViewModel
@{
    Layout = null;
}
<table class="bet-list-details">
    <thead>
        <tr>
            <th style="width: 100px">
                @Las.Agent
            </th>
            <th style="width: 120px">
                @Las.PositionTaking
            </th>
            @if (!Model.IsDeposit)
            {
                <th style="width: 120px">
                    @Las.Commission
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @{var rowIndex = 1;}
        @foreach (var detail in Model.TicketDetails)
        {
            <tr class="@(rowIndex % 2 == 0 ? "even-row" : "")">
                <td class="agent-name">
                    @detail.AgentName
                </td>
                <td>
                    @GeneratePositionTaking(detail)
                </td>
                @if (!Model.IsDeposit)
                {
                    <td>
                        @GenerateCommission(detail)
                    </td>
                }
            </tr>
                rowIndex++;
        }
    </tbody>
</table>
@helper GeneratePositionTaking(TicketDetail detail)
    {
    <div>
        @string.Format("{0:#,##0.00} %", detail.AgentPTPercent * 100)
    </div>
    <div>
        @if (Model.Status != BetStatus.Running && Model.Status != BetStatus.Waiting)
        {
            var className = detail.AgentPT >= 0 ? string.Empty : "red-text";
            <div class="@className">
                @string.Format("{0:#,##0.00}", detail.AgentPT)
            </div>
        }
    </div>
}
@helper GenerateCommission(TicketDetail detail)
    {
        if (detail.AgentLevel != 1)
        {
    <div>
        @string.Format("{0:#,##0.00} %", detail.AgentCommPercent * 100)
    </div>
        }
        if (Model.Status != BetStatus.Running || Model.Status != BetStatus.Waiting)
        {
            var className = detail.AgentComm >= 0 ? string.Empty : "red-text";
    <div class="@className">
        @string.Format("{0:#,##0.00}", detail.AgentComm)
    </div>
        }
        else if (detail.AgentLevel == 1)
        {
    @Html.Raw("-")
        }
}