@model StatementDetailReportViewModel
@{
    ViewBag.Title = Las.StatementDetails + " - " + Las.Report;
}
@section css
{
    @Styles.Render("~/css/datetimepicker")
    @Styles.Render("~/css/fanexgrid")
}
@section scripts
{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/datetimepicker")
    @Scripts.Render("~/js/report/statement")
    <script type="text/javascript">
        $(function () {
            REPORT.STATEMENT.DETAIL.init();
        });
    </script>
}
<div class="legend">
    @ViewBag.Title
</div>
@using (Html.BeginForm(null, null, FormMethod.Post,
    new { @class = "form-filter form-inline", id = "search-form" }))
{
    <div class="controls-row">
        @Html.LabelFor(m => m.FromDate)
        @Html.DatePickerFor(m => m.FromDate)
    </div>
    <div class="controls-row">
        @Html.LabelFor(m => m.ToDate)
        @Html.DatePickerFor(m => m.ToDate)
    </div>
    <div class="controls-row">
        @if (Model.HideUsername)
        {
            @Html.HiddenFor(m => m.Username)
        }
        else
        {
            @Html.LabelFor(m => m.Username)
            <div class="input-append">
                @Html.TextBoxFor(m => m.Username, new { @class = "span2" })
            </div>
        }
        <button class="btn btn-primary marginleft" id="search">@Las.Generate</button>
    </div>
    @Html.HiddenFor(m => m.AgentLevel)
    @Html.HiddenFor(m => m.IsMember)
    @Html.HiddenFor(m => m.Product)
}
@if (Model.ShowBackButton)
{
    <div class="clearfix">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("Index", new { FromDate = Model.FromDate, ToDate = Model.ToDate })">
                @Las.Main
            </a><span class="divider">>></span></li>
            <li><span id="spanUsername">@Model.Username</span> </li>
        </ul>
    </div>
}
<div id="grid" class="freegrid">
</div>