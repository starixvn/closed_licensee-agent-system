<?xml version="1.0" encoding="utf-8"?>
<SoccerDetail
  TotalColumn="3"
  xmlns="SoccerDetailConfiguration"
  xmlns:xsi="SoccerDetailConfiguration">
  <Group>
    <!--Odd/Even-->
    <Table BetType="2">
      <Row BetTeam="h" />
      <Row BetTeam="a" />
    </Table>
    <!--Money Line-->
    <Table BetType="20">
      <Row BetTeam="h" />
      <Row BetTeam="a" />
    </Table>
    <!--Draw / No Draw-->
    <Table BetType="123">
      <Row BetTeam="h" />
      <Row BetTeam="a" />
    </Table>
  </Group>
  <Group>
    <!--Home No Bet-->
    <Table BetType="121">
      <Row BetTeam="a" />
      <Row BetTeam="x" />
    </Table>
    <!--Away No Bet-->
    <Table BetType="122">
      <Row BetTeam="h" />
      <Row BetTeam="x" />
    </Table>
    <!--Draw No Bet-->
    <Table BetType="25">
      <Row BetTeam="h" />
      <Row BetTeam="a" />
    </Table>
  </Group>
  <Group>
    <!--Double Chance-->
    <Table BetType="24">
      <Row BetTeam="1x" />
      <Row BetTeam="12" />
      <Row BetTeam="2x" />
    </Table>
    <!--Both/One/Neither Team To Score-->
    <Table BetType="26">
      <Row BetTeam="b" />
      <Row BetTeam="o" />
      <Row BetTeam="n" />
    </Table>
    <!--3-Way Handicap-->
    <Table BetType="28">
      <Row BetTeam="1" />
      <Row BetTeam="x" />
      <Row BetTeam="2" />
    </Table>
  </Group>
  <Group>
    <!--Clean Sheet-->
    <Table BetType="13" NumberOfColumn="2">
      <Row BetTeam="hy" />
      <Row BetTeam="ay" />
      <Row BetTeam="hn" />
      <Row BetTeam="an" />
    </Table>
    <!--To Win To Nil-->
    <Table BetType="27">
      <Row BetTeam="h" />
      <Row BetTeam="a" />
    </Table>
  </Group>
  <Group>
    <!--1H Total Goal-->
    <Table BetType="126" NumberOfColumn="2">
      <Row BetTeam="0-1" />
      <Row BetTeam="4-over" />
      <Row BetTeam="2-3" ColSpan="2" />
    </Table>
  </Group>
  <Group>
    <!--Total Goal-->
    <Table BetType="6" NumberOfColumn="2">
      <Row BetTeam="0-1" />
      <Row BetTeam="4-6" />
      <Row BetTeam="2-3" />
      <Row BetTeam="7-over" />
    </Table>
  </Group>
  <Group>
    <!--1H First Goal / Last Goal-->
    <Table BetType="127" NumberOfColumn="3">
      <Row BetTeam="1:1" />
      <Row BetTeam="2:1" />
      <Row BetTeam="0:0" />
      <Row BetTeam="1:2" />
      <Row BetTeam="2:2" ColSpan="2" />
    </Table>
  </Group>
  <Group>
    <!--First Goal / Last Goal-->
    <Table BetType="14" NumberOfColumn="3">
      <Row BetTeam="1:1" />
      <Row BetTeam="2:1" />
      <Row BetTeam="0:0" />
      <Row BetTeam="1:2" />
      <Row BetTeam="2:2" ColSpan="2" />
    </Table>
  </Group>
  <Group>
    <!--Half Time / Fulltime-->
    <Table BetType="16" NumberOfColumn="3">
      <Row BetTeam="1:1" />
      <Row BetTeam="2:1" />
      <Row BetTeam="0:1" />
      <Row BetTeam="1:0" />
      <Row BetTeam="2:0" />
      <Row BetTeam="0:0" />
      <Row BetTeam="1:2" />
      <Row BetTeam="2:2" />
      <Row BetTeam="0:2" />
    </Table>
  </Group>
  <Group>
    <!--Correct Score-->
    <Table BetType="4" NumberOfColumn="3">
      <Row BetTeam="1:0" />
      <Row BetTeam="0:1" />
      <Row BetTeam="0:0" />
      <Row BetTeam="2:0" />
      <Row BetTeam="0:2" />
      <Row BetTeam="1:1" />
      <Row BetTeam="2:1" />
      <Row BetTeam="1:2" />
      <Row BetTeam="2:2" />
      <Row BetTeam="3:0" />
      <Row BetTeam="0:3" />
      <Row BetTeam="3:3" />
      <Row BetTeam="3:1" />
      <Row BetTeam="1:3" />
      <Row BetTeam="4:4" />
      <Row BetTeam="3:2" />
      <Row BetTeam="2:3" ColSpan="2" />
      <Row BetTeam="4:0" />
      <Row BetTeam="0:4" ColSpan="2" />
      <Row BetTeam="4:1" />
      <Row BetTeam="1:4" ColSpan="2" />
      <Row BetTeam="4:2" />
      <Row BetTeam="2:4" ColSpan="2" />
      <Row BetTeam="4:3" />
      <Row BetTeam="3:4" ColSpan="2" />
      <Row BetTeam="5:0" />
      <Row BetTeam="0:5" ColSpan="2" />
    </Table>
  </Group>
  <Group>
    <!--HT Correct Score-->
    <Table BetType="30" NumberOfColumn="3">
      <Row BetTeam="1:0" />
      <Row BetTeam="0:1" />
      <Row BetTeam="0:0" />
      <Row BetTeam="2:0" />
      <Row BetTeam="0:2" />
      <Row BetTeam="1:1" />
      <Row BetTeam="2:1" />
      <Row BetTeam="1:2" />
      <Row BetTeam="2:2" />
      <Row BetTeam="3:0" />
      <Row BetTeam="0:3" />
      <Row BetTeam="3:3" />
      <Row BetTeam="3:1" />
      <Row BetTeam="1:3" ColSpan="2" />
      <Row BetTeam="3:2" />
      <Row BetTeam="2:3" ColSpan="2" />
      <Row BetTeam="4:0" />
      <Row BetTeam="0:4" ColSpan="2" />
    </Table>
  </Group>
</SoccerDetail>