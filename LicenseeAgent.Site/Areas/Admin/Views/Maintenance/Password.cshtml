@{
    ViewBag.Title = "Encrypt / Decrypt Password";
}
@section scripts
{
    @Scripts.Render("~/js/admin/maintenance")
    <script type="text/javascript">
        $(function () {
            ADMIN.MAINTENANCE.PASSWORD.init();
        });
    </script>
}
<div class="legend">
    @ViewBag.Title
</div>
<div class="table">
    <div class="form-group">
        <label for="password">
            @Las.Password
        </label>
        <input type="text" class="form-control" id="password" />
    </div>
    <div class="form-group">
        <label for="encodepassword">
            Encrypted Password
        </label>
        <input type="text" class="form-control" id="encodepassword" />
    </div>
    <button type="button" class="btn btn-primary" id="encode" data-url="@Url.Action("PasswordEncode")">
        Encrypt
    </button>
    <button type="button" class="btn btn-primary" id="decode" data-url="@Url.Action("PasswordDecode")">
        Decrypt
    </button>
</div>