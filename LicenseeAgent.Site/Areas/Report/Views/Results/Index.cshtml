@model ResultsViewModel
@{
    ViewBag.Title = Las.Results + " - " + Las.Report;
}
@section css
{
    @Styles.Render("~/css/datetimepicker")
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/report/results")
}
@section scripts
{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/datetimepicker")
    @Scripts.Render("~/js/report/results")
    <script type="text/javascript">
        $(function () {
            report.results.init();
        });
    </script>
}
<div class="legend">
    @ViewBag.Title
</div>
<div id="filter-tabs" class="filter-tabs">
    <ul id="tabs-area" class="nav nav-tabs">
        <li class="active"><a href="#filter-tab-match" data-toggle="tab">@Las.MatchResults</a></li>
        <li><a href="#filter-tab-outright" data-toggle="tab">@Las.OutrightResults</a></li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="filter-tab-match">
            @Html.Partial("_Match", Model.MatchResults)
        </div>
        <div class="tab-pane" id="filter-tab-outright">
            @Html.Partial("_Outright", Model.OutrightResults)
        </div>
    </div>
</div>
<div id="ResultsArea">
</div>