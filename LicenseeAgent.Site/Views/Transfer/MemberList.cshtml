<script type="text/javascript">
    var gridOption = {
        columns: [
                        {
                            HeaderText: '<i class="icon-uncheck-all" onclick="TRANSFER_LIST.toggleCheck(this);"></i><i id="select-dropdown" class="icon-arrow"></i>',
                            Width: 30, Name: "Select", CellAlign: "center",
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return '<span class="cell-select icon icon-uncheck" onclick="TRANSFER_LIST.selectClick(this);"></span>';
                            }
                        },
                        {
                            HeaderText: "#", Width: 30, Name: "AgentId", CellAlign: "center"
                        },
                        {
                            HeaderText: "@Las.Username", Width: 100, Name: "UserName", HeaderAlign: "center", allowTruncate: true
                        },
                        {
                            HeaderText: "@Las.CustomerName", Width: 125, Name: "CustomerName", HeaderAlign: "center", allowTruncate: true,
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                if (rowData.FirstName == null || rowData.LastName == null) {
                                    return '---';
                                }
                                return '{0} {1}'.format(rowData.FirstName, rowData.LastName);
                            }
                        },
                        {
                            HeaderText: "@Las.Status", Width: 55, Name: "Status", HeaderAlign: "center", CellAlign: "center",
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return cell.Value == 1
                                ? '<div class="account-status-open">' + LANGUAGE.getString('Open') + '</div>'
                                : '<div class="account-status-closed">' + LANGUAGE.getString('Closed') + '</div>';
                            }
                        },
                        {
                            HeaderText: "@Las.YesterdayBalance", Width: 80, Name: "YesterdayBalance", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', MergeHeaderColNumber: 2, CanResize: true
                        },
                        {
                            HeaderText: "", Width: 20, Name: "TransferIcon", CellAlign: "center",
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return '<i class="icon-transfer" onclick="TRANSFER_LIST.transferMember({0}, \'{1}\', {2})"></i>'.format(rowData.CustId, -rowData.YesterdayBalance);
                            }
                        },
                        {
                            HeaderText: "@Las.TotalBalance", Width: 80, Name: "TotalBalance", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', CanResize: true
                        },
                        {
                            HeaderText: "@Las.Outstanding", Width: 80, Name: "Outstanding", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', CanResize: true
                        },
                        {
                            HeaderText: "@Las.GivenCredit", Width: 80, Name: "GivenCredit", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.", CanResize: true
                        }
                   ],
        showPager: true,
        gridExpandHeight: 100,
        indexNumberColumn: 1,
        bodyRowHeight: 29,
        autoResizeColumn: true
    };
</script>