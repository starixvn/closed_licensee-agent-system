@model LicenseeAgent.Report.ViewModels.AgentWinLossReportViewModel
<script type="text/javascript">
    var gridOptions = {
        customizeHeader: true,
        groupHeaderRows: [
            {
                Columns: [
                        { HeaderText: "@Las.Member", Name: "Username", MergeRowNumber: 2 },
                        { HeaderText: "@Las.Member", Name: "BetCount", MergeColNumber: 5 },
                        { HeaderText: "@Model.UserName", Name: "AWinLost", MergeColNumber: 3, ThClass: 'alter-column' },
                        { HeaderText: "@Las.Upline", Name: "UplineStake", MergeColNumber: 2 }
                    ]
            }
        ],
        columns: [
                    { HeaderText: "@Las.Agent", Width: 100, Name: "Username", HeaderAlign: "center", CellAlign: "left",
                        Formatter: function (rowIndex, rowData, cell, cellFormated) {
                            return ("<a href='javascript:agentWinLossReport.ViewBetList({0}, {1}, \"{2}\");'>" + cell.Value + "</a>").format(rowData.CustId, rowData.AgentLevel, cell.Value);
                        }
                    },
                    { HeaderText: "@Las.BetCount", Width: 70, Name: "BetCount", HeaderAlign: "center", CellAlign: "right", AllowTruncate: true },
                    { HeaderText: "@Las.Turnover", Width: 100, Name: "Turnover", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "@Las.WinLoss", Width: 100, Name: "Winlost", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "@Las.Commission", Width: 100, Name: "PlayerComm", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "@Las.Total", Width: 100, Name: "MemberTotal", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "@Las.WinLoss", Width: 100, Name: "AWinLost", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', ThClass: 'alter-column' },
                    { HeaderText: "@Las.Commission", Width: 100, Name: "AComm", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', ThClass: 'alter-column' },
                    { HeaderText: "@Las.Total", Width: 100, Name: "ATotal", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', ThClass: 'alter-column' },
                    { HeaderText: "@Las.EffectiveTurnover", Width: 100, Name: "UplineStake", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "@Las.Total", Width: 100, Name: "UplineTotal", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00" }
                ],
        gridExpandHeight: 225,
        showNumberColumn: false,
        showFooter: true,
        footerRows: [
            {
                Columns: [
                    { Value: language.getString("Total"), Name: "Username", CellAlign: "center" },
                    { Value: total.BetCount, Name: "BetCount" },
                    { Value: total.Turnover, Name: "Turnover" },
                    { Value: total.Winlost, Name: "Winlost" },
                    { Value: total.PlayerComm, Name: "PlayerComm" },
                    { Value: total.MemberTotal, Name: "MemberTotal" },
                    { Value: total.AWinLost, Name: "AWinLost" },
                    { Value: total.AComm, Name: "AComm" },
                    { Value: total.ATotal, Name: "ATotal" },
                    { Value: total.UplineStake, Name: "UplineStake" },
                    { Value: total.UplineTotal, Name: "UplineTotal" }
                ]
            }
        ],
        autoResizeColumn: true
    };
</script>