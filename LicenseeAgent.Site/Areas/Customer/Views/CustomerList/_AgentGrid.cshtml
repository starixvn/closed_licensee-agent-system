<script type="text/javascript">
    var gridOptions = {
        columns: [
                        /*{
                            HeaderText: '<i class="icon-uncheck-all" onclick="customer.customerList.checkAllItem(this);"></i><i id="select-dropdown" class="icon-arrow"></i>',
                            Width: 30, Name: "Select", CellAlign: "center",
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return '<span class="cell-select icon icon-uncheck" onclick="customer.customerList.selectClick(this);"></span>';
                            }
                        },*/
                        {
                            HeaderText: "#", Width: 30, Name: "AgentId", CellAlign: "center", CanResize: false
                        },
                        {
                            HeaderText: "@Las.Action", Width: 35, Name: "Action", HeaderAlign: "center", CellAlign: "center", CanResize: false,
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return '<i id="{0}" class="icon-customer-edit" data-agentid="{0}" data-agentlevel="{1}" data-status="{2}"></i>'.format(rowData.AgentId, rowData.AgentLevel, rowData.Status);
                            }
                        },
                        {
                            HeaderText: "@Las.Username", Width: 100, Name: "UserName", HeaderAlign: "center", AllowTruncate: true, MaxResizeWidth: 200
                        },
                        {
                            HeaderText: "@Las.Status", Width: 65, Name: "Status", HeaderAlign: "center", CellAlign: "center", CanResize: false,
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return '<div class="cust-status" onclick="customer.customerList.changeStatus(this, ' + rowData.AgentId + ')">'
                                    + (cell.Value == 1 ? '<div class="icon-status-open"><span>Open</span></div>' : '<div class="icon-status-closed"><span>Closed</span></div>')
                                    + '</div>';
                            }
                        },
                        {
                            HeaderText: "@Las.Downline", Width: 60, Name: "NumberOfAgent", HeaderAlign: "center", CellAlign: "center", CanResize: false,
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                if (cell.Value == 0) {
                                    return '<span class="downline">' + cell.Value + '</span>';
                                }
                                return '<span class="downline"><a href="javascript:void(0);" onclick="javascript:customer.customerList.showAgent(\'' + rowData.AgentId + '\',\'' + rowData.UserName + '\',' + rowData.AgentLevel + ', false);">' + cell.Value + '</a></span>';
                            }
                        },
                        {
                            HeaderText: "@Las.DirectMember", Width: 60, Name: "NumberOfMember", HeaderAlign: "center", CellAlign: "center", CanResize: false,
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                if (cell.Value == 0) {
                                    return '<span class="downline">' + cell.Value + '</span>';
                                }
                                return '<span class="downline"><a href="javascript:void(0);" onclick="javascript:customer.customerList.showAgent(\'' + rowData.AgentId + '\',\'' + rowData.UserName + '\',' + rowData.AgentLevel + ', true);">' + cell.Value + '</a></span>';
                            }
                        },
                        {
                            HeaderText: "@Las.FullName", Width: 200, Name: "CustomerName", HeaderAlign: "center", AllowTruncate: true, MaxResizeWidth: 300
                        },
                        {
                            HeaderText: "@Las.CreatedDate", Width: 140, Name: "CreatedDate", HeaderAlign: "center", CellAlign: "center", CanResize: false, FormatDateTime: core.DATE_FORMAT_FULL
                        },
                        {
                            HeaderText: "@Las.LoginIp", Width: 100, Name: "IpLogin", HeaderAlign: "center", CellAlign: "center", CanResize: false,
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                if (cell.Value == null)
                                    return '';
                                return '<a onclick=customer.customerList.getIpInformation("{0}")>{1}</a>'.format(cell.Value, cell.Value);
                            }
                        }
                   ],
        showPager: true,
        customPager: true,
        gridExpandHeight: 125,
        indexNumberColumn: 0,
        bodyRowHeight: 29,
        autoResizeColumn: true
    };
</script>