@helper TopMenu(string text, string url, string id = null, bool isActive = false)
    {
        if (isActive)
        {
    <li class="active"><a id="@id" target="frmMain" href="@url">@text</a> </li>
        }
        else
        {
    <li><a id="@id" target="frmMain" href="@url">@text</a></li>
        }
}
@helper LeftMenu(string text, string url)
    {
    <li><a target="frmMain" href="@url"><i class="icon-nav-arrow"></i>@text</a></li>
}