@using LicenseeAgent.Core.Entities
@using LicenseeAgent.Web.Entities
@model PageContext
<script type="text/javascript">
    var gridOptions = {
        columns:
            [
                {
                    HeaderText: "#", Width: 30, Name: "CustId", CellAlign: "center", CanResize: false
                },
                {
                    HeaderText: "@Las.Action", Width: 35, Name: "Action", HeaderAlign: "center", CellAlign: "center", CanResize: false,
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return '<i class="icon-customer-edit" data-memberid="{0}" data-username="{1}"></i>'.format(rowData.CustId, rowData.UserName);
                    }
                },
                @if (Model.IsAdmin)
                {
                    <text>
                    { HeaderText: "@Las.SystemId", Width: 140, Name: "SystemId", Formatter:
                        function (rowIndex, rowData, cell, cellFormated) {
                            return '<span title="' + rowData.SystemId + '">' + cell.Value + '</span>';
                        }
                    },
                    </text>
                }
                {
                    HeaderText: "@Las.Username", Width: 100, Name: "UserName", HeaderAlign: "center", AllowTruncate: true, MaxResizeWidth: 200
                },
                { HeaderText: "@Las.Status", Width: 65, Name: "Status", HeaderAlign: "center", CellAlign: "center", CanResize: false,
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return '<div class="cust-status" onclick="customerList.changeStatus(this, ' + rowData.CustId + ')">'
                            + (cell.Value == 1 ? '<div class="icon-status-open"><span>Open</span></div>' : '<div class="icon-status-closed"><span>Closed</span></div>')
                            + '</div>';
                    }
                },
                @if(SessionManager.CurrentSession.AgentInfo.IsAllowedMemberComm)
                {
                    <text>
                    { HeaderText: "@Las.CommGroup", Width: 80, Name: "GroupName", HeaderAlign: "center", CellAlign: "center", MaxResizeWidth: 160 },
                    </text>
                }
                {
                    HeaderText: "@Las.AvailableFund", Width: 80, Name: "AvailableFund", HeaderAlign: "center", CellAlign: "center", AllowTruncate: true, MaxResizeWidth: 160,
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return core.formatCommissionPercent(cell.Value);
                    }
                },
                {
                    HeaderText: "@Las.PendingFund", Width: 80, Name: "PendingFund", HeaderAlign: "center", CellAlign: "center", AllowTruncate: true, MaxResizeWidth: 160,
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return core.formatCommissionPercent(cell.Value);
                    }
                },
                { HeaderText: "@Las.CreatedDate", Width: 140, Name: "CreatedDate", HeaderAlign: "center", CellAlign: "center", CanResize: false, FormatDateTime: core.DATE_FORMAT_FULL },
                { HeaderText: "@Las.LoginIp", Width: 100, Name: "IpLogin", HeaderAlign: "center", CellAlign: "center", CanResize: false,
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        if (cell.Value == null)
                            return '';
                        return '<a onclick=customerList.getIpInformation("{0}")>{1}</a>'.format(cell.Value, cell.Value);
                    }
                }
            ],
        showPager: true,
        customPager: true,
        gridExpandHeight: 125,
        indexNumberColumn: 0,
        bodyRowHeight: 29,
        autoResizeColumn: true
    };
</script>