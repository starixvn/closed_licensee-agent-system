@using LicenseeAgent.Core.Enumerations
@using LicenseeAgent.Core.Utility
@using LicenseeAgent.Web.ViewModels
@using LicenseeAgent.Web.Entities
@model AgentBreadcrumbViewModel
@{
    var pageContext = (PageContext)ViewBag.PageContext;
    if (pageContext.IsLastLevel || pageContext.IsMember)
    {
        ViewBag.Title = Las.MemberList;
    }
    else
    {
        ViewBag.Title = Las.AgentList;
    }
}
@section css{
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/customer")
}
@section scripts{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/contextmenu")
    @Scripts.Render("~/js/customer")
    
    <script type="text/javascript">
        $(function () {
            customer.customerList.init();
        });
    </script>
    @if (pageContext.IsLastLevel || pageContext.IsMember)
    {
        @Html.Partial(SessionManager.CurrentSession.AgentInfo.IsCredit ? "_MemberGrid" : "_MemberGridDeposit", pageContext)
    }
    else
    {
        @Html.Partial("_AgentGrid")
    }
}
<div class="legend">
    @ViewBag.Title
</div>
@using (Html.BeginForm("Index", "CustomerList", FormMethod.Post, new { id = "ajax-form", @class = "hide" }))
{
    @Html.HiddenFor(m => m.AgentId, new { id = "newAgentId" })
    @Html.HiddenFor(m => m.AgentName)
    @Html.HiddenFor(m => m.AgentLevel)
    @Html.HiddenFor(m => m.Breadcrumb)
    @Html.HiddenFor(m => m.IsMember)
}
@using (Html.BeginForm("GetCustomerList", "CustomerList", FormMethod.Post,
    new { @class = "form-inline form-filter ", id = "search-form" }))
{
    @Html.HiddenFor(m => m.AgentId)
    @Html.HiddenFor(m => m.AgentLevel)
    <div class="controls-row">
        @Html.Label("Username", Las.Username)
        @Html.TextBox("Username", string.Empty, new { @class = "w160", @placeholder = @Las.Username, @autocomplete = "off" })
    </div>
    <div class="controls-row">
        @Html.Label("Status", Las.Status)
        @Html.DropDownList("Status", ModelSettings.StatusList, new { @class = "selectpicker w100" })
    </div>
    <div class="controls-row">
        <button class="btn btn-primary" type="submit">
            @Las.Submit
        </button>
    </div>
}
@Html.Partial("_Breadcrumb")
<div id="grid" class="freegrid">
</div>