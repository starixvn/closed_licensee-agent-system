@using LicenseeAgent.Core.Enumerations
@model TopMenu
@{
    var sessionWrapper = new SessionWrapper(SessionManager.CurrentSession);
}
@if (SessionManager.CurrentSession.AgentInfo != null)
{
    <ul class="nav nav-pills">
        @BootstrapHelper.TopMenu(Las.Home, Url.Action("Index", "Account"), "menuHome", Model == TopMenu.Home)
        @BootstrapHelper.TopMenu(Las.Transfer, Url.Action("Index", "Account"), "menuTransfer", Model == TopMenu.Transfer)
        @if (sessionWrapper.IsViewChangePassword)
        {
            @BootstrapHelper.TopMenu(Las.Security, Url.Action("ChangePassword", "Account"), "menuSecurity", Model == TopMenu.Security)    
        }
        @BootstrapHelper.TopMenu(Las.ViewLog, Url.Action("Index", "BetList"), "menuViewlog", Model == TopMenu.ViewLog)
    </ul>
}
@if (sessionWrapper.IsViewSelectMenu)
{
    @Html.Action("SelectMenu", "Internal")
}