@model SoccerDetailViewModel
@{
    ViewBag.Title = Model.MatchName;
    var backLink = Url.Action("Index", "Soccer", new SoccerViewModel
    { 
        SelectedLeagues = Model.SelectedLeagues, 
        SelectedEvents = Model.SelectedEvents, 
        TimeInterval = Model.TimeInterval, 
        CheckAllLeague = Model.CheckAllLeague, 
        CheckAllEvent = Model.CheckAllEvent 
    });
    var soccerDetailConfiguration = SettingConfigurations.SoccerDetailConfiguration;
}
@section css{
    @Styles.Render("~/css/totalbets")
}
@section scripts{
    @Scripts.Render("~/js/totalbets")
}
@functions{
    string GetDetailValue(int betType, string betTeam)
    {
        var item = Model.MainData.Where(x => x.BetType == betType && x.BetTeam == betTeam);
        return item.Any() ? item.FirstOrDefault().TotalBetsText : string.Empty;
    }
}
<div class="legend">
    @ViewBag.Title
    <span onclick="javascript:location.href='@backLink'" class="history-back"><i class="icon-history-back">
    </i>
        @Las.Back
    </span>
</div>
@foreach (var group in soccerDetailConfiguration.Group)
{
    <div class="row-fluid">
        @foreach (var table in group.Table)
        {
            var tableClass = string.Format("colspan{0}", table.NumberOfColumn);
            var totalColumn = table.NumberOfColumn * 2 + table.NumberOfColumn - 1;
            var totalRow = table.Row.Select(x => x.ColSpan).Sum() / table.NumberOfColumn;
            var rowIndex = 0;
            
            <div class="@tableClass">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th colspan="@totalColumn">
                                @DataRefWrapper.GetBetTypeName(table.BetType)
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in table.Row)
                        {
                            var ratio = rowIndex % table.NumberOfColumn;
                            if (ratio == 0)
                            {
                                @: <tr>
                            }
                            <td>
                                @DataRefWrapper.GetBetTeamName(table.BetType, row.BetTeam)
                            </td>
                            <td class="text-right">
                                <span class="data-link" onclick="totalBets.soccer.detail.showBetList(@Model.MatchId, @table.BetType, '@row.BetTeam')">
                                    @GetDetailValue(table.BetType, row.BetTeam)
                                </span>
                            </td>
                            if (rowIndex < table.NumberOfColumn - 1)
                            { 
                                <td rowspan="@totalRow" class="column-splitter">
                                </td>
                            }
                            if (row.ColSpan > 1)
                            { 
                                <td colspan="@row.ColSpan">
                                </td>
                            }
                            if (ratio == table.NumberOfColumn - 1)
                            {
                                @: </tr>
                            }
                            rowIndex += row.ColSpan;
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}