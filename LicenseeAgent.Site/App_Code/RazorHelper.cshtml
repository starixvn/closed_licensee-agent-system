@using System.Web.Mvc
@using LicenseeAgent.Web.Mvc
@using LicenseeAgent.Core
@using LicenseeAgent.Core.Configurations
@using LicenseeAgent.Resources
@using LicenseeAgent.AccountInformation.Entities
@using LicenseeAgent.Core.Entities
@using LicenseeAgent.Core.Utility
@using LicenseeAgent.Report.Enumerations
@using LicenseeAgent.CustomerSetting.Entities
@helper FormatNegative(decimal value)
    {
        var className = value < 0 ? "number-negative" : string.Empty;
    <span class="@className">@LicenseeAgent.Core.Utility.Formatter.FormatDecimal(value)</span>
}
@helper FormatNegative(long value)
    {
        var className = value < 0 ? "number-negative" : string.Empty;
    <span class="@className">@LicenseeAgent.Core.Utility.Formatter.FormatInt(value)</span>
}
@helper BreadCrumb(string val)
    {
        if (string.IsNullOrEmpty(val))
        {
            return;
        }
        var listBreadCrumb = val.Split(';');
        var length = listBreadCrumb.Length;
        if (length > 1)
        {
    <div class="clearfix">
        <ul class="breadcrumb">
            @foreach (var item in listBreadCrumb)
            {
                var agentInfo = item.Split(',');
                <li>
                    @if (string.Compare(item, listBreadCrumb[length - 1]) != 0)
                    {
                        <a href="#" data-agent-id="@agentInfo[0]" data-agent-level="@agentInfo[1]">@agentInfo[2]</a>
                        <span class="divider">>></span>
                    }
                    else
                    {
                        <span>@agentInfo[2]</span>
                    }
                </li>
            }
        </ul>
    </div>
        }
}
@helper Legend(string title)
    {
    <div class="legend @(Request.IsPopup() ? "popup" : "")">
        @title
    </div>
}
@helper GroupCommision(IList<GroupCommission> groupCommissions, int selectedGroup = 0, bool haveAll = true, string className = "")
    {
    <select id="GroupCommId" name="GroupCommId" class="@className">
        @if (haveAll)
        {
            <option value="-1">@Las.All</option>
            <option value="0">@Las.None</option>
        }
        else
        {
            <option value="">@Las.SelectGroup</option>
        }
        @foreach (var group in groupCommissions)
        {
            <option @(selectedGroup == group.GroupCommId ? "selected=selected" : string.Empty) value="@group.GroupCommId">@group.GroupName</option>
        }
    </select>
}
@helper ProductCommission(IEnumerable<int> range, string id, string className, int selectedValue = 0, string id2 = "", string id3 = "")
    {
    <select id="@id" name="@id" class="@className" @(string.IsNullOrEmpty(id2) ? string.Empty : "data-comm2=" + id2) @(string.IsNullOrEmpty(id3) ? string.Empty : "data-comm3=" + id3)>
        @foreach (var value in range)
        {
            <option value="@value" @(value == selectedValue ? "selected" : string.Empty)>@value</option>
        }
    </select>
}