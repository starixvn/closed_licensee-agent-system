@model IList<UpLineEntity>
<table class="dropdown">
    <colgroup>
        <col width="80" />
        <col width="80" />
    </colgroup>
    <thead>
        <tr>
            <th>
                @Las.Level
            </th>
            <th>
                @Las.Username
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entity in Model)
        {
            <tr>
                <td>
                    @string.Format(Las.AgentLevelFormat, entity.Level - 1)
                </td>
                <td>
                    <a class="agent-inline" href="#" title="@entity.UserName" onclick="home.accountInformation.search('@entity.UserName')">
                        @entity.MediumUserName
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>