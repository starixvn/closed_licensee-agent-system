@using LicenseeAgent.Core.Utility
@using LicenseeAgent.Account.Entities
@model BalanceInfoEntity
<div class="legend">@Las.BalanceInfo</div>
<table>
    <tbody>
        <tr>
            <td>@Las.Agent
            </td>
            <td>@Model.AgentName
            </td>
        </tr>
        <tr>
            <td>@Las.Currency
            </td>
            <td>@Model.CurrencyName
            </td>
        </tr>
        <tr>
            <td>@Las.TotalCash
            </td>
            <td>@RazorHelper.FormatNegative(Model.TotalCash)
            </td>
        </tr>
        <tr>
            <td>@Las.YesterdayCash
            </td>
            <td>@RazorHelper.FormatNegative(Model.YesterdayCash)
            </td>
        </tr>
        <tr>
            <td>@Las.TotalBalance
            </td>
            <td>@RazorHelper.FormatNegative(Model.TotalBalance)
            </td>
        </tr>
        <tr>
            <td>@Las.YesterdayBalance
            </td>
            <td>@RazorHelper.FormatNegative(Model.YesterdayBalance)
            </td>
        </tr>
        <tr>
            <td>@Las.TodayWinLoss (@Model.Today.ToString("MM/dd/yyyy"))
            </td>
            <td>@RazorHelper.FormatNegative(Model.TodayWinloss)
            </td>
        </tr>
        <tr>
            <td>@Las.YesterdayWinLoss (@Model.Yesterday.ToString("MM/dd/yyyy"))
            </td>
            <td>@RazorHelper.FormatNegative(Model.YesterdayWinloss)
            </td>
        </tr>
        <tr>
            <td>@Las.GivenCredit
            </td>
            <td>
                @{
                    if (SessionManager.CurrentSession.IsAdmin && Model.GivenCredit == 0)
                    {
                    <span>@Las.Unlimited</span>
                    }
                    else
                    {
                    <span>@RazorHelper.FormatNegative(Model.GivenCredit)</span>
                    }
                }
            </td>
        </tr>
        <tr>
            <td>@Las.UsedCredit
            </td>
            <td>@RazorHelper.FormatNegative(Model.UsedCredit)
            </td>
        </tr>
    </tbody>
</table>