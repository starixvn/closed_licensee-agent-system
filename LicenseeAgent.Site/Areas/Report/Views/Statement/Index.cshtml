@using LicenseeAgent.AccountInformation.ViewModels
@using LicenseeAgent.Web.Entities
@using LicenseeAgent.Report.ViewModels
@model StatementReportViewModel
@{
    ViewBag.Title = Las.DownlineStatement + " - " + Las.Report;
    var pageContext = (PageContext)ViewBag.PageContext;
}
@section css
{
    @Styles.Render("~/css/datetimepicker")
    @Styles.Render("~/css/fanexgrid")
}
@section scripts
{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/datetimepicker")
    @Scripts.Render("~/js/report/statement")
    <script type="text/javascript">
        $(function () {
            report.statement.init();
        });
    </script>
}
<div class="legend">
    @ViewBag.Title
</div>
@using (Html.BeginForm(null, null, FormMethod.Post,
    new { @class = "form-filter form-inline", id = "search-form" }))
{
    <div class="controls-row">
        @Html.LabelFor(m => m.FromDate)
        <div class="input-append date datepicker" id="fromDatePicker" data-date="@Model.FromDate">
            @Html.TextBoxFor(m => m.FromDate, new { @class = "input-add-on span2" })
            <span class="add-on"><i class="icon-th"></i></span>
        </div>
    </div>
    <div class="controls-row">
        @Html.LabelFor(m => m.ToDate, new { @class = "small-label" })
        <div class="input-append date datepicker" id="toDatePicker" data-date="@Model.ToDate">
            @Html.TextBoxFor(m => m.ToDate, new { @class = "input-add-on span2" })
            <span class="add-on"><i class="icon-th"></i></span>
        </div>
    </div>
    <div class="controls-row">
        @Html.LabelFor(m => m.UserName, new { @class = "small-label" })
        <div class="input-append">
            @Html.TextBoxFor(m => m.UserName, new { @class = "span2" })
        </div>
        <button class="btn btn-primary marginleft" id="search">@Las.Generate</button>
    </div>
    @Html.HiddenFor(m => m.AgentId)
    @Html.HiddenFor(m => m.AgentLevel)
}
<div id="grid" class="freegrid">
</div>