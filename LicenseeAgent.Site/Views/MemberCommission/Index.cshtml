@using System.Web.Mvc
@using LicenseeAgent.CustomerSetting.ViewModels;
@model MemberCommissionViewModel
@{
    ViewBag.Title = Las.CommissionMemberList;
}
@section css
{
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/membercommission")
}
@section scripts
{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/membercommission")
}
<div class="legend">
    @Las.CommissionMemberList
    <span id="membercomm-back" class="history-back"><i class="icon-history-back"></i>        
        <a href="@Url.Action("Index", "CommissionGroup")">@Las.Back</a>
    </span>
</div>
@using (Html.BeginForm("GetMemberCommissions", "MemberCommission", FormMethod.Post,
    new { @class = "form-inline form-filter ", id = "search-form" }))
{
    <div class="controls-row">
        @Html.Label("Username", Las.Username)
        @Html.TextBox("Username", string.Empty, new { @class = "w160", @placeholder = @Las.Username, @autocomplete = "off" })
    </div>
    <div class="controls-row">
        @Html.Label("GroupCommId", Las.Group)
        @RazorHelper.GroupCommision(Model.GroupCommissions, Model.GroupCommId, true, "selectpicker w160")
    </div>
    <div class="controls-row">
        <button class="btn btn-primary" type="submit">
            @Las.Submit
        </button>
    </div>
    @Html.Hidden("MemberIds")                           
}
<div class="controls-row">
    <button class="btn btn-primary left-button disabled" id="moveToGroup">@Las.MoveToGroup</button>
    <button class="btn btn-primary disabled" id="updateCommission">@Las.UpdateCommission</button>
    <button class="btn btn-primary disabled" id="removeFromGroup">@Las.RemoveFromGroup</button>
</div>

@Html.Partial("_MemberCommission")
<div id="grid" class="freegrid fix-header-border"></div>