@using LicenseeAgent.Core.Enumerations
@using LicenseeAgent.Core.Utils
@model AgentBreadcrumViewModel
@{
    var pageContext = (PageContext)ViewBag.PageContext;
    if (pageContext.IsLastLevel)
    {
        ViewBag.Title = Las.MemberList;
    }
    else
    {
        ViewBag.Title = Las.AgentList;
    }
}
@section css{
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/bootstrap-select")
    @Styles.Render("~/css/contextmenu")
    @Styles.Render("~/css/customerlist")
}
@section scripts{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/bootstrap-select")
    @Scripts.Render("~/js/contextmenu")
    @Scripts.Render("~/js/customerlist")
    @Html.Partial("_Script")
    @if (pageContext.IsLastLevel)
    {
        @Html.Partial("_MemberGrid")
    }
    else
    {
        @Html.Partial("_AgentGrid")
    }
}
<div class="legend">
    @ViewBag.Title
</div>
@using (Html.BeginForm("Index", "Customer", FormMethod.Post, new { id = "ajax-form", @class = "hide" }))
{
    @Html.HiddenFor(m => m.AgentId, new { id = "newAgentId" })
    @Html.HiddenFor(m => m.AgentName)
    @Html.HiddenFor(m => m.AgentLevel)
    @Html.HiddenFor(m => m.Breadcrumb)
}
@using (Html.BeginForm("GetCustomerList", "Customer", FormMethod.Post,
    new { @class = "form-inline form-filter ", id = "search-form" }))
{
    @Html.HiddenFor(m => m.AgentId)
    @Html.HiddenFor(m => m.AgentLevel)
    <div class="controls-row">
        @Html.Label("Username", Las.Username)
        @Html.TextBox("Username", string.Empty, new { @class = "w160", @placeholder = @Las.Username, urlAutoSearch = @Url.Action("CustomerSearchAutoComplete", "Customer"), @autocomplete = "false" })
    </div>
    <div class="controls-row">
        @Html.Label("Status", Las.Status)
        @Html.DropDownList("Status", ModelSettings.StatusList, new { @class = "selectpicker w100" })
    </div>
    <div class="controls-row">
        <button class="btn btn-primary" type="submit">
            @Las.Submit
        </button>
    </div>
}
@Html.Partial("_Breadcrumb")
@Html.Partial("_IpInformation")
<div class="wrapper">
    <div id="grid" class="freegrid">
    </div>
</div>
<ul id="contextMenu" class="dropdown-menu">
    <li id="menu-sportsbook"><a href="#"><i class="icon-account-logout"></i>@Las.Sportsbook</a></li>
    <li id="menu-accountinfo"><a href="#"><i class="icon-account-logout"></i>@Las.EditInfo</a></li>
    <li id="menu-adddownline"><a href="#"><i class="icon-account-logout"></i>@Las.AddDownline</a></li>
</ul>