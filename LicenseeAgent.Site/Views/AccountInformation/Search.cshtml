@using LicenseeAgent.Account.ViewResults
@model SearchUserResultViewModel
@{
    Layout = null;
    var pageContext = (PageContext)ViewBag.PageContext;
}
@if (pageContext != null)
{
    @Html.Partial("_AgentInfo", Model)

    <div class="controls-row">
        @if (pageContext.IsMember)
        {
            <button class="btn btn-inverse"  data-url="@Url.Action("BetListSelByMember", "BetList")">@Las.BetList</button>     
        }
        else
        {
            <button class="btn btn-inverse" data-url="@Url.Action("Index", "Customer", new { agentId = Model.Customer.CustId, agentLevel = Model.Customer.Level, agentName = Model.Customer.UserName, numberOfLevel = Model.Customer.NumberOfLevel })">@(pageContext.IsLastLevel ? @Las.MemberList : @Las.AgentList)</button>       
        }
        <button class="btn btn-inverse" data-url="@Url.Action("BetListSelByMember", "BetList")">@Las.Statement</button>
    </div>

    <div class="row-line">
    </div>
    
    if (Model.Customer.CustId != SessionManager.CurrentSession.AgentInfo.AgentId)
    {
        @Html.Partial("_BalanceDownline", Model)
        @Html.Partial("_SettingAction", Model)
    }
}
@if (ViewBag.Result != null)
{
    var result = (SearchUserViewResult)ViewBag.Result;
    if (result.IsChangeCurrency)
    {
    <script type="text/javascript">
        var alertMessage = '@string.Format(result.ErrMsg, result.CurrencyName)';
        accountInformation.showCurrencyAlert('@result.CurrencyId', '@result.CurrencyName', alertMessage, "@LangMsg.Msg_1032");
    </script>
    }
    else if (!string.IsNullOrEmpty(result.ErrMsg))
    {
    <script type="text/javascript">
        accountInformation.showNoUserAlert('@result.ErrMsg');
    </script>
    }

}