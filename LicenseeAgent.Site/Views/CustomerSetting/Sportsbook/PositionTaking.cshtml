@using LicenseeAgent.Core.Enumerations
@using LicenseeAgent.CustomerSetting.Entities.Sportsbook;
@{
    Layout = null;
}
<div id="positionTakingContainer" ng-controller="customerSetting.positionTakingController"
    class="pt-setting">
    <div class="pt-container-box" ng-show="!settingContext.IsSimpleMode">
        @if (Model.TargetRoleId == (int)Role.AgentLevel1)
        {
            @RazorHelper.RenderInstruction(Las.PositionTaking, "licensee-position-taking-info-button-adv")
        }
        else if (Model.TargetRoleId == (int)Role.Agent)
        {
            @RazorHelper.RenderInstruction(Las.PositionTaking, "agent-position-taking-info-button-adv")
        }
        else
        {
            @RazorHelper.RenderInstruction(Las.PositionTaking, "member-position-taking-info-button-adv")
        }
        <div ng-repeat="ptGroup in ptModel.ptGroups" ng-show="!settingContext.IsSimpleMode"
            class="pt-group-container" ng-style="ptGroup.WidthStyle">
            <div ng-class="{'pt-group-header expand': ptGroup.Expand, 'pt-group-header': true}">
                <span ng-click="positionTakingService.onCollapseExpand(ptGroup)" class="collapse-expand-button">
                    {{ptGroup.Name}}</span> <span class="icon-setting-copy" ng-if="$index == 0 || $index == 2"
                        ng-click="positionTakingService.copyAll($index, ptGroup, ptModel.ptGroups, language, this);"
                        title="{{$index==0 ? language.soccerDeadballCopyPtTooltip : language.basketBallCopyPtTooltip}}"
                        ng-show="settingContext.FormId != 2"></span>
            </div>
            <div class="pt-group-box">
                <div ng-repeat="pt in ptGroup.PositionTakings" class="pt-group" ng-show="ptGroup.Expand"
                    ng-switch="settingContext.TargetRoleId">
                    <licensee-edit-agent-one-pt-advanced-mode ng-switch-when="3"></licensee-edit-agent-one-pt-advanced-mode>
                    @if (Model.FormId != FormType.ViewIndirectAgent)
                    {
                        <agent-edit-agent-pt-advanced-mode ng-switch-when="2"></agent-edit-agent-pt-advanced-mode>
                    }
                    else
                    {
                        <agent-edit-agent-pt-advanced-mode-read-only ng-switch-when="2" ng-show="settingContext.FormId == 2"></agent-edit-agent-pt-advanced-mode-read-only>
                    }
                    <agent-edit-member-pt-advanced-mode ng-switch-when="1"></agent-edit-member-pt-advanced-mode>
                </div>
            </div>
        </div>
    </div>
    <div class="pt-container-box simple-mode" ng-switch="settingContext.TargetRoleId" ng-show="settingContext.IsSimpleMode">
        @if (Model.TargetRoleId == (int)Role.AgentLevel1)
        {
            @RazorHelper.RenderInstruction(Las.PositionTakingSimpleModeHeader, "licensee-position-taking-info-button")
        }
        else if (Model.TargetRoleId == (int)Role.Agent)
        {
            @RazorHelper.RenderInstruction(Las.PositionTakingSimpleModeHeader, "agent-position-taking-info-button")
        }
        else
        {
            @RazorHelper.RenderInstruction(Las.PositionTakingSimpleModeHeader, "member-position-taking-info-button")
        }
        <div class="pt-group-container" ng-style="ptGroup.WidthStyle">
            <div class="pt-group-box">
                <licensee-edit-agent-one-pt-simple-mode ng-switch-when="3" pt-simple="ptModel.ptFirstData"></licensee-edit-agent-one-pt-simple-mode>
                @if (Model.FormId != FormType.ViewIndirectAgent)
                {
                    <agent-edit-agent-pt-simple-mode ng-switch-when="2" pt-simple="ptModel.ptFirstData"></agent-edit-agent-pt-simple-mode>
                }
                else
                {
                    <agent-edit-agent-pt-simple-mode-read-only ng-switch-when="2" pt-simple="ptModel.ptFirstData"></agent-edit-agent-pt-simple-mode-read-only>
                }
                <agent-edit-member-pt-simple-mode ng-switch-when="1" pt-simple="ptModel.ptFirstData"></agent-edit-member-pt-simple-mode>
            </div>
        </div>
    </div>
</div>