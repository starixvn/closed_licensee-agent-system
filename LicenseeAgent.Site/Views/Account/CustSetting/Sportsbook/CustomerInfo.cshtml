@using LicenseeAgent.CustomerSetting.Entities
@using LicenseeAgent.Core.Enumerations
@{
    Layout = null;
}
<div id="custInfoController" class="container-box customerinfo-box" data-ng-controller="sportsbook.custInfoController"
    data-ng-form name="formCustInfo">
    <div class="instruction">
        @Las.GeneralInformation
    </div>
    <div class="row-block">
        <div class="block1">
            <span class="require"></span><span>@Las.Username</span>
        </div>
        <div class="block2">
            <div class="pull-left">
                <input id="userName" name="userName" type="text" maxlength="50" data-ng-model="custInfo.userName"
                    required data-ng-minlength="6" unique-user-name hint-validator="@Las.UsernameMinimumLength" data-href="~/SportsbookSetting/CheckExistUsername" />
            </div>
            <div class="pull-left">
                <span data-ng-class="{'icon-invalid': formCustInfo.userName.$dirty && formCustInfo.userName.$invalid, 'icon-valid' : formCustInfo.userName.$dirty && formCustInfo.userName.$valid}">
                    &nbsp;</span>
            </div>
        </div>
        <div class="block3">
            <span class="require"></span><span>@Las.Password</span>
        </div>
        <div class="block4">
            <div class="pull-left">
                <input id="password" autocomplete="off" type="password" name="password"
                    maxlength="16" style="position: relative;" data-ng-model="custInfo.password" password-rule hint-validator="@Las.PasswordHint" />
            </div>
            <div class="pull-left">
                <span data-ng-class="{'icon-invalid': formCustInfo.password.$dirty && formCustInfo.password.$invalid, 'icon-valid' : formCustInfo.password.$dirty && formCustInfo.password.$valid}">
                    &nbsp;</span>
            </div>
        </div>
    </div>
    <div class="row-block">
        <div class="block1">
            <span>@Las.FirstName</span>
        </div>
        <div class="block2">
            <input type="text" maxlength="50" data-ng-model="custInfo.firstName" />
        </div>
        <div class="block3">
            <span>@Las.LastName</span>
        </div>
        <div class="block4">
            <input type="text" maxlength="50" data-ng-model="custInfo.lastName" />
        </div>
    </div>
    <div class="row-block">
        <div class="block1">
            <span>@Las.Phone</span>
        </div>
        <div class="block2">
            <input id="phone" name="phone" type="text" maxlength="50" data-ng-model="custInfo.phone" />
        </div>
        <div class="block3">
            <span>@Las.MobilePhone</span>
        </div>
        <div class="block4">
            <input id="mobile" name="mobile" type="text" maxlength="50" data-ng-model="custInfo.mobile" />
        </div>
    </div>
    <div class="row-block">
        <div class="block1">
            <span class="require"></span><span>@Las.MaxCredit</span>
        </div>
        <div class="block2">
            <input id="credit" name="credit" type="text" maxlength="15" class="text-right" data-ng-model="custInfo.credit"
                hint-validator required required-hint="Max Credit is required" auto-numeric-format="0" />
            <span ng-show="isShowLimitMaxCredit"><= {{custInfo.maxCredit | number : 0}}</span>
        </div>
        <div class="block3">
            <span>@Las.Fax</span>
        </div>
        <div class="block4">
            <input id="fax" type="text" maxlength="50" data-ng-model="custInfo.fax" />
        </div>
    </div>
    <div class="row-block">
        <div class="block1">
            <span>@Las.Status</span>
        </div>
        <div class="block2">
            &nbsp;
            <label class="radio inline">
                <input type="radio" name="AccountStatus" data-ng-model="custInfo.status" value="@((int)AccountStatus.Open)" />
                @Las.Open
            </label>
            <label class="radio inline">
                <input type="radio" name="AccountStatus" data-ng-model="custInfo.status" value="@((int)AccountStatus.Closed)" />
                @Las.Closed
            </label>
        </div>
        <div class="block3 no-border">
        </div>
        <div class="block4">
        </div>
    </div>
</div>