<#@ template debug="true" hostSpecific="true" #>
<#@ output extension=".js" #>
<#@ assembly name="System.Xml" #>
<#@ assembly name="System.Xml.Linq" #>
<#@ Assembly Name="System.Data" #>
<#@ Import Namespace="System.Data" #>
<#@ Import Namespace="System.Data.SqlClient" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Security" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Xml.Linq" #>
<#@ import namespace="System.Windows.Forms" #>
<#@ include file="$(SolutionDir)\Packages\T4.TemplateFileManager.2.1.2\tools\ttinc\TemplateFilemanager.CS.ttinclude" #>
/*global language*/

language.SportType = {};

<#
    var connectionString = "Persist Security Info=False;User ID=affteam;Password=@warrior#;Initial Catalog=bodb02;Data Source=10.18.200.231";
    var conn = new SqlConnection(connectionString);
    var sql = "Select * from Sports";
    var command = new SqlCommand(sql, conn);
    conn.Open();
    var reader = command.ExecuteReader();
    var loop = reader.Read();
    var languages = new Dictionary<string, StringBuilder>();
    var languageCodes = new []{"en-US", "zh-CN", "zh-TW"};
    foreach(var code in languageCodes)
    {
        var stringBuilder = new StringBuilder("/*global language*/");
        stringBuilder.AppendFormat("\r\n\r\nlanguage.SportType['{0}'] = {{", code);
        languages.Add(code, stringBuilder);
    }
    while (loop)
    {
        var sportType = reader["SportType"].ToString();
        var sportName = reader["SportName"].ToString();
        var sportNameCh = reader["SportNameCh"].ToString();
        var sportNameCs = reader["SportNameCs"].ToString();
        loop = reader.Read();
        var isLast = true;
        if(loop)
        {
            isLast = false;
        }
        languages["en-US"].Append(CreateJsonPropertise(sportType, sportName, isLast));
        languages["zh-CN"].Append(CreateJsonPropertise(sportType, sportNameCh, isLast));
        languages["zh-TW"].Append(CreateJsonPropertise(sportType, sportNameCs, isLast));
    }
    reader.Close();
    conn.Close();

    var manager = TemplateFileManager.Create(this);
    foreach(var key in languages.Keys)
    {
        languages[key].Append("\r\n};");
        var fileName = string.Format("SportType.{0}.js", key);
        manager.StartNewFile(fileName);
#>
<#=languages[key].ToString()#>
<#
    }
    manager.Process();
#>
<#+
string CreateJsonPropertise(string name, string value, bool isLast)
{
    var pattern = "\r\n\t'{0}' : '{1}'{2}";
    var separate = isLast ?  string.Empty : ",";

    return string.Format(pattern, name, SecurityElement.Escape(value.Trim().Replace("\n", " ")), separate);
}
#>