@using LicenseeAgent.Web.Entities
@model PendingMemberViewModel
@{
    var pageContext = (PageContext)ViewBag.PageContext;
    ViewBag.Title = Las.PendingMemberList;
}
@section css
{
    @Styles.Render("~/css/fanexgrid")
}
@section scripts{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/customer-list/pending-member")
    <script type="text/javascript">
        $(function () {
            customerList.pendingMember.init();
        });
    </script>
}
<div class="legend">
    @ViewBag.Title
</div>

<div id="filter-tabs" class="filter-tabs">
    <ul id="tabs-area" class="nav nav-tabs">
        <li class="active"><a href="#direct-agent" data-toggle="tab">@Las.DirectAgent</a>
        </li>
        <li><a href="#indirect-agent" data-toggle="tab">@Las.IndirectAgent</a> </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="direct-agent">aa
        </div>
        <div class="tab-pane" id="indirect-agent">bb
        </div>
    </div>
</div>

<div class="pull-left" style="min-width: 420px">
    @Html.ValidationSummary()
    @using (Html.BeginForm(null, null, FormMethod.Post,
    new { @class = "form-inline form-filter", id = "search-form" }))
    {
        <div class="controls-row">
            @Html.LabelFor(x => x.MemberUserName)
            @Html.TextBoxFor(x => x.MemberUserName, new { @class = "w160", @placeholder = @Las.Username, @autocomplete = "off" })
        </div>
        if (!Model.IsDirectAgent)
        {
        <div class="controls-row">
            @Html.LabelFor(x => x.DirectAgentUserName)
            @Html.TextBoxFor(x => x.DirectAgentUserName, new { @class = "w160", @placeholder = @Las.Username, @autocomplete = "off" })
        </div>
        }
        <div class="controls-row">
            <button class="btn btn-primary" type="submit">
                @Las.Submit
            </button>
        </div>
    }
</div>

<div id="grid" class="freegrid">
</div>