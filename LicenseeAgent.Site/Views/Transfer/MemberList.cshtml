<script type="text/javascript">
    var footerRows = [
              {
                  Columns: [
                    { Value: "Total", Name: "Select", MergeColNumber: 5 },
                    { Value: "YesterdayBalance", Name: "YesterdayBalance", MergeColNumber: 2, IsCalculated: true },
                    { Value: "TotalBalance", Name: "TotalBalance", IsCalculated: true },
                    { Value: "", Name: "Outstanding", MergeColNumber: 2 }
                ]
              }
        ];
              var gridOptions = {
                  columns: [
                        {
                            HeaderText: '<i class="icon-uncheck-all" onclick="TRANSFER_LIST.toggleAll(this);"></i><i id="select-dropdown" class="icon-arrow"></i>',
                            Width: 30, Name: "Select", CellAlign: "center",
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return '<span class="cell-select icon icon-uncheck" onclick="TRANSFER_LIST.toggleCheck(this);"></span>';
                            }
                        },
                        {
                            HeaderText: "#", Width: 30, Name: "AgentId", CellAlign: "center"
                        },
                        {
                            HeaderText: "@Las.Username", Width: 100, Name: "UserName", HeaderAlign: "center", AllowTruncate: true
                        },
                        {
                            HeaderText: "@Las.FullName", Width: 125, Name: "CustomerName", HeaderAlign: "center", AllowTruncate: true,
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return CORE.formatCustomerName(rowData.FirstName, rowData.LastName);
                            }
                        },
                        {
                            HeaderText: "@Las.Status", Width: 55, Name: "Status", HeaderAlign: "center", CellAlign: "center",
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return cell.Value == 1
                                ? '<div class="account-status-open">' + LANGUAGE.getString('Open') + '</div>'
                                : '<div class="account-status-closed">' + LANGUAGE.getString('Closed') + '</div>';
                            }
                        },
                        {
                            HeaderText: "@Las.YesterdayBalance", Width: 80, Name: "YesterdayBalance", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', MergeHeaderColNumber: 2, CanResize: true,
                            CalResizeFunction: function (value) {
                                return value.toString().length * 9;
                            }
                        },
                        {
                            HeaderText: "", Width: 20, Name: "TransferIcon", CellAlign: "center",
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return '<i class="icon-transfer" onclick="TRANSFER_LIST.transferMember({0}, {1})" title="{2}"></i>'.format(rowData.CustId, -rowData.YesterdayBalance, '@Las.Transfer');
                            }
                        },
                        {
                            HeaderText: "@Las.TotalBalance", Width: 80, Name: "TotalBalance", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', CanResize: true,
                            CalResizeFunction: function (value) {
                                return value.toString().length * 9;
                            }
                        },
                        {
                            HeaderText: "@Las.Outstanding", Width: 80, Name: "Outstanding", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '$', CanResize: true,
                            CalResizeFunction: function (value) {
                                return value.toString().length * 9;
                            }
                        },
                        {
                            HeaderText: "@Las.GivenCredit", Width: 80, Name: "GivenCredit", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", CanResize: true,
                            CalResizeFunction: function (value) {
                                return value.toString().length * 9;
                            }
                        }
                   ],
                  showPager: true,
                  gridExpandHeight: 120,
                  indexNumberColumn: 1,
                  bodyRowHeight: 29,
                  showFooter: true,
                  footerRows: footerRows,
                  autoResizeColumn: true
              };
</script>