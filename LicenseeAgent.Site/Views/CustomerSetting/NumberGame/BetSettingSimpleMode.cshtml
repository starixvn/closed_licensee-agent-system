@using LicenseeAgent.Core.Enumerations
@using LicenseeAgent.CustomerSetting.Entities;
@model SettingContext
@{
    Layout = null;
}
@helper RenderInstruction(string text, string id, bool simpleMode)
    {
        if (simpleMode)
        {
    <div class="instruction" data-ng-show="settingMode">
        @text
        <span class="icon-instruction-exclamation" title="@Las.ClickToViewInstructions" id="@id"></span>
    </div>
        }
        else
        {
    <div class="instruction" data-ng-hide="settingMode">
        @text
        <span class="icon-instruction-exclamation" title="@Las.ClickToViewInstructions" id="@id"></span>
    </div>
        }
}
<div data-ng-class="{'container-box': true, 'simple-mode': settingMode}">
    @if (Model.TargetRoleId == (int)Role.AgentLevel1)
    {
        @RenderInstruction(Las.BetSetting, "licensee-bet-limit-info-button-ng", true)
    }
    else if (Model.TargetRoleId == (int)Role.Agent)
    {
        @RenderInstruction(Las.BetSetting, "agent-bet-limit-info-button-ng", true)
    }
    else
    {
        @RenderInstruction(Las.BetSetting, "member-bet-limit-info-button-ng", true)
    }
    <div id="betting-limit-current-scope-ng" class="betting-limit" data-ng-controller="NumberGameBetLimitController">
        <div data-ng-show="settingContext.IsSimpleMode" class="simple-mode">
            <div>
                <div class="betting-limit-header-col4 min-bet">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MinBet']}}</span></div>
                </div>
                <div class="betting-limit-header-col4">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MaxBet']}}</span></div>
                </div>
                <div class="betting-limit-header-col4">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MaxPerMatch']}}</span></div>
                </div>
                <div class="betting-limit-header-col4">
                    <div class="betting-limit-header-text">
                        <span>{{language['bettingLimit_MaxPerBall']}}</span></div>
                </div>
            </div>
            @if (Model.FormId != FormType.ViewIndirectAgent)
            {
                <number-game-betting-limit-simple-mode model-data="model.firstRecord"></number-game-betting-limit-simple-mode>
            }
            else
            {
                <number-game-betting-limit-simple-mode-read-only model-data="model.firstRecord"></number-game-betting-limit-simple-mode-read-only>
            }
        </div>
    </div>
</div>