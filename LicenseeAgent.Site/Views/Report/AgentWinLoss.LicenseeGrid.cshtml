@model LicenseeAgent.Report.ViewModels.AgentWinLossReportViewModel
<script type="text/javascript">
    var gridOption = {
        customizeHeader: true,
        groupHeaderRows: [
            {
                Columns: [
                        { HeaderText: "@Las.Agent", Name: "Username", MergeRowNumber: 2 },
                        { HeaderText: "@Las.Member", Name: "BetCount", MergeColNumber: 3 },
                        { HeaderText: "@Las.Downline", Name: "DownlineStake", MergeColNumber: 2, ThClass: 'alter-column' },
                        { HeaderText: "@Model.Username", Name: "AWinLost", MergeColNumber: 3 }
                    ]
            }
        ],
        columns: [
                    { HeaderText: "@Las.Agent", Width: 100, Name: "Username", HeaderAlign: "center", CellAlign: "left", CanResize: true,
                        Formatter: function (rowIndex, rowData, cell, cellFormated) {
                            return ("<a href='javascript:AGENTWINLOSS.ViewDownline({0}, {1}, \"{2}\");'>" + cell.Value + "</a>").format(rowData.AgentId, rowData.AgentLevel, cell.Value);
                        }
                    },
                    { HeaderText: "@Las.BetCount", Width: 70, Name: "BetCount", HeaderAlign: "center", CellAlign: "right", AllowTruncate: true, CanResize: true },
                    { HeaderText: "@Las.Turnover", Width: 100, Name: "Turnover", HeaderAlign: "center", CellAlign: "right", CanResize: true, FormatNumber: "0,0.00" },
                    { HeaderText: "@Las.Total", Width: 100, Name: "MemberTotal", HeaderAlign: "center", CellAlign: "right", CanResize: true, FormatNumber: "0,0.00" },
                    { HeaderText: "@Las.EffectiveTurnover", Width: 100, Name: "DownlineStake", HeaderAlign: "center", CellAlign: "right", CanResize: true, FormatNumber: "0,0.00", ThClass: 'alter-column' },
                    { HeaderText: "@Las.Total", Width: 100, Name: "DownlineTotal", HeaderAlign: "center", CellAlign: "right", CanResize: true, FormatNumber: "0,0.00", ThClass: 'alter-column' },
                    { HeaderText: "@Las.WinLoss", Width: 100, Name: "AWinLost", HeaderAlign: "center", CellAlign: "right", CanResize: true, FormatNumber: "0,0.00", FormatNegative: '$' },
                    { HeaderText: "@Las.Commission", Width: 100, Name: "AComm", HeaderAlign: "center", CellAlign: "right", CanResize: true, FormatNumber: "0,0.00", FormatNegative: '$' },
                    { HeaderText: "@Las.Total", Width: 100, Name: "ATotal", HeaderAlign: "center", CellAlign: "right", CanResize: true, FormatNumber: "0,0.00", FormatNegative: '$' }

                ],
        gridExpandHeight: 200,
        showNumberColumn: false,
        showFooter: true,
        //bodyRowHeight: 26,
        autoResizeColumn: true
    };
</script>