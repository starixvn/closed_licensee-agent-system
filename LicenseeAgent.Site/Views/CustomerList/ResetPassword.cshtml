@using LicenseeAgent.CustomerList.ViewModels
@model ResetPasswordViewModel
@{
    ViewBag.Title = Las.ResetPassword;
}
@section scripts{
    @Scripts.Render("~/js/resetpassword")
    @if (ViewBag.Result != null)
    {
        <script type="text/javascript">
            $(function () {
                POPUP.close();
            });
        </script>
    }
}
@RazorHelper.Legend(ViewBag.Title)
<div class="pull-left" style="width: 400px;">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-table" }))
    {
        @Html.ValidationSummary()
        <fieldset>
            @if (ViewBag.Result != null)
            {
                <p class="text-success">
                    @ViewBag.Result.ToString()
                </p>
            }
            @Html.AntiForgeryToken()
            <table class="table">
                <colgroup>
                    <col width="130" />
                    <col />
                </colgroup>
                <tbody>
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.Password)
                        </td>
                        <td>
                            @Html.PasswordFor(m => m.Password, new { maxlength = 24 }) <span id="iconValid">&nbsp;</span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @Html.LabelFor(m => m.ConfirmPassword)
                        </td>
                        <td>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { maxlength = 24 })
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="button-group row-fluid">
                <button type="reset" class="btn btn-primary pull-right">
                    @Las.Reset
                </button>
                <button type="submit" class="btn btn-primary pull-right">
                    @Las.Submit
                </button>
            </div>
            <div class="form-note">
                <span class="note-text">@Las.Note:</span>
                @Html.Raw(Las.PasswordHint)
            </div>
        </fieldset>
        @Html.HiddenFor(m => m.CustId)
        @Html.HiddenFor(m => m.IsLastLevel)
    }
</div>