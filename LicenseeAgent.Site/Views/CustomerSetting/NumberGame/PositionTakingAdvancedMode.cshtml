<div data-ng-controller="NumberGamePositionTakingAdvancedModeController" data-ng-if="hasOfferedNumberGame">
    <div data-ng-repeat="ptGroup in ptModel.ptGroups"
         class="pt-group-container" data-ng-style="ptGroup.WidthStyle">
        <div data-ng-class="{'pt-group-header expand': ptGroup.Expand, 'pt-group-header': true}">
            <span data-ng-click="positionTakingService.onCollapseExpand(ptGroup)" class="collapse-expand-button">
                {{ptGroup.Name}}</span>
        </div>
        <div class="pt-group-box">
            <div data-ng-repeat="pt in ptGroup.PositionTakings" class="pt-group" data-ng-show="ptGroup.Expand" data-ng-switch="settingContext.TargetRoleId">
                <number-game-licensee-edit-agent-one-pt-advanced-mode data-ng-switch-when="3"></number-game-licensee-edit-agent-one-pt-advanced-mode>
                @if (Model.FormId != FormType.ViewIndirectAgent)
                {
                    <number-game-agent-edit-agent-pt-advanced-mode data-ng-switch-when="2"></number-game-agent-edit-agent-pt-advanced-mode>
                }
                else
                {
                    <number-game-agent-edit-agent-pt-advanced-mode-read-only data-ng-switch-when="2" data-ng-show="settingContext.FormId == 2"></number-game-agent-edit-agent-pt-advanced-mode-read-only>
                }
                <number-game-agent-edit-member-pt-advanced-mode data-ng-switch-when="1"></number-game-agent-edit-member-pt-advanced-mode>
            </div>
        </div>
    </div>
</div>