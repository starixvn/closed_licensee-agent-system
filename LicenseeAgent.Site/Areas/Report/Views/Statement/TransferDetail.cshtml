@using LicenseeAgent.AccountInformation.ViewModels
@using LicenseeAgent.Web.Entities
@using LicenseeAgent.Report.ViewModels
@model TransferDetailViewModel
@{
    ViewBag.Title = Las.TransferDetails + " - " + Model.Username;
}
@section css
{
    @Styles.Render("~/css/fanexgrid")
    @Styles.Render("~/css/bootstrap")
}
@section scripts
{
    @Scripts.Render("~/js/fanexgrid")
    @Scripts.Render("~/js/moment")
    @Scripts.Render("~/js/report/statement")
    <script type="text/javascript">
        $(function () {
            report.statement.transferDetail.init();
        });
    </script>
}
<div class="legend">
    @ViewBag.Title
</div>
@using (Html.BeginForm(null, null, FormMethod.Post,
    new { @class = "hide", id = "search-form" }))
{
    @Html.HiddenFor(m => m.CustId)
    @Html.HiddenFor(m => m.FromDate)
    @Html.HiddenFor(m => m.ToDate)
    @Html.HiddenFor(m => m.IsMember)
}
<div id="grid" class="freegrid">
</div>