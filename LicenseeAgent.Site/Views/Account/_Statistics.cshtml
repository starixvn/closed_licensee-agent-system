@using LicenseeAgent.Core.Utility
@using LicenseeAgent.Account.Entities
@model StatisticEntity
<div class="legend">@Las.YourStatistics</div>
<table>
    <tbody>
        <tr>
            <td>@Las.AgentOutstanding
            </td>
            <td>@Formatter.FormatDecimal(Model.OutStanding)
            </td>
        </tr>
        <tr>
            <td>@Las.TotalOutstanding
            </td>
            <td>@Formatter.FormatDecimal(Model.TotalOutStanding)
            </td>
        </tr>
        <tr>
            <td colspan="2">@Las.TopWinningMembers
                <i class="dropdown-button icon-account-expand" href="@Url.Action("TopWinning", "Account")">
                </i>
                <div class="dropdown-popup">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2">@Las.TopTurnoverMembers
                <i class="dropdown-button icon-account-expand" href="@Url.Action("TopTurnover", "Account")">
                </i>
                <div class="dropdown-popup">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                @Las.NewMemberOfMonth: <span class="text-bold">@Formatter.FormatInt(Model.NumberNewMembers)</span>
                <i class="dropdown-button icon-account-expand" href="@Url.Action("NewMembers", "Account")">
                </i>
                <div class="dropdown-popup popup-statistics-newmembers">
                </div>
            </td>
        </tr>
    </tbody>
</table>